---
/* Videomappe — /videos/<name>

   Persönliche Seite für einen möglichen Kunden: ein paar Hochkant-Videos
   zum Durchklicken. Texte und Videos je Mappe in src/data/video-mappen.ts.
   noindex, nicht in der Sitemap, nirgends verlinkt (wie /alle-projekte).

   Aufbau: dunkles Band mit Überschrift und den Videos als Hochkant-Karten,
   darunter Iwo als Ansprechpartner, dann der Footer (Impressum).

   Verhalten
   - Karte: Standbild, Play-Kreis, Marke. Auf dem Desktop läuft beim
     Darüberfahren eine stumme Vorschau; auf dem Handy nicht.
   - Klick öffnet einen <dialog> mit dem Video in groß, mit Ton und
     Steuerleiste. Pfeiltasten oder Knöpfe blättern weiter, Esc schließt.
   - Laden: preload="none" überall. Ein Video lädt erst beim Abspielen. */
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import portraitIwo from '../../assets/portraits/iwo-sawicki.jpg';
import { videoMappen } from '../../data/video-mappen';
import { kontakt } from '../../data/navigation';

export function getStaticPaths() {
  return videoMappen.map((mappe) => ({ params: { slug: mappe.slug }, props: { mappe } }));
}

const { mappe } = Astro.props;

/* Videos und Standbilder nach Dateinamen auffinden, egal in welchem
   Unterordner von src/assets sie liegen */
const nachName = <T,>(dateien: Record<string, T>) =>
  Object.fromEntries(Object.entries(dateien).map(([pfad, wert]) => [pfad.split('/').pop()!, wert]));
const quellen = nachName(
  import.meta.glob<{ default: string }>('../../assets/**/*.mp4', { eager: true }),
);
const standbilder = nachName(
  import.meta.glob<{ default: ImageMetadata }>('../../assets/**/*-standbild.jpg', { eager: true }),
);

const videos = await Promise.all(
  mappe.videos.map(async (video) => {
    const name = video.datei.replace(/\.mp4$/, '');
    const quelle = quellen[video.datei];
    const standbild = standbilder[`${name}-standbild.jpg`];
    if (!quelle || !standbild) throw new Error(`Videomappe ${mappe.slug}: ${video.datei} oder Standbild fehlt`);
    const poster = await getImage({ src: standbild.default, width: 480, format: 'webp' });
    return { ...video, src: quelle.default, poster: poster.src };
  }),
);

const blaettern =
  'flex h-44 w-44 cursor-pointer items-center justify-center rounded-full border border-lime-edge bg-transparent text-18 text-paper transition-colors hover:border-lime hover:bg-forest-card';
---

<BaseLayout
  title={`Videos für ${mappe.fuer} | Stolz Marketing`}
  description="Eine persönliche Auswahl unserer Videos."
  noindex
>
  <main class="bg-forest">
    <section
      class="relative overflow-hidden"
      style="background-image: radial-gradient(ellipse 70% 50% at 50% 0%, rgb(228 245 63 / 0.10), transparent 70%)"
    >
      <Header variante="dunkel" />

      <div class="mx-auto flex max-w-content-wide flex-col items-center px-page-x pt-[clamp(40px,6vw,72px)] pb-section-y-md text-center">
        <Eyebrow variante="lime">{mappe.eyebrow}</Eyebrow>
        <h1 class="m-0 mt-20 max-w-860 text-h1-sub leading-hero font-bold tracking-system text-paper">
          {mappe.titelVorn}<span class="font-display font-semibold tracking-none text-lime italic">{mappe.titelKursiv}</span>{mappe.titelHinten}
        </h1>
        <p class="m-0 mt-22 max-w-600 text-18 leading-body text-mint-light">{mappe.lead}</p>

        {/* --- Videokarten --- */}
        <ul class="m-0 mt-[clamp(40px,5vw,64px)] flex w-full list-none flex-wrap items-start justify-center gap-16 p-0 btn:gap-24">
          {
            videos.map((video, i) => (
              <li class="max-w-220 shrink-0 grow-0 basis-[calc(50%-8px)] btn:basis-170 nav:basis-[calc((100%-96px)/5)] nav:even:mt-48">
                <button
                  type="button"
                  class="group flex w-full cursor-pointer flex-col gap-14 border-0 bg-transparent p-0 text-left"
                  data-mappe-oeffnen={i}
                  aria-label={`Video ${video.kunde} ansehen`}
                >
                  <span class="relative block aspect-[9/16] w-full overflow-hidden rounded-20 bg-forest-black ring-1 ring-edge transition-[box-shadow,translate] duration-300 group-hover:-translate-y-4 group-hover:shadow-ring-lime">
                    <video
                      class="absolute inset-0 h-full w-full object-cover"
                      src={video.src}
                      poster={video.poster}
                      muted
                      loop
                      playsinline
                      preload="none"
                      aria-hidden="true"
                      tabindex="-1"
                      data-vorschau
                    ></video>
                    {/* Verlauf unten, damit die Marke lesbar bleibt */}
                    <span class="absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-forest-black/80 to-transparent" aria-hidden="true"></span>
                    <span class="absolute top-12 left-12 rounded-full bg-forest-black/70 px-10 py-5 text-12 font-medium text-paper backdrop-blur-sm">
                      {video.art}
                    </span>
                    <span
                      class="absolute top-1/2 left-1/2 flex h-56 w-56 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-lime text-forest-deep shadow-glow-play transition-[scale,opacity] duration-300 group-hover:scale-110"
                      aria-hidden="true"
                    >
                      <svg class="ml-3 h-20 w-20" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l13-7.5z" /></svg>
                    </span>
                  </span>
                  <span class="flex flex-col gap-4">
                    <span class="text-16 leading-card font-bold text-paper">{video.kunde}</span>
                    <span class="text-14 leading-tight-body text-mint">{video.text}</span>
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* --- Ansprechpartner --- */}
    <section class="bg-paper px-page-x py-section-y-sm">
      <div class="mx-auto flex max-w-760 flex-wrap items-center justify-center gap-x-32 gap-y-20 text-center btn:flex-nowrap btn:text-left">
        <Image
          src={portraitIwo}
          alt="Iwo Sawicki"
          width={240}
          class="h-112 w-112 shrink-0 rounded-full object-cover object-top ring-1 ring-line"
        />
        <div class="flex flex-col items-center gap-12 btn:items-start">
          <p class="m-0 text-22 leading-card font-bold tracking-heading text-ink">
            Fragen zu den Videos? Rufen Sie mich einfach an.
          </p>
          <p class="m-0 text-15 text-ink-muted">Iwo Sawicki, Inhaber Stolz Marketing</p>
          <div class="mt-4 flex flex-wrap justify-center gap-10 btn:justify-start">
            <a
              href={kontakt.telefonLink}
              class="inline-flex h-48 items-center rounded-full bg-lime px-22 text-15 font-bold text-forest-deep no-underline transition-colors hover:bg-lime-bright"
            >
              {kontakt.telefonAnzeige}
            </a>
            <a
              href={`mailto:${kontakt.email}`}
              class="inline-flex h-48 items-center rounded-full px-22 text-15 font-bold text-ink no-underline ring-1 ring-line-strong transition-colors hover:bg-paper-hover"
            >
              {kontakt.email}
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  {/* --- Großansicht --- */}
  <dialog
    class="mappe-dialog fixed inset-0 m-0 h-full max-h-none w-full max-w-none overflow-y-auto border-0 bg-transparent p-0 text-paper"
    aria-label="Video"
    data-mappe-dialog
  >
    <div class="flex min-h-full w-full flex-col items-center justify-center gap-16 px-16 pt-72 pb-24 btn:flex-row btn:gap-32 btn:px-page-x btn:py-64" data-mappe-flaeche>
      <video
        class="aspect-[9/16] h-[min(56dvh,960px)] w-auto max-w-full shrink-0 rounded-20 btn:h-[min(84dvh,960px)] bg-forest-black object-contain shadow-badge"
        controls
        playsinline
        preload="none"
        data-mappe-player
      ></video>

      <div class="flex w-full max-w-[min(280px,100%)] flex-col gap-10 text-center btn:text-left">
        <span class="self-center rounded-full bg-forest-card px-10 py-5 text-12 font-medium text-mint-light btn:self-start" data-mappe-art></span>
        <p class="m-0 text-19 leading-card font-bold text-paper btn:text-22" data-mappe-kunde></p>
        <p class="m-0 text-15 leading-body text-mint" data-mappe-text></p>
        <div class="mt-8 flex items-center justify-center gap-14 btn:justify-start">
          <button type="button" class={blaettern} data-mappe-schritt="-1" aria-label="Vorheriges Video">←</button>
          <span class="font-mono text-12 tracking-eyebrow text-mint-dimmer" data-mappe-zaehler></span>
          <button type="button" class={blaettern} data-mappe-schritt="1" aria-label="Nächstes Video">→</button>
        </div>
      </div>
    </div>

    <button
      type="button"
      class="absolute top-16 right-16 flex h-44 w-44 cursor-pointer items-center justify-center rounded-full border-0 bg-forest-card text-22 text-paper transition-colors hover:bg-forest-panel"
      aria-label="Schließen"
      data-mappe-schliessen
    >
      ×
    </button>
  </dialog>

  <script is:inline type="application/json" data-mappe-daten set:html={JSON.stringify(videos)} />

  <Footer />
</BaseLayout>

<style is:global>
  .mappe-dialog::backdrop {
    background: color-mix(in srgb, var(--color-forest-black) 92%, transparent);
    backdrop-filter: blur(6px);
  }
  /* Seite dahinter steht still, solange das Video offen ist */
  html:has(.mappe-dialog[open]) {
    overflow: hidden;
  }
</style>

<script>
  interface Video {
    src: string;
    poster: string;
    kunde: string;
    art: string;
    text: string;
  }

  const daten = document.querySelector<HTMLScriptElement>('[data-mappe-daten]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-mappe-dialog]');
  const player = document.querySelector<HTMLVideoElement>('[data-mappe-player]');

  if (daten && dialog && player) {
    const videos: Video[] = JSON.parse(daten.textContent ?? '[]');
    const feld = (name: string) => dialog.querySelector<HTMLElement>(`[data-mappe-${name}]`)!;
    let aktuell = 0;

    const zeigen = (i: number) => {
      aktuell = (i + videos.length) % videos.length;
      const v = videos[aktuell]!;
      player.poster = v.poster;
      player.src = v.src;
      feld('zaehler').textContent = `${aktuell + 1} / ${videos.length}`;
      feld('art').textContent = v.art;
      feld('kunde').textContent = v.kunde;
      feld('text').textContent = v.text;
      dialog.setAttribute('aria-label', `Video ${v.kunde}`);
      player.play().catch(() => {});
    };

    /* Karten öffnen die Großansicht */
    document.querySelectorAll<HTMLButtonElement>('[data-mappe-oeffnen]').forEach((knopf) => {
      knopf.addEventListener('click', () => {
        dialog.showModal();
        zeigen(Number(knopf.dataset.mappeOeffnen));
      });
    });

    dialog.querySelectorAll<HTMLButtonElement>('[data-mappe-schritt]').forEach((knopf) => {
      knopf.addEventListener('click', () => zeigen(aktuell + Number(knopf.dataset.mappeSchritt)));
    });
    feld('schliessen').addEventListener('click', () => dialog.close());

    /* Klick neben das Video schließt ebenfalls */
    feld('flaeche').addEventListener('click', (e) => {
      if (e.target === e.currentTarget) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') zeigen(aktuell + 1);
      if (e.key === 'ArrowLeft') zeigen(aktuell - 1);
    });

    /* Beim Schließen anhalten und die Quelle lösen, sonst lädt es weiter */
    dialog.addEventListener('close', () => {
      player.pause();
      player.removeAttribute('src');
      player.load();
    });

    /* Stumme Vorschau beim Darüberfahren, nur mit Maus */
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      document.querySelectorAll<HTMLButtonElement>('[data-mappe-oeffnen]').forEach((knopf) => {
        const vorschau = knopf.querySelector<HTMLVideoElement>('[data-vorschau]');
        if (!vorschau) return;
        knopf.addEventListener('mouseenter', () => {
          vorschau.play().catch(() => {});
        });
        knopf.addEventListener('mouseleave', () => {
          vorschau.pause();
          vorschau.currentTime = 0;
        });
      });
    }
  }
</script>
