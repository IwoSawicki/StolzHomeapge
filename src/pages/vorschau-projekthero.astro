---
// INTERNE VORSCHAU — 3 Hero-Vorschläge für Website-Projektseiten (HEPA)
// und 3 für Video-Projektseiten (DMK). Nicht verlinkt, noindex, nicht in
// der Sitemap. Nach der Entscheidung wird die gewählte Variante in
// /projekte/[slug].astro übernommen und diese Seite gelöscht.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BrowserMockup from '../components/BrowserMockup.astro';
import { projekte } from '../data/projekte';

const hepa = projekte.find((p) => p.slug === 'hepa-baut')!;
const dmk = projekte.find((p) => p.slug === 'dmk-bau')!;
const hepaFacts = hepa.details!.keyfacts.filter((f) => !f.wert.includes('XX'));
const dmkFacts = dmk.details!.keyfacts.filter((f) => !f.wert.includes('XX'));
const dmkVideos = dmk.details!.videos ?? [];
---

<BaseLayout title="Vorschau: Projekt-Heros | intern" noindex>
  <Header />
  <main>
    <div class="px-5 pt-14 text-center md:px-10 md:pt-20">
      <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Interne Vorschau</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-[-0.03em] text-dark">Projekt-Hero: 3 + 3 Vorschläge</h1>
      <p class="mt-3 text-base font-medium text-dark/60">Oben Website (HEPA), unten Video (DMK). Sag einfach W1/W2/W3 und V1/V2/V3.</p>
    </div>

    <!-- ============ W1 · SHAPE EXAKT ============ -->
    <p class="mt-20 px-5 text-center text-xs font-medium tracking-wide text-gray uppercase">W1 · Shape exakt (Headline schneidet ins Bild, Text-Duo darunter)</p>
    <section class="px-5 pt-8 md:px-10">
      <div class="mx-auto max-w-[1200px]">
        <!-- Kopf: Pills links, Eyebrow + Headline rechts -->
        <div class="grid gap-6 xl:grid-cols-[260px_1fr] xl:gap-10">
          <div class="flex flex-wrap content-start gap-1.5">
            {hepa.kategorien.map((k) => <span class="h-fit rounded-full bg-bg-soft px-3.5 py-1.5 text-xs font-semibold text-dark">{k}</span>)}
          </div>
          <div>
            <p class="flex items-center gap-2.5 text-sm font-medium text-gray">
              <span class="size-1.5 rounded-full bg-blue" aria-hidden="true"></span>
              HEPA Baut · {hepa.ziel}
            </p>
          </div>
        </div>

        <!-- Headline-Panel überlappt ins Bild (Negativ-Rundungen) -->
        <div class="relative mt-4">
          <div class="w1-panel relative z-10 bg-white xl:inline-block xl:max-w-[860px] xl:rounded-br-[28px] xl:pr-10 xl:pb-6">
            <h2 class="text-4xl font-semibold text-balance leading-[1.03] tracking-[-0.035em] text-dark md:text-[56px] md:leading-[1.0]">
              {hepa.beschreibung}
            </h2>
          </div>
          <div class="mt-6 aspect-[16/10] overflow-hidden rounded-24 md:aspect-[16/9] xl:-mt-14">
            <BrowserMockup domain={hepa.domain} bild={hepa.bild} alt="Website von HEPA Baut" />
          </div>
        </div>

        <!-- Shape-Text-Duo: kurz & groß links, länger rechts + Keyfacts -->
        <div class="mt-12 grid gap-8 md:mt-16 md:grid-cols-2 md:gap-16">
          <h3 class="text-2xl font-semibold text-balance leading-[1.2] tracking-[-0.02em] text-dark md:text-[34px]">
            Kompletter Website-Relaunch mit über 450 lokalen Landingpages für HEPA Baut.
          </h3>
          <div>
            <p class="text-base font-medium leading-[1.6] text-dark/70">{hepa.details!.einleitung}</p>
            <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 md:grid-cols-4">
              {hepaFacts.map((f) => (
                <div>
                  <dt class="text-xs font-semibold tracking-[0.1em] text-gray uppercase">{f.label}</dt>
                  <dd class="mt-1 text-base font-semibold text-dark">{f.wert}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ W2 · WIE BISHER (VERFEINERT) ============ -->
    <p class="mt-24 border-t border-border px-5 pt-16 text-center text-xs font-medium tracking-wide text-gray uppercase">W2 · Wie bisher, verfeinert (Keyfacts als Karten-Zeile)</p>
    <section class="px-5 pt-8 md:px-10">
      <div class="mx-auto max-w-[1200px]">
        <div class="flex flex-wrap gap-1.5">
          {hepa.kategorien.map((k) => <span class="rounded-full bg-bg-soft px-3.5 py-1.5 text-xs font-semibold text-dark">{k}</span>)}
        </div>
        <h2 class="mt-4 max-w-[720px] text-4xl font-semibold text-balance leading-[1.05] tracking-[-0.03em] text-dark md:text-5xl">
          {hepa.name}
        </h2>
        <p class="mt-5 max-w-[640px] text-lg font-medium leading-[1.5] tracking-[-0.01em] text-dark">
          {hepa.details!.einleitung}
        </p>
        <dl class="mt-10 grid grid-cols-2 gap-3 md:grid-cols-4">
          {hepaFacts.map((f) => (
            <div class="rounded-20 border border-border bg-white px-5 py-4">
              <dt class="text-xs font-semibold tracking-[0.1em] text-gray uppercase">{f.label}</dt>
              <dd class="mt-1 text-base font-semibold text-dark">{f.wert}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-10 aspect-[16/10] overflow-hidden rounded-24 md:aspect-[16/9]">
          <BrowserMockup domain={hepa.domain} bild={hepa.bild} alt="Website von HEPA Baut" />
        </div>
      </div>
    </section>

    <!-- ============ W3 · SPLIT (Text links, Mockup rechts) ============ -->
    <p class="mt-24 border-t border-border px-5 pt-16 text-center text-xs font-medium tracking-wide text-gray uppercase">W3 · Split (Statement links, Mockup rechts, Keyfacts-Zeile darunter)</p>
    <section class="px-5 pt-8 md:px-10">
      <div class="mx-auto max-w-[1200px]">
        <div class="grid gap-10 xl:grid-cols-[1fr_560px] xl:items-center xl:gap-16">
          <div>
            <div class="flex flex-wrap gap-1.5">
              {hepa.kategorien.map((k) => <span class="rounded-full bg-bg-soft px-3.5 py-1.5 text-xs font-semibold text-dark">{k}</span>)}
            </div>
            <h2 class="mt-5 text-4xl font-semibold text-balance leading-[1.04] tracking-[-0.035em] text-dark md:text-[46px]">
              {hepa.beschreibung}
            </h2>
            <p class="mt-5 max-w-[520px] text-lg font-medium leading-[1.55] text-dark/70">
              {hepa.details!.einleitung}
            </p>
          </div>
          <div class="aspect-[4/3] overflow-hidden rounded-24">
            <BrowserMockup domain={hepa.domain} bild={hepa.bild} alt="Website von HEPA Baut" />
          </div>
        </div>
        <dl class="mt-10 grid grid-cols-2 divide-border overflow-hidden rounded-20 border border-border md:grid-cols-4 md:divide-x">
          {hepaFacts.map((f) => (
            <div class="bg-white px-5 py-4">
              <dt class="text-xs font-semibold tracking-[0.1em] text-gray uppercase">{f.label}</dt>
              <dd class="mt-1 text-base font-semibold text-dark">{f.wert}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ============ V1 · SHAPE-ADAPTION FÜR VIDEO ============ -->
    <p class="mt-28 border-t-4 border-bg-blue-light px-5 pt-16 text-center text-xs font-medium tracking-wide text-gray uppercase">V1 · Shape-Adaption (Headline schneidet in die Video-Reihe)</p>
    <section class="px-5 pt-8 md:px-10">
      <div class="mx-auto max-w-[1200px]">
        <div class="grid gap-6 xl:grid-cols-[260px_1fr] xl:gap-10">
          <div class="flex flex-wrap content-start gap-1.5">
            {dmk.kategorien.map((k) => <span class="h-fit rounded-full bg-bg-soft px-3.5 py-1.5 text-xs font-semibold text-dark">{k}</span>)}
          </div>
          <p class="flex items-center gap-2.5 text-sm font-medium text-gray">
            <span class="size-1.5 rounded-full bg-blue" aria-hidden="true"></span>
            DMK Bau · {dmk.ziel}
          </p>
        </div>

        <div class="relative mt-4">
          <div class="w1-panel relative z-10 bg-white xl:inline-block xl:max-w-[860px] xl:rounded-br-[28px] xl:pr-10 xl:pb-6">
            <h2 class="text-4xl font-semibold text-balance leading-[1.03] tracking-[-0.035em] text-dark md:text-[56px] md:leading-[1.0]">
              {dmk.beschreibung}
            </h2>
          </div>
          <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-3 xl:-mt-14">
            {dmkVideos.map((video, i) => (
              <div class:list={['aspect-[9/16] overflow-hidden rounded-24 bg-dark', i === 2 ? 'hidden md:block' : '']}>
                <video class="h-full w-full object-cover" src={video} autoplay muted loop playsinline preload="metadata" aria-label="Social-Media-Clip für DMK Bau (stumm)" />
              </div>
            ))}
          </div>
        </div>

        <div class="mt-12 grid gap-8 md:mt-16 md:grid-cols-2 md:gap-16">
          <h3 class="text-2xl font-semibold text-balance leading-[1.2] tracking-[-0.02em] text-dark md:text-[34px]">
            Eine Kampagnen-Strecke für Aufträge und Bewerbungen — direkt von der Baustelle.
          </h3>
          <div>
            <p class="text-base font-medium leading-[1.6] text-dark/70">{dmk.details!.einleitung}</p>
            <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 md:grid-cols-4">
              {dmkFacts.map((f) => (
                <div>
                  <dt class="text-xs font-semibold tracking-[0.1em] text-gray uppercase">{f.label}</dt>
                  <dd class="mt-1 text-base font-semibold text-dark">{f.wert}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ V2 · DUNKLE BÜHNE ============ -->
    <p class="mt-24 border-t border-border px-5 pt-16 text-center text-xs font-medium tracking-wide text-gray uppercase">V2 · Dunkle Bühne (Videos auf dunklem Panel, Keyfacts hell darunter)</p>
    <section class="px-5 pt-8 md:px-10">
      <div class="mx-auto max-w-[1200px]">
        <div class="rounded-[32px] bg-dark px-6 py-10 md:px-12 md:py-14">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <p class="flex items-center gap-2.5 text-sm font-medium text-white/70">
              <span class="size-1.5 rounded-full bg-lime" aria-hidden="true"></span>
              DMK Bau · {dmk.ziel}
            </p>
            <div class="flex flex-wrap gap-1.5">
              {dmk.kategorien.map((k) => <span class="rounded-full bg-white/10 px-3.5 py-1.5 text-xs font-semibold text-white">{k}</span>)}
            </div>
          </div>
          <h2 class="mt-5 max-w-[820px] text-3xl font-semibold text-balance leading-[1.06] tracking-[-0.03em] text-white md:text-5xl">
            {dmk.beschreibung}
          </h2>
          <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-3">
            {dmkVideos.map((video, i) => (
              <div class:list={['aspect-[9/16] overflow-hidden rounded-24 bg-video-dark-2', i === 2 ? 'hidden md:block' : '']}>
                <video class="h-full w-full object-cover" src={video} autoplay muted loop playsinline preload="metadata" aria-label="Social-Media-Clip für DMK Bau (stumm)" />
              </div>
            ))}
          </div>
        </div>
        <div class="mt-8 grid gap-8 md:grid-cols-[1fr_380px] md:gap-16">
          <p class="text-lg font-medium leading-[1.55] text-dark">{dmk.details!.einleitung}</p>
          <dl class="grid grid-cols-2 gap-x-6 gap-y-5 self-start">
            {dmkFacts.map((f) => (
              <div>
                <dt class="text-xs font-semibold tracking-[0.1em] text-gray uppercase">{f.label}</dt>
                <dd class="mt-1 text-base font-semibold text-dark">{f.wert}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- ============ V3 · FILMSTREIFEN ============ -->
    <p class="mt-24 border-t border-border px-5 pt-16 text-center text-xs font-medium tracking-wide text-gray uppercase">V3 · Filmstreifen (mittleres Video angehoben, Headline zentriert)</p>
    <section class="px-5 pt-8 pb-24 md:px-10">
      <div class="mx-auto max-w-[1200px]">
        <div class="mx-auto max-w-[760px] text-center">
          <div class="flex flex-wrap justify-center gap-1.5">
            {dmk.kategorien.map((k) => <span class="rounded-full bg-bg-soft px-3.5 py-1.5 text-xs font-semibold text-dark">{k}</span>)}
          </div>
          <h2 class="mt-5 text-4xl font-semibold text-balance leading-[1.05] tracking-[-0.035em] text-dark md:text-5xl">
            {dmk.beschreibung}
          </h2>
          <p class="mt-4 text-base font-medium leading-[1.55] text-dark/60">{dmk.details!.einleitung}</p>
        </div>
        <div class="mt-14 grid grid-cols-2 gap-4 md:grid-cols-3 md:px-10">
          {dmkVideos.map((video, i) => (
            <div
              class:list={[
                'aspect-[9/16] overflow-hidden rounded-24 bg-dark shadow-card',
                i === 1 ? 'md:-translate-y-6' : 'md:translate-y-2',
                i === 0 ? 'md:-rotate-1' : i === 2 ? 'hidden md:block md:rotate-1' : '',
              ]}
            >
              <video class="h-full w-full object-cover" src={video} autoplay muted loop playsinline preload="metadata" aria-label="Social-Media-Clip für DMK Bau (stumm)" />
            </div>
          ))}
        </div>
        <dl class="mx-auto mt-14 grid max-w-[900px] grid-cols-2 gap-3 md:grid-cols-4">
          {dmkFacts.map((f) => (
            <div class="rounded-20 border border-border bg-white px-5 py-4 text-center">
              <dt class="text-xs font-semibold tracking-[0.1em] text-gray uppercase">{f.label}</dt>
              <dd class="mt-1 text-base font-semibold text-dark">{f.wert}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* W1/V1: Headline-Panel schneidet ins Medium — Negativ-Rundungen an
     beiden Übergängen (rechts vom Panel auf der Medienoberkante, links
     unter dem Panel an der Medienkante). Nur Desktop (xl). */
  @media (min-width: 1200px) {
    .w1-panel::before,
    .w1-panel::after {
      content: '';
      position: absolute;
      width: 20px;
      height: 20px;
      background: radial-gradient(circle at 100% 100%, transparent 20px, var(--color-white) 20px);
    }
    /* rechts neben dem Panel, auf Höhe der Medienoberkante */
    .w1-panel::before {
      right: -20px;
      bottom: 36px;
    }
    /* direkt unter dem Panel, an der linken Kante */
    .w1-panel::after {
      left: 0;
      top: 100%;
    }
  }
</style>
