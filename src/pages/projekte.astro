---
// /projekte – Übersichtsseite im gewählten Shape-Design (wie die
// Startseiten-Sektion, gleiches ProjekteGrid mit allen 8 Projekten).
// Projekt-Unterseiten (/projekte/[slug]) folgen im nächsten Step.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjekteGrid from '../components/ProjekteGrid.astro';
import Button from '../components/Button.astro';
import { projekte } from '../data/projekte';

// alle Projekte in der Reihenfolge aus src/data/projekte.ts
const reihenfolge = projekte;
---

<BaseLayout
  title="Projekte | STOLZ Marketing"
  description="Websites, Kampagnen und Recruiting-Content für Handwerksbetriebe: eine Auswahl erfolgreicher Projekte von STOLZ Marketing."
>
  <Header />
  <main>
    <section class="px-5 pt-14 pb-12 md:px-10 md:pt-24 md:pb-25">
      <div class="mx-auto max-w-[1200px]">
        <div class="max-w-[640px]">
          <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Projekte</p>
          <h1 class="mt-3 text-4xl font-semibold text-balance leading-[1.08] tracking-[-0.03em] text-dark md:text-5xl">
            Arbeiten, die Anfragen bringen.
          </h1>
          <p class="mt-4 max-w-[520px] text-lg font-medium text-balance leading-[1.4] tracking-[-0.01em] text-dark">
            Websites, Kampagnen und Recruiting-Content für Handwerksbetriebe – transparent, messbar und auf
            Ergebnisse gebaut.
          </p>
        </div>

        <div class="mt-16">
          <ProjekteGrid projekte={reihenfolge} />
        </div>

        <div class="mt-20 flex flex-col items-center justify-center gap-2.5 md:flex-row">
          <Button href="/kontakt" variant="blue" shadow="blue-glow">Jetzt unverbindlich anfragen</Button>
          <Button href="tel:+491784444156" variant="light">Direkt anrufen – 0178 4444 156</Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
