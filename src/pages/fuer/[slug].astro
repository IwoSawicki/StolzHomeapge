---
/* Persönliche Mappe — /fuer/<name>

   Seite für einen möglichen Kunden: Videos und Webseiten aus unserer
   Arbeit, für diese eine Firma ausgewählt. Texte, Videos und Webseiten je
   Mappe in src/data/mappen.ts. noindex, nicht in der Sitemap, nirgends
   verlinkt (wie /alle-projekte).

   Aufbau (Wunsch Iwo, 06.10.2026):
     1. dunkles Band mit Überschrift, den Videos in Gruppen (Recruiting,
        A/B-Test, Kundengewinnung) und den Webseiten
     2. „Unsere Leistungen" wie auf der Startseite
     3. Hinweis auf den Bewerbungs-Simulator
     4. Iwo als Ansprechpartner, groß
     5. Footer (Impressum)

   Verhalten
   - Karte: Standbild, Play-Kreis, Marke. Auf dem Desktop läuft beim
     Darüberfahren eine stumme Vorschau; auf dem Handy nicht.
   - Klick öffnet einen <dialog> mit dem Video in groß, mit Ton und
     Steuerleiste. Pfeiltasten oder Knöpfe blättern weiter, Esc schließt.
   - Laden: preload="none" überall. Ein Video lädt erst beim Abspielen. */
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import portraitIwo from '../../assets/portraits/iwo-sawicki.jpg';
import BrowserRahmen from '../../components/BrowserRahmen.astro';
import Leistungen from '../../components/sections/Leistungen.astro';
import { mappen, mappenGruppen, mappenWebseiten as w, mappenKontakt as k } from '../../data/mappen';
import { kontakt } from '../../data/navigation';
import { hero as simulator } from '../../data/bewerbungs-simulator';
import { vorauswahl } from '../../data/mitarbeiter-gewinnen';

export function getStaticPaths() {
  return mappen.map((mappe) => ({ params: { slug: mappe.slug }, props: { mappe } }));
}

const { mappe } = Astro.props;

/* Videos und Standbilder nach Dateinamen auffinden, egal in welchem
   Unterordner von src/assets sie liegen */
const nachName = <T,>(dateien: Record<string, T>) =>
  Object.fromEntries(Object.entries(dateien).map(([pfad, wert]) => [pfad.split('/').pop()!, wert]));
const quellen = nachName(
  import.meta.glob<{ default: string }>('../../assets/**/*.mp4', { eager: true }),
);
const standbilder = nachName(
  import.meta.glob<{ default: ImageMetadata }>('../../assets/**/*-standbild.jpg', { eager: true }),
);

const videos = await Promise.all(
  mappe.videos.map(async (video) => {
    const name = video.datei.replace(/\.mp4$/, '');
    const quelle = quellen[video.datei];
    const standbild = standbilder[`${name}-standbild.jpg`];
    if (!quelle || !standbild) throw new Error(`Mappe ${mappe.slug}: ${video.datei} oder Standbild fehlt`);
    const poster = await getImage({ src: standbild.default, width: 480, format: 'webp' });
    return { ...video, src: quelle.default, poster: poster.src };
  }),
);

/* Gruppen für die Anzeige. Die Nummer jedes Videos bleibt die aus der
   Gesamtliste, damit die Großansicht über alle Gruppen weiterblättert. */
const gruppen = mappenGruppen
  .map((g) => ({ ...g, videos: videos.map((v, i) => ({ ...v, i })).filter((v) => (v.gruppe ?? v.art) === g.schluessel) }))
  .filter((g) => g.videos.length > 0);

/* Bilder der Webseiten, Pfad ab src/assets/ */
const webseitenBilder = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projekte*/*.{webp,png,jpg}',
  { eager: true },
);
const webseiten = (mappe.webseiten ?? []).map((seite) => {
  const bild = webseitenBilder[`../../assets/${seite.bild}`];
  if (!bild) throw new Error(`Mappe ${mappe.slug}: Bild ${seite.bild} fehlt`);
  return { ...seite, bild: bild.default };
});

const blaettern =
  'flex h-44 w-44 cursor-pointer items-center justify-center rounded-full border border-lime-edge bg-transparent text-18 text-paper transition-colors hover:border-lime hover:bg-forest-card';
---

<BaseLayout
  title={`Für ${mappe.fuer} | Stolz Marketing`}
  description="Eine persönliche Auswahl aus unserer Arbeit."
  noindex
>
  <main class="bg-forest">
    <section
      class="relative overflow-hidden"
      style="background-image: radial-gradient(ellipse 70% 50% at 50% 0%, rgb(228 245 63 / 0.10), transparent 70%)"
    >
      <Header variante="dunkel" />

      <div class="mx-auto flex max-w-content-wide flex-col items-center px-page-x pt-[clamp(40px,6vw,72px)] pb-section-y-md text-center">
        <Eyebrow variante="lime">{mappe.eyebrow}</Eyebrow>
        <h1 class="m-0 mt-20 max-w-860 text-h1-sub leading-hero font-bold tracking-system text-paper">
          {mappe.titelVorn}<span class="font-display font-semibold tracking-none text-lime italic">{mappe.titelKursiv}</span>{mappe.titelHinten}
        </h1>
        <p class="m-0 mt-22 max-w-600 text-18 leading-body text-mint-light">{mappe.lead}</p>

        {/* --- Videokarten in Gruppen --- */}
        {
          gruppen.map((gruppe) => (
            <div class="mt-[clamp(40px,5vw,64px)] flex w-full flex-col items-center gap-24">
              <h2 class="m-0 flex w-full items-center gap-16 font-mono text-13 font-medium tracking-eyebrow uppercase text-mint">
                <span class="h-1 flex-1 bg-edge" aria-hidden="true"></span>
                {gruppe.titel}
                <span class="h-1 flex-1 bg-edge" aria-hidden="true"></span>
              </h2>
              {gruppe.ueberschrift && (
                <div class="flex max-w-680 flex-col items-center gap-12">
                  <p class="m-0 text-h3-proof leading-card font-bold tracking-heading text-paper">{gruppe.ueberschrift}</p>
                  {gruppe.lead && <p class="m-0 text-17 leading-body text-mint-light">{gruppe.lead}</p>}
                </div>
              )}
              <ul class="m-0 flex w-full list-none flex-wrap items-start justify-center gap-16 p-0 btn:gap-32">
                {gruppe.videos.map((video) => (
                  <li class="max-w-300 shrink-0 grow-0 basis-[calc(50%-8px)] btn:basis-[calc((100%-64px)/3)]">
                    <button
                      type="button"
                      class="group flex w-full cursor-pointer flex-col gap-16 border-0 bg-transparent p-0 text-left"
                      data-mappe-oeffnen={video.i}
                      aria-label={`Video ${video.kunde}${video.variante ? `, ${video.variante}` : ''} ansehen`}
                    >
                      <span class="relative block aspect-[9/16] w-full overflow-hidden rounded-20 bg-forest-black ring-1 ring-edge transition-[box-shadow,translate] duration-300 group-hover:-translate-y-4 group-hover:shadow-ring-lime">
                        <video
                          class="absolute inset-0 h-full w-full object-cover"
                          src={video.src}
                          poster={video.poster}
                          muted
                          loop
                          playsinline
                          preload="none"
                          aria-hidden="true"
                          tabindex="-1"
                          data-vorschau
                        ></video>
                        {video.variante && (
                          <span class="absolute top-12 left-12 rounded-full bg-lime px-12 py-6 text-13 font-bold text-forest-deep">
                            {video.variante}
                          </span>
                        )}
                        <span
                          class="absolute top-1/2 left-1/2 flex h-56 w-56 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-lime text-forest-deep shadow-glow-play transition-[scale,opacity] duration-300 group-hover:scale-110 btn:h-72 btn:w-72"
                          aria-hidden="true"
                        >
                          <svg class="ml-3 h-20 w-20 btn:h-26 btn:w-26" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l13-7.5z" /></svg>
                        </span>
                      </span>
                      <span class="flex flex-col gap-6">
                        <span class="text-16 leading-card font-bold text-paper btn:text-19">{video.variante ?? video.kunde}</span>
                        <span class="mt-4 font-mono text-11 tracking-eyebrow uppercase text-mint-dimmer">{w.labelMerkmal}</span>
                        <span class="text-14 leading-card font-bold text-lime btn:text-16">{video.merkmal}</span>
                        <span class="text-14 leading-tight-body text-mint btn:text-16">{video.text}</span>
                      </span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        {/* --- Webseiten --- */}
        {
          webseiten.length > 0 && (
            <div class="mt-[clamp(56px,7vw,96px)] flex w-full flex-col items-center gap-24">
              <h2 class="m-0 flex w-full items-center gap-16 font-mono text-13 font-medium tracking-eyebrow uppercase text-mint">
                <span class="h-1 flex-1 bg-edge" aria-hidden="true"></span>
                {w.titel}
                <span class="h-1 flex-1 bg-edge" aria-hidden="true"></span>
              </h2>
              <div class="flex max-w-680 flex-col items-center gap-12">
                <p class="m-0 text-h3-proof leading-card font-bold tracking-heading text-paper">{w.ueberschrift}</p>
                <p class="m-0 text-17 leading-body text-mint-light">{w.lead}</p>
              </div>
              <ul class="m-0 mt-8 grid w-full max-w-1000 list-none grid-cols-1 gap-x-32 gap-y-48 p-0 text-left btn:grid-cols-2">
                {webseiten.map((seite) => (
                  <li class="flex flex-col gap-16">
                    <a
                      href={`https://${seite.domain}`}
                      target="_blank"
                      rel="noopener"
                      class="group block no-underline"
                      aria-label={`${seite.name}: ${w.knopfWebseite} (neues Fenster)`}
                    >
                      <BrowserRahmen domain={seite.domain} radius="r12" class="transition-[box-shadow,translate] duration-300 group-hover:-translate-y-4 group-hover:shadow-ring-lime">
                        <Image
                          src={seite.bild}
                          alt={`Startseite von ${seite.name}`}
                          widths={[420, 720]}
                          sizes="(min-width: 720px) 480px, 90vw"
                          loading="lazy"
                          class="block aspect-[16/10] h-auto w-full object-cover object-top"
                        />
                      </BrowserRahmen>
                    </a>
                    <div class="flex flex-col gap-6">
                      <span class="text-16 leading-card font-bold text-paper btn:text-19">{seite.name}</span>
                      <span class="mt-4 font-mono text-11 tracking-eyebrow uppercase text-mint-dimmer">{w.labelMerkmal}</span>
                      <span class="text-14 leading-card font-bold text-lime btn:text-16">{seite.merkmal}</span>
                      <span class="text-14 leading-tight-body text-mint btn:text-16">{seite.text}</span>
                    </div>
                    <div class="flex flex-wrap gap-x-20 gap-y-8 text-15 font-bold">
                      <a href={`https://${seite.domain}`} target="_blank" rel="noopener" class="text-paper underline decoration-lime-edge underline-offset-4 transition-colors hover:decoration-lime">
                        {w.knopfWebseite} <span aria-hidden="true">↗</span>
                      </a>
                      {seite.projektseite && (
                        <a href={seite.projektseite} class="text-paper underline decoration-lime-edge underline-offset-4 transition-colors hover:decoration-lime">
                          {w.knopfProjekt} <span aria-hidden="true">→</span>
                        </a>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>

    {/* --- Leistungen, dieselbe Sektion wie auf der Startseite --- */}
    <Leistungen />

    {/* --- Bewerbungs-Simulator --- */}
    <section class="bg-paper px-page-x pb-section-y">
      <div class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-x-48 gap-y-28 rounded-24 bg-forest px-20 py-panel btn:p-panel">
        <div class="flex flex-1 basis-[min(460px,100%)] flex-col items-start gap-18">
          <Eyebrow variante="lime">{simulator.eyebrow}</Eyebrow>
          <h2 class="m-0 text-h2-sub leading-tightest font-bold tracking-system text-paper">
            {simulator.titelVorn}<span class="font-display font-semibold tracking-none text-lime italic">{simulator.titelKursiv}</span>{simulator.titelHinten}
          </h2>
          <p class="m-0 text-17 leading-body text-mint-light">{simulator.lead}</p>
        </div>
        <div class="flex flex-col items-start gap-24">
          <ul class="m-0 flex list-none flex-col gap-12 p-0">
            {
              simulator.punkte.map((punkt) => (
                <li class="flex items-center gap-12 text-16 text-paper">
                  <span class="flex h-24 w-24 shrink-0 items-center justify-center rounded-full bg-lime text-13 font-bold text-forest-deep" aria-hidden="true">✓</span>
                  {punkt}
                </li>
              ))
            }
          </ul>
          <a
            href="/bewerbungs-simulator"
            class="inline-flex h-56 items-center gap-8 rounded-full bg-lime px-20 text-15 font-bold whitespace-nowrap text-forest-deep no-underline shadow-glow transition-colors duration-200 hover:bg-lime-bright btn:px-28 btn:text-16"
          >
            {vorauswahl.simulatorKnopf}<span class="hidden text-18 hero:inline" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    {/* --- Ansprechpartner --- */}
    <section class="bg-paper-soft px-page-x py-section-y-md">
      <div class="mx-auto flex max-w-1000 flex-wrap items-center justify-center gap-x-[clamp(32px,6vw,80px)] gap-y-32 text-center btn:flex-nowrap btn:text-left">
        <Image
          src={portraitIwo}
          alt={k.name}
          width={640}
          class="aspect-[4/5] w-[min(300px,100%)] shrink-0 rounded-24 object-cover object-top shadow-card-light"
        />
        <div class="flex flex-col items-center gap-18 btn:items-start">
          <Eyebrow variante="hell">{k.eyebrow}</Eyebrow>
          <h2 class="m-0 text-h2-sub leading-tightest font-bold tracking-system text-ink">{k.titel}</h2>
          <p class="m-0 text-18 text-ink-muted">
            <span class="font-bold text-ink">{k.name}</span>, {k.rolle}
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-12 btn:justify-start">
            <a
              href={kontakt.telefonLink}
              class="inline-flex h-56 items-center rounded-full bg-lime px-28 text-17 font-bold text-forest-deep no-underline shadow-glow transition-colors hover:bg-lime-bright"
            >
              {kontakt.telefonAnzeige}
            </a>
            <a
              href={`mailto:${kontakt.email}`}
              class="inline-flex h-56 items-center rounded-full bg-paper px-28 text-17 font-bold text-ink no-underline ring-1 ring-line-strong transition-colors hover:bg-paper-hover"
            >
              {kontakt.email}
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  {/* --- Großansicht --- */}
  <dialog
    class="mappe-dialog fixed inset-0 m-0 h-full max-h-none w-full max-w-none overflow-y-auto border-0 bg-transparent p-0 text-paper"
    aria-label="Video"
    data-mappe-dialog
  >
    <div class="flex min-h-full w-full flex-col items-center justify-center gap-16 px-16 pt-72 pb-24 btn:flex-row btn:gap-32 btn:px-page-x btn:py-64" data-mappe-flaeche>
      <video
        class="aspect-[9/16] h-[min(56dvh,960px)] w-auto max-w-full shrink-0 rounded-20 btn:h-[min(84dvh,960px)] bg-forest-black object-contain shadow-badge"
        controls
        playsinline
        preload="none"
        data-mappe-player
      ></video>

      <div class="flex w-full max-w-[min(280px,100%)] flex-col gap-10 text-center btn:text-left">
        <span class="self-center rounded-full bg-forest-card px-10 py-5 text-12 font-medium text-mint-light btn:self-start" data-mappe-art></span>
        <p class="m-0 text-19 leading-card font-bold text-paper btn:text-22" data-mappe-kunde></p>
        <p class="m-0 flex flex-col gap-4 text-16 leading-card font-bold text-lime">
          <span class="font-mono text-11 font-normal tracking-eyebrow uppercase text-mint-dimmer">{w.labelMerkmal}</span>
          <span data-mappe-merkmal></span>
        </p>
        <p class="m-0 text-15 leading-body text-mint" data-mappe-text></p>
        <div class="mt-8 flex items-center justify-center gap-14 btn:justify-start">
          <button type="button" class={blaettern} data-mappe-schritt="-1" aria-label="Vorheriges Video">←</button>
          <span class="font-mono text-12 tracking-eyebrow text-mint-dimmer" data-mappe-zaehler></span>
          <button type="button" class={blaettern} data-mappe-schritt="1" aria-label="Nächstes Video">→</button>
        </div>
      </div>
    </div>

    <button
      type="button"
      class="absolute top-16 right-16 flex h-44 w-44 cursor-pointer items-center justify-center rounded-full border-0 bg-forest-card text-22 text-paper transition-colors hover:bg-forest-panel"
      aria-label="Schließen"
      data-mappe-schliessen
    >
      ×
    </button>
  </dialog>

  <script is:inline type="application/json" data-mappe-daten set:html={JSON.stringify(videos)} />

  <Footer />
</BaseLayout>

<style is:global>
  .mappe-dialog::backdrop {
    background: color-mix(in srgb, var(--color-forest-black) 92%, transparent);
    backdrop-filter: blur(6px);
  }
  /* Seite dahinter steht still, solange das Video offen ist */
  html:has(.mappe-dialog[open]) {
    overflow: hidden;
  }
</style>

<script>
  interface Video {
    src: string;
    poster: string;
    kunde: string;
    art: string;
    variante?: string;
    merkmal: string;
    text: string;
  }

  const daten = document.querySelector<HTMLScriptElement>('[data-mappe-daten]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-mappe-dialog]');
  const player = document.querySelector<HTMLVideoElement>('[data-mappe-player]');

  if (daten && dialog && player) {
    const videos: Video[] = JSON.parse(daten.textContent ?? '[]');
    const feld = (name: string) => dialog.querySelector<HTMLElement>(`[data-mappe-${name}]`)!;
    let aktuell = 0;

    const zeigen = (i: number) => {
      aktuell = (i + videos.length) % videos.length;
      const v = videos[aktuell]!;
      player.poster = v.poster;
      player.src = v.src;
      feld('zaehler').textContent = `${aktuell + 1} / ${videos.length}`;
      feld('art').textContent = v.variante ? `${v.art} · ${v.variante}` : v.art;
      feld('merkmal').textContent = v.merkmal;
      feld('kunde').textContent = v.kunde;
      feld('text').textContent = v.text;
      dialog.setAttribute('aria-label', `Video ${v.kunde}`);
      player.play().catch(() => {});
    };

    /* Karten öffnen die Großansicht */
    document.querySelectorAll<HTMLButtonElement>('[data-mappe-oeffnen]').forEach((knopf) => {
      knopf.addEventListener('click', () => {
        dialog.showModal();
        zeigen(Number(knopf.dataset.mappeOeffnen));
      });
    });

    dialog.querySelectorAll<HTMLButtonElement>('[data-mappe-schritt]').forEach((knopf) => {
      knopf.addEventListener('click', () => zeigen(aktuell + Number(knopf.dataset.mappeSchritt)));
    });
    feld('schliessen').addEventListener('click', () => dialog.close());

    /* Klick neben das Video schließt ebenfalls */
    feld('flaeche').addEventListener('click', (e) => {
      if (e.target === e.currentTarget) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') zeigen(aktuell + 1);
      if (e.key === 'ArrowLeft') zeigen(aktuell - 1);
    });

    /* Beim Schließen anhalten und die Quelle lösen, sonst lädt es weiter */
    dialog.addEventListener('close', () => {
      player.pause();
      player.removeAttribute('src');
      player.load();
    });

    /* Stumme Vorschau beim Darüberfahren, nur mit Maus */
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      document.querySelectorAll<HTMLButtonElement>('[data-mappe-oeffnen]').forEach((knopf) => {
        const vorschau = knopf.querySelector<HTMLVideoElement>('[data-vorschau]');
        if (!vorschau) return;
        knopf.addEventListener('mouseenter', () => {
          vorschau.play().catch(() => {});
        });
        knopf.addEventListener('mouseleave', () => {
          vorschau.pause();
          vorschau.currentTime = 0;
        });
      });
    }
  }
</script>
