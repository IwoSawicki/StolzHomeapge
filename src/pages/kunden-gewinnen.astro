---
/* Serviceseite Kundengewinnung. Sektionsreihenfolge aus
   design/Kunden gewinnen.dc.html */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroLeistung from '../components/sections/HeroLeistung.astro';
import MarqueeBand from '../components/sections/MarqueeBand.astro';
import Ausgangslage from '../components/sections/kunden/Ausgangslage.astro';
import SystemSchritte from '../components/sections/leistung/SystemSchritte.astro';
import Leistungsumfang from '../components/sections/leistung/Leistungsumfang.astro';
import Erstgespraech from '../components/sections/kunden/Erstgespraech.astro';
import Aufnahmekriterien from '../components/sections/kunden/Aufnahmekriterien.astro';
import Ausbau from '../components/sections/kunden/Ausbau.astro';
import FaqLeistung from '../components/sections/leistung/FaqLeistung.astro';
import Abschluss from '../components/sections/kunden/Abschluss.astro';
import { faqs, systemSchritte, leistungsumfang } from '../data/kunden-gewinnen';
---

<BaseLayout
  title="Kunden gewinnen | Stolz Marketing"
  description="Planbar Wunschaufträge gewinnen mit dem Platzhirsch-System — für Handwerksbetriebe an der Bergstraße und im Rhein-Neckar-Raum."
>
  {/* Hero und Marquee stehen zusammen im dunklen Band */}
  <div class="bg-forest">
    <Header />
    <HeroLeistung
      eyebrow="Neue Aufträge gewinnen"
      titelVorn="Planbar "
      titelAkzent="Wunschaufträge"
      titelHinten=" gewinnen mit dem Platzhirsch-System"
      lead="Für Handwerksbetriebe an der Bergstraße und im Rhein-Neckar-Raum, die nicht mehr auf Zufall und Empfehlung warten wollen — sondern selbst entscheiden, welche Projekte reinkommen."
      bildPlatzhalter="BILD · Hero Kundengewinnung"
    />
    <MarqueeBand />
  </div>

  <main>
    <Ausgangslage />
    <SystemSchritte
      eyebrow="Das Platzhirsch-System"
      titelVorn="Drei Schritte, "
      titelAkzent="immer in dieser Reihenfolge"
      lead="Erst wissen, wofür Sie stehen. Dann zeigen, dass Sie es können. Dann dafür sorgen, dass man Sie findet."
      schritte={systemSchritte}
    />
    <Leistungsumfang
      eyebrow="Leistungsumfang"
      titelVorn="Was am Ende "
      titelAkzent="bei Ihnen liegt"
      lead="Kein Abo auf eine Leistung, die niemand nachzählen kann. Das hier ist die Liste."
      bloecke={leistungsumfang}
    />
    <Erstgespraech />
    <Aufnahmekriterien />
    <Ausbau />
    <FaqLeistung eintraege={faqs} id="faq-kunden" />
    <Abschluss />
  </main>

  <Footer />
</BaseLayout>
