---
// /leistungen/webseiten — Leistungs-Unterseite, Layout eng am Vorbild
// madebyshape.co.uk (SEO-Seite) nachgebaut, in STOLZ-CI:
// 1. Hero: Eyebrow, H1 links / Intro rechts, großes Bild mit Notch-Button
// 2. Riesen-Statement + Leistungs-Checkliste rechts
// 3. Zahlen-Zeile (statt Shape-Awards: echte STOLZ-Zahlen)
// 4. Bild/Text-Split „aus allen Blickwinkeln"
// 5. Kontakt-Marquee (mittig wie bei Shape)
// 6. Dunkle 3×3-Leistungsmatrix (Lime-Akzente wie KI-Section)
// 7. Zwei Einstiegswege · 8. FAQ · 9. Website-Projekte
// Noch nicht in Navigation verlinkt (Entwurf auf dev).
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import ProjekteGrid from '../../components/ProjekteGrid.astro';
import MarqueeCta from '../../components/sections/MarqueeCta.astro';
import { projekte } from '../../data/projekte';
import teamBild from '../../assets/stolz-marketing-team.png';
import iwoBild from '../../assets/about/Iwo-StolzMarketing.jpg';

const websiteProjekte = projekte.filter((p) => p.art === 'website').slice(0, 4);

const faehigkeiten = ['Webdesign', 'Entwicklung', 'Lokales SEO', 'Landingpages', 'Texte & Inhalte', '+ mehr'];

const zahlen = [
  { wert: '14', label: 'umgesetzte Projekte' },
  { wert: '450+', label: 'gebaute Unterseiten' },
  { wert: '10', label: 'besetzte Stellen' },
  { wert: '5', label: 'betreute Restaurants' },
];

const matrix = [
  { titel: 'Webdesign', text: 'Klar, modern und zu Ihrem Betrieb passend — kein Baukasten-Look, sondern ein Auftritt, der Vertrauen schafft.' },
  { titel: 'Technische Umsetzung', text: 'Schnell, sicher und wartbar gebaut. Ihre Seite lädt in Sekundenbruchteilen — auf jedem Gerät.' },
  { titel: 'Lokales SEO', text: 'Damit Sie gefunden werden, wo Ihre Kunden suchen: in Ihrer Stadt und im Umkreis. Auf Wunsch mit eigenen Städte-Landingpages.' },
  { titel: 'Landingpages für Kampagnen', text: 'Google Ads oder Social Media geplant? Wir bauen Landingpages, die aus Klicks Anfragen machen.' },
  { titel: 'Texte & Inhalte', text: 'Ohne relevante Inhalte gibt es für Besucher keinen Grund zu bleiben — und für Google keinen Grund, Sie zu ranken. Wir bringen Ihre Leistung verständlich auf den Punkt.' },
  { titel: 'Ladezeit & Performance', text: 'Eine schnelle Seite ist entscheidend für die Sichtbarkeit. Wir optimieren Code, Bilder und Server-Setup.' },
  { titel: 'Meta-Daten & Suchbegriffe', text: 'Passende Titel, Beschreibungen und Suchbegriffe auf Basis echter Recherche — eine der ersten Aufgaben guter Sichtbarkeit.' },
  { titel: 'Hosting & Betreuung', text: 'Nach dem Launch lassen wir Sie nicht allein: Hosting, Backups und Änderungen zum festen Monatspreis.' },
  { titel: 'Web-Agentur Rhein-Main', text: 'Aus Reichelsheim — für lokale Betriebe im gesamten Rhein-Main-Gebiet und darüber hinaus.' },
];

const faq = [
  {
    frage: 'Was kostet eine Website?',
    antwort:
      'Ehrliche Antwort: Das hängt vom Umfang ab. Eine kompakte Firmenwebsite kostet weniger als ein Auftritt mit vielen Unterseiten und lokalen Landingpages. Nach einem kurzen Gespräch bekommen Sie von uns einen Festpreis — ohne versteckte Kosten.',
  },
  {
    frage: 'Wie lange dauert die Umsetzung?',
    antwort:
      'Je nach Umfang meist zwei bis sechs Wochen ab Startschuss. Sie bekommen einen klaren Fahrplan und sehen regelmäßig Zwischenstände — keine Funkstille.',
  },
  {
    frage: 'Bekomme ich nur das Design oder auch Technik und Hosting?',
    antwort:
      'Alles aus einer Hand: Konzept, Design, Texte, Umsetzung, Hosting und auf Wunsch die laufende Betreuung. Sie brauchen keinen zweiten Dienstleister.',
  },
  {
    frage: 'Ist SEO enthalten?',
    antwort:
      'Die Grundlagen immer: saubere Technik, schnelle Ladezeiten, klare Struktur und lokale Suchbegriffe. Wer mehr Sichtbarkeit will — zum Beispiel mit Städte-Landingpages wie bei HEPA Baut — bekommt ein passendes Paket dazu.',
  },
  {
    frage: 'Kann ich Inhalte später selbst pflegen?',
    antwort:
      'Ja, wenn Sie möchten. Viele Kunden geben das lieber an uns ab — dafür gibt es unsere Website-Betreuung zum festen Monatspreis: Sie melden sich, wir ändern.',
  },
  {
    frage: 'Was passiert nach dem Launch?',
    antwort:
      'Ihre Website bleibt in guten Händen: Hosting, Backups, Sicherheits-Updates und Änderungen auf Zuruf — oder Sie übernehmen selbst. Beides ist völlig okay.',
  },
];
---

<BaseLayout
  title="Webseiten & SEO | Leistungen | STOLZ Marketing"
  description="Webseiten für lokale Betriebe, die bei Google gefunden werden und Anfragen bringen — Design, Technik, Texte und lokales SEO aus einer Hand. Zum Festpreis."
>
  <Header />
  <main>
    <!-- 1. Hero: Eyebrow, H1 links / Intro rechts, großes Bild mit Notch-Button -->
    <section class="px-5 pt-12 md:px-10 md:pt-16">
      <div class="mx-auto max-w-[1240px]">
        <p class="flex items-center gap-2.5 text-sm font-medium text-dark" data-reveal>
          <span class="size-1.5 rounded-full bg-blue" aria-hidden="true"></span>
          Webseiten & SEO
        </p>

        <div class="mt-4 grid grid-cols-1 gap-8 xl:grid-cols-[1fr_520px] xl:gap-16">
          <h1
            class="max-w-[620px] text-4xl font-bold text-balance leading-[1.04] tracking-[-0.05em] text-dark md:text-52 xl:text-[64px] xl:leading-[1.02]"
            data-reveal
          >
            Sie suchen eine Web-Agentur im Rhein-Main-Gebiet?
          </h1>
          <div class="flex flex-col gap-4 self-center" data-reveal style="--reveal-delay:80ms">
            <p class="text-base font-medium leading-[1.6] text-dark/75 md:text-lg">
              Ihre Website ist Ihr wichtigstes Werkzeug, um neue Kunden zu gewinnen — egal ob Sie
              Dienstleistungen oder Produkte anbieten. Wir bauen Webseiten für lokale Betriebe, die bei
              Google gefunden werden und aus Besuchern Anfragen machen.
            </p>
            <p class="text-base font-medium leading-[1.6] text-dark/75 md:text-lg">
              Keine Website ist wie die andere: Wir schauen uns jedes Projekt einzeln an und entwickeln
              einen Auftritt, der zu Ihren Zielen passt — ehrlich beraten und verständlich erklärt.
            </p>
          </div>
        </div>

        <!-- Großes Bild, Button sitzt in ausgeschnittener Ecke oben links -->
        <div class="relative mt-10 md:mt-14" data-reveal>
          <div class="hero-notch absolute top-0 left-0 z-10 rounded-br-[20px] bg-white pr-2.5 pb-2.5">
            <a
              href="#mehr"
              class="inline-flex items-center gap-2 rounded-full bg-dark px-6 py-3 text-sm font-semibold text-white transition-colors duration-200 hover:bg-black md:text-base"
            >
              Mehr erfahren
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 7l10 10M17 7v10H7" />
              </svg>
            </a>
          </div>
          <div class="aspect-[16/10] overflow-hidden rounded-[28px] md:aspect-[16/8]">
            <Image
              src={teamBild}
              alt="Das Team von STOLZ Marketing bei der Arbeit"
              class="h-full w-full object-cover"
              widths={[640, 1024, 1600]}
              sizes="(min-width:1200px) 1240px, 100vw"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Riesen-Statement + Leistungs-Checkliste rechts -->
    <section id="mehr" class="scroll-mt-24 px-5 py-20 md:px-10 md:py-28">
      <div class="mx-auto grid max-w-[1240px] grid-cols-1 gap-12 xl:grid-cols-[1fr_320px] xl:gap-20">
        <div data-reveal>
          <p class="flex items-center gap-2.5 text-sm font-medium text-dark">
            <span class="size-1.5 rounded-full bg-blue" aria-hidden="true"></span>
            Webseiten
          </p>
          <p class="mt-5 max-w-[760px] text-3xl font-semibold text-balance leading-[1.12] tracking-[-0.03em] text-dark md:text-40 xl:text-[46px] xl:leading-[1.1]">
            Wie wichtig ist es für Ihren Betrieb, bei Google gefunden zu werden? Mehr Besucher zu
            bekommen? <span class="text-blue">Mehr Anfragen?</span>
          </p>
          <div class="mt-8">
            <Button href="/#ueber-uns" variant="blue" shadow="blue-glow">Über STOLZ</Button>
          </div>
        </div>

        <div class="self-center" data-reveal style="--reveal-delay:80ms">
          <p class="text-sm font-medium text-dark/50">Unsere Website-Leistungen</p>
          <ul class="mt-5 flex flex-col gap-4">
            {
              faehigkeiten.map((punkt) => (
                <li class="flex items-center gap-3 text-base font-semibold tracking-[-0.01em] text-dark">
                  <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-dark text-white">
                    <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m5 13 4 4L19 7" />
                    </svg>
                  </span>
                  {punkt}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- 3. Zahlen-Zeile (statt Shape-Awards: echte STOLZ-Zahlen) -->
      <div class="mx-auto mt-20 grid max-w-[1100px] grid-cols-2 gap-10 md:mt-28 md:grid-cols-4" data-reveal>
        {
          zahlen.map((z) => (
            <div class="text-center">
              <p class="text-40 font-semibold tracking-[-0.03em] text-dark tabular-nums">{z.wert}</p>
              <p class="mt-1 text-sm font-medium text-dark/50">{z.label}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 4. Bild/Text-Split „aus allen Blickwinkeln" -->
    <section class="px-5 pb-8 md:px-10 md:pb-12">
      <div class="mx-auto grid max-w-[1240px] grid-cols-1 items-center gap-10 xl:grid-cols-2 xl:gap-20">
        <div class="overflow-hidden rounded-[28px]" data-reveal>
          <Image
            src={iwoBild}
            alt="Iwo Sawicki von STOLZ Marketing"
            class="aspect-[4/4.4] h-full w-full object-cover object-top"
            widths={[520, 900]}
            sizes="(min-width:1200px) 600px, 100vw"
          />
        </div>

        <div data-reveal style="--reveal-delay:80ms">
          <p class="flex items-center gap-2.5 text-sm font-medium text-dark">
            <span class="size-1.5 rounded-full bg-blue" aria-hidden="true"></span>
            Ehrlich gesagt
          </p>
          <h2 class="mt-4 max-w-[560px] text-3xl font-semibold text-balance leading-[1.1] tracking-[-0.03em] text-dark md:text-4xl">
            Eine Agentur, die Websites aus allen Blickwinkeln versteht.
          </h2>
          <p class="mt-5 max-w-[560px] text-base font-medium leading-[1.6] text-dark/70 md:text-lg">
            Design, Technik, Texte und Sichtbarkeit gehören bei uns zusammen. Weil wir auch Google Ads,
            Social Media und Recruiting-Kampagnen betreuen, wissen wir genau, was eine Website können
            muss, damit aus Besuchern Anfragen werden — und setzen es technisch sauber um. Entwicklung,
            Inhalte und Marketing arbeiten Hand in Hand, immer mit Blick auf Ihre Ziele.
          </p>
          <ul class="mt-6 flex flex-col gap-3">
            <li class="flex items-center gap-3 text-base font-semibold text-dark">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-blue text-white">
                <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m5 13 4 4L19 7" />
                </svg>
              </span>
              Ein fester Ansprechpartner für alles
            </li>
            <li class="flex items-center gap-3 text-base font-semibold text-dark">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-blue text-white">
                <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m5 13 4 4L19 7" />
                </svg>
              </span>
              Ergebnisse, die Sie schwarz auf weiß sehen
            </li>
          </ul>
          <div class="mt-8">
            <Button href="/kontakt" variant="blue" shadow="blue-glow">Jetzt Kontakt aufnehmen</Button>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Kontakt-Marquee (mittig wie bei Shape) -->
    <MarqueeCta />

    <!-- 6. Dunkle 3×3-Leistungsmatrix -->
    <section class="bg-dark px-5 py-16 md:px-10 md:py-24">
      <div class="mx-auto max-w-[1240px]">
        <div class="grid grid-cols-1 gap-8 xl:grid-cols-[1fr_auto] xl:items-end" data-reveal>
          <div>
            <p class="flex items-center gap-2.5 text-sm font-medium text-white/80">
              <span class="size-1.5 rounded-full bg-lime" aria-hidden="true"></span>
              Womit wir Ihnen helfen
            </p>
            <h2 class="mt-4 max-w-[640px] text-3xl font-semibold text-balance leading-[1.1] tracking-[-0.03em] text-white md:text-40">
              Ein Team, das Ihre Website bei Google nach vorne bringt
            </h2>
          </div>
          <a
            href="/kontakt"
            class="inline-flex h-fit w-fit items-center gap-2 rounded-full bg-lime px-6 py-3 text-base font-semibold text-dark transition-transform duration-200 hover:scale-[1.03]"
          >
            Jetzt anfragen
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7M8 7h9v9" />
            </svg>
          </a>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-x-12 md:grid-cols-2 xl:grid-cols-3">
          {
            matrix.map((eintrag, i) => (
              <div
                class="border-t border-white/10 py-8"
                data-reveal
                style={`--reveal-delay:${(i % 3) * 60}ms`}
              >
                <div class="flex items-center gap-3.5">
                  <span class="flex size-9 shrink-0 items-center justify-center rounded-[10px] bg-lime text-dark">
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m5 13 4 4L19 7" />
                    </svg>
                  </span>
                  <h3 class="text-xl font-semibold tracking-[-0.01em] text-white">{eintrag.titel}</h3>
                </div>
                <p class="mt-4 text-15 font-medium leading-[1.6] text-white/60">{eintrag.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 7. Zwei Einstiegswege -->
    <section class="px-5 pt-16 md:px-10 md:pt-24">
      <div class="mx-auto grid max-w-[1240px] grid-cols-1 gap-6 md:grid-cols-2">
        <div class="flex flex-col items-start rounded-[28px] bg-bg-blue-light p-8 md:p-10" data-reveal>
          <h2 class="text-2xl font-semibold text-balance tracking-[-0.02em] text-dark md:text-3xl">
            Sie brauchen eine neue Website?
          </h2>
          <p class="mt-3 mb-8 text-base font-medium leading-[1.55] text-dark/60">
            Ob erster Auftritt oder kompletter Neustart: Wir bauen Ihre Seite von Grund auf — Konzept,
            Design, Texte, Technik. Sie bekommen einen Festpreis und einen klaren Fahrplan.
          </p>
          <div class="mt-auto">
            <Button href="/kontakt" variant="blue" shadow="blue-glow">Kostenlose Analyse</Button>
          </div>
        </div>

        <div class="flex flex-col items-start rounded-[28px] border border-border bg-white p-8 shadow-card-soft md:p-10" data-reveal style="--reveal-delay:80ms">
          <h2 class="text-2xl font-semibold text-balance tracking-[-0.02em] text-dark md:text-3xl">
            Ihre Seite bringt keine Anfragen?
          </h2>
          <p class="mt-3 mb-8 text-base font-medium leading-[1.55] text-dark/60">
            Sie haben schon eine Website, aber es passiert nichts? Wir schauen ehrlich drauf: Was gut ist,
            bleibt. Was bremst, wird verbessert — von der Ladezeit bis zur Sichtbarkeit bei Google.
          </p>
          <div class="mt-auto">
            <Button href="/kontakt" variant="light">Website prüfen lassen</Button>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. FAQ (gleiches Muster wie Kontakt-Seite) -->
    <section class="px-4.5 py-16 md:px-10 md:py-24">
      <h2 class="text-center text-40 font-semibold text-balance tracking-[-0.03em] text-navy">
        Die Antworten auf Ihre Fragen
      </h2>
      <div class="mx-auto mt-4 grid max-w-[1170px] grid-cols-1 gap-x-20 md:grid-cols-2" data-faq>
        {
          [faq.slice(0, 3), faq.slice(3)].map((spalte, s) => (
            <div>
              {spalte.map((item, i) => (
                <div class:list={['border-b-2', i % 2 === 0 ? 'border-blue' : 'border-gray']}>
                  <button
                    type="button"
                    class="flex w-full cursor-pointer items-center justify-between gap-4 py-[30px] text-left"
                    aria-expanded="false"
                    aria-controls={`faq-antwort-${s}-${i}`}
                  >
                    <span class="text-xl font-semibold leading-[1.3] tracking-[-0.03em] text-navy">{item.frage}</span>
                    <svg
                      class="size-3 shrink-0 rotate-90 text-gray transition-transform duration-200"
                      viewBox="0 0 8 12"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m 1.5 1.5 5 4.5 -5 4.5" />
                    </svg>
                  </button>
                  <div id={`faq-antwort-${s}-${i}`} class="hidden pb-[30px]" role="region">
                    <p class="text-base font-medium leading-[1.5] text-dark/60">{item.antwort}</p>
                  </div>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <!-- 9. Website-Projekte -->
    <section id="projekte" class="scroll-mt-24 px-5 pb-20 md:px-10 md:pb-28">
      <div class="mx-auto max-w-[1240px]">
        <div class="mx-auto max-w-[640px]" data-reveal>
          <SectionHeading label="Projekte">
            Unsere liebsten Website-Projekte
            <Fragment slot="description">
              Echte Seiten für echte Betriebe — gebaut, um gefunden zu werden.
            </Fragment>
          </SectionHeading>
        </div>
        <div class="mt-12">
          <ProjekteGrid projekte={websiteProjekte} />
        </div>
        <div class="mt-14 text-center">
          <Button href="/projekte" variant="light">Alle Projekte ansehen</Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Notch oben links am Hero-Bild: Button sitzt in ausgeschnittener Ecke,
     Negativ-Rundungen in Seiten-Weiß (Technik wie Projekt-Grid/Pakete). */
  .hero-notch::before,
  .hero-notch::after {
    content: '';
    position: absolute;
    width: 20px;
    height: 20px;
    background: radial-gradient(circle at 100% 100%, transparent 20px, var(--color-white) 20px);
  }
  .hero-notch::before {
    top: 0;
    right: -20px;
  }
  .hero-notch::after {
    top: 100%;
    left: 0;
  }
</style>

<script>
  // FAQ-Akkordeon (identisch zur Kontakt-Seite)
  document.querySelectorAll('[data-faq] button').forEach((btn) => {
    btn.addEventListener('click', () => {
      const offen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!offen));
      const antwort = document.getElementById(btn.getAttribute('aria-controls')!)!;
      antwort.classList.toggle('hidden', offen);
      btn.querySelector('svg')!.classList.toggle('rotate-90', offen);
      btn.querySelector('svg')!.classList.toggle('-rotate-90', !offen);
    });
  });
</script>
