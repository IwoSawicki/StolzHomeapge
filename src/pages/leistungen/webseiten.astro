---
// /leistungen/webseiten — erste Leistungs-Unterseite (Entwurf).
// Aufbau inspiriert von madebyshape.co.uk (SEO-Service-Seite), übersetzt
// in die STOLZ-Positionierung: Intro → Statement → Leistungs-Karten →
// zwei Einstiegswege → FAQ → Website-Projekte → Kontakt-Marquee.
// Noch NICHT in Navigation/Leistungs-Sektion verlinkt (Entwurf auf dev).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import ProjekteGrid from '../../components/ProjekteGrid.astro';
import MarqueeCta from '../../components/sections/MarqueeCta.astro';
import { projekte } from '../../data/projekte';

const websiteProjekte = projekte.filter((p) => p.art === 'website').slice(0, 4);

const schnellPunkte = ['Webdesign', 'Entwicklung', 'Lokales SEO', 'Landingpages', 'Texte & Inhalte', '+ mehr'];

const leistungen = [
  {
    titel: 'Webdesign',
    text: 'Klar, modern und zu Ihrem Betrieb passend — kein Baukasten-Look, sondern ein Auftritt, der Vertrauen schafft.',
  },
  {
    titel: 'Technische Umsetzung',
    text: 'Schnell, sicher und wartbar gebaut. Ihre Seite lädt in Sekundenbruchteilen — auf jedem Gerät.',
  },
  {
    titel: 'Lokales SEO',
    text: 'Damit Sie gefunden werden, wo Ihre Kunden suchen: in Ihrer Stadt und im Umkreis. Auf Wunsch mit eigenen Städte-Landingpages.',
  },
  {
    titel: 'Ladezeit & Performance',
    text: 'Google liebt schnelle Seiten — Ihre Besucher auch. Wir optimieren Bilder, Code und Server-Setup.',
  },
  {
    titel: 'Landingpages für Kampagnen',
    text: 'Google Ads oder Social Media geplant? Wir bauen Landingpages, die aus Klicks Anfragen machen.',
  },
  {
    titel: 'Texte & Inhalte',
    text: 'Verständliche Texte, die Ihre Leistung auf den Punkt bringen — ohne Fachchinesisch und Floskeln.',
  },
  {
    titel: 'Impressum & Datenschutz',
    text: 'Die rechtlichen Basics von Anfang an sauber: Impressum, Datenschutzerklärung und Cookie-Hinweis.',
  },
  {
    titel: 'Hosting & Betreuung',
    text: 'Nach dem Launch lassen wir Sie nicht allein: Hosting, Backups und Änderungen zum festen Monatspreis.',
  },
];

const faq = [
  {
    frage: 'Was kostet eine Website?',
    antwort:
      'Ehrliche Antwort: Das hängt vom Umfang ab. Eine kompakte Firmenwebsite kostet weniger als ein Auftritt mit vielen Unterseiten und lokalen Landingpages. Nach einem kurzen Gespräch bekommen Sie von uns einen Festpreis — ohne versteckte Kosten.',
  },
  {
    frage: 'Wie lange dauert die Umsetzung?',
    antwort:
      'Je nach Umfang meist zwei bis sechs Wochen ab Startschuss. Sie bekommen einen klaren Fahrplan und sehen regelmäßig Zwischenstände — keine Funkstille.',
  },
  {
    frage: 'Bekomme ich nur das Design oder auch Technik und Hosting?',
    antwort:
      'Alles aus einer Hand: Konzept, Design, Texte, Umsetzung, Hosting und auf Wunsch die laufende Betreuung. Sie brauchen keinen zweiten Dienstleister.',
  },
  {
    frage: 'Ist SEO enthalten?',
    antwort:
      'Die Grundlagen immer: saubere Technik, schnelle Ladezeiten, klare Struktur und lokale Suchbegriffe. Wer mehr Sichtbarkeit will — zum Beispiel mit Städte-Landingpages wie bei HEPA Baut — bekommt ein passendes Paket dazu.',
  },
  {
    frage: 'Kann ich Inhalte später selbst pflegen?',
    antwort:
      'Ja, wenn Sie möchten. Viele Kunden geben das lieber an uns ab — dafür gibt es unsere Website-Betreuung zum festen Monatspreis: Sie melden sich, wir ändern.',
  },
  {
    frage: 'Was passiert nach dem Launch?',
    antwort:
      'Ihre Website bleibt in guten Händen: Hosting, Backups, Sicherheits-Updates und Änderungen auf Zuruf — oder Sie übernehmen selbst. Beides ist völlig okay.',
  },
];
---

<BaseLayout
  title="Webseiten & SEO | Leistungen | STOLZ Marketing"
  description="Webseiten für lokale Betriebe, die bei Google gefunden werden und Anfragen bringen — Design, Technik, Texte und lokales SEO aus einer Hand. Zum Festpreis."
>
  <Header />
  <main>
    <!-- 1. Kopf -->
    <section class="px-5 pt-14 md:px-10 md:pt-20">
      <div class="mx-auto max-w-[1200px]">
        <div class="max-w-[720px]" data-reveal>
          <SectionLabel text="Leistung · Webseiten & SEO" />
          <h1 class="mt-2 text-4xl font-bold text-balance leading-[1.05] tracking-[-0.06em] text-dark md:text-40 xl:text-5xl">
            Webseiten, die Anfragen bringen.
          </h1>
          <p class="mt-5 text-lg font-medium leading-[1.55] text-dark/70">
            Ihre Website ist Ihr wichtigstes Werkzeug, um neue Kunden zu gewinnen — egal ob Sie
            Dienstleistungen oder Produkte anbieten. Wir bauen Webseiten für lokale Betriebe, die bei
            Google gefunden werden und aus Besuchern Anfragen machen.
          </p>
          <p class="mt-4 text-lg font-medium leading-[1.55] text-dark/70">
            Keine Website ist wie die andere: Wir schauen uns Ihren Betrieb, Ihre Kunden und Ihre Region
            an und entwickeln einen Auftritt, der zu Ihren Zielen passt — verständlich erklärt und ehrlich
            beraten.
          </p>
          <div class="mt-8 flex flex-col items-start gap-2.5 sm:flex-row sm:items-center">
            <Button href="/kontakt" variant="blue" shadow="blue-glow">Kostenlose Analyse</Button>
            <Button href="#projekte" variant="light">Beispiele ansehen</Button>
          </div>
        </div>

        <!-- Schnell-Überblick -->
        <div class="mt-10 flex flex-wrap gap-2" data-reveal>
          {
            schnellPunkte.map((punkt) => (
              <span class="rounded-full border border-border bg-bg-soft px-4 py-2 text-sm font-semibold text-dark">
                {punkt}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 2. Statement: warum Websites von einer Marketing-Agentur -->
    <section class="px-3 pt-14 md:px-6 md:pt-20 xl:px-10">
      <div class="mx-auto max-w-[1240px] rounded-[32px] bg-bg-blue-light px-6 py-12 md:px-12 md:py-16 xl:px-16" data-reveal>
        <SectionLabel text="Warum wir" />
        <p class="mt-6 max-w-[880px] text-3xl font-semibold text-balance leading-[1.15] tracking-[-0.03em] text-slate md:text-4xl">
          Eine Website ist bei uns kein Design-Projekt — sie ist Ihr
          <span class="text-blue">fleißigster Mitarbeiter</span>.
        </p>
        <p class="mt-6 max-w-[640px] text-lg font-medium leading-[1.55] text-slate/70">
          Wir bauen Websites als Marketing-Agentur, nicht als Designstudio: Weil wir auch Google Ads,
          Social Media und Recruiting-Kampagnen betreuen, wissen wir genau, was eine Seite können muss,
          damit aus Besuchern Anfragen werden. Design, Technik, Texte und Sichtbarkeit kommen aus einer
          Hand — abgestimmt auf Ihr Ziel.
        </p>
      </div>
    </section>

    <!-- 3. Leistungs-Karten -->
    <section class="px-5 pt-16 md:px-10 md:pt-24">
      <div class="mx-auto max-w-[1200px]">
        <div class="mx-auto max-w-[640px]" data-reveal>
          <SectionHeading label="Was drinsteckt">
            Womit wir Ihnen helfen können
            <Fragment slot="description">
              Alles, was eine Website braucht, um gefunden zu werden und zu überzeugen — Sie entscheiden,
              wie viel davon Sie brauchen.
            </Fragment>
          </SectionHeading>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
          {
            leistungen.map((leistung, i) => (
              <div
                class="rounded-24 border border-border bg-white p-6 shadow-card-soft"
                data-reveal
                style={`--reveal-delay:${(i % 4) * 60}ms`}
              >
                <span class="flex size-9 items-center justify-center rounded-full bg-blue/10 text-blue">
                  <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m5 13 4 4L19 7" />
                  </svg>
                </span>
                <h3 class="mt-4 text-lg font-semibold tracking-[-0.01em] text-dark">{leistung.titel}</h3>
                <p class="mt-2 text-15 font-medium leading-[1.5] text-dark/60">{leistung.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 4. Zwei Einstiegswege -->
    <section class="px-5 pt-16 md:px-10 md:pt-24">
      <div class="mx-auto grid max-w-[1200px] grid-cols-1 gap-6 md:grid-cols-2">
        <div class="flex flex-col items-start rounded-[28px] bg-dark p-8 md:p-10" data-reveal>
          <h2 class="text-2xl font-semibold text-balance tracking-[-0.02em] text-white md:text-3xl">
            Sie brauchen eine neue Website?
          </h2>
          <p class="mt-3 mb-8 text-base font-medium leading-[1.55] text-white/70">
            Ob erster Auftritt oder kompletter Neustart: Wir bauen Ihre Seite von Grund auf — Konzept,
            Design, Texte, Technik. Sie bekommen einen Festpreis und einen klaren Fahrplan.
          </p>
          <div class="mt-auto">
            <Button href="/kontakt" variant="white">Kostenlose Analyse</Button>
          </div>
        </div>

        <div class="flex flex-col items-start rounded-[28px] border border-border bg-white p-8 shadow-card-soft md:p-10" data-reveal style="--reveal-delay:80ms">
          <h2 class="text-2xl font-semibold text-balance tracking-[-0.02em] text-dark md:text-3xl">
            Ihre Seite bringt keine Anfragen?
          </h2>
          <p class="mt-3 mb-8 text-base font-medium leading-[1.55] text-dark/60">
            Sie haben schon eine Website, aber es passiert nichts? Wir schauen ehrlich drauf: Was gut ist,
            bleibt. Was bremst, wird verbessert — von der Ladezeit bis zur Sichtbarkeit bei Google.
          </p>
          <div class="mt-auto">
            <Button href="/kontakt" variant="blue" shadow="blue-glow">Website prüfen lassen</Button>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. FAQ (gleiches Muster wie Kontakt-Seite) -->
    <section class="px-4.5 py-16 md:px-10 md:py-24">
      <h2 class="text-center text-40 font-semibold text-balance tracking-[-0.03em] text-navy">
        Die Antworten auf Ihre Fragen
      </h2>
      <div class="mx-auto mt-4 grid max-w-[1170px] grid-cols-1 gap-x-20 md:grid-cols-2" data-faq>
        {
          [faq.slice(0, 3), faq.slice(3)].map((spalte, s) => (
            <div>
              {spalte.map((item, i) => (
                <div class:list={['border-b-2', i % 2 === 0 ? 'border-blue' : 'border-gray']}>
                  <button
                    type="button"
                    class="flex w-full cursor-pointer items-center justify-between gap-4 py-[30px] text-left"
                    aria-expanded="false"
                    aria-controls={`faq-antwort-${s}-${i}`}
                  >
                    <span class="text-xl font-semibold leading-[1.3] tracking-[-0.03em] text-navy">{item.frage}</span>
                    <svg
                      class="size-3 shrink-0 rotate-90 text-gray transition-transform duration-200"
                      viewBox="0 0 8 12"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m 1.5 1.5 5 4.5 -5 4.5" />
                    </svg>
                  </button>
                  <div id={`faq-antwort-${s}-${i}`} class="hidden pb-[30px]" role="region">
                    <p class="text-base font-medium leading-[1.5] text-dark/60">{item.antwort}</p>
                  </div>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </section>

    <!-- 6. Website-Projekte -->
    <section id="projekte" class="scroll-mt-24 px-5 pb-16 md:px-10 md:pb-24">
      <div class="mx-auto max-w-[1200px]">
        <div class="mx-auto max-w-[640px]" data-reveal>
          <SectionHeading label="Projekte">
            Unsere liebsten Website-Projekte
            <Fragment slot="description">
              Echte Seiten für echte Betriebe — gebaut, um gefunden zu werden.
            </Fragment>
          </SectionHeading>
        </div>
        <div class="mt-12">
          <ProjekteGrid projekte={websiteProjekte} />
        </div>
        <div class="mt-14 text-center">
          <Button href="/projekte" variant="light">Alle Projekte ansehen</Button>
        </div>
      </div>
    </section>

    <MarqueeCta />
  </main>
  <Footer />
</BaseLayout>

<script>
  // FAQ-Akkordeon (identisch zur Kontakt-Seite)
  document.querySelectorAll('[data-faq] button').forEach((btn) => {
    btn.addEventListener('click', () => {
      const offen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!offen));
      const antwort = document.getElementById(btn.getAttribute('aria-controls')!)!;
      antwort.classList.toggle('hidden', offen);
      btn.querySelector('svg')!.classList.toggle('rotate-90', offen);
      btn.querySelector('svg')!.classList.toggle('-rotate-90', !offen);
    });
  });
</script>
