---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import UeberUns from '../components/sections/UeberUns.astro';
import HeroVarianteShape2 from '../components/sections/HeroVarianteShape2.astro';
import LeistungenZweiE from '../components/sections/LeistungenZweiE.astro';
import ProzessVarianteB from '../components/sections/ProzessVarianteB.astro';
import Ergebnis from '../components/sections/Ergebnis.astro';
import ProjekteShape from '../components/sections/ProjekteShape.astro';
import TeamVarianteB from '../components/sections/TeamVarianteB.astro';
import Kundenlogos from '../components/sections/Kundenlogos.astro';
import MarqueeCta from '../components/sections/MarqueeCta.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main>
    <HeroVarianteShape2 />
    <UeberUns />
    <ProjekteShape />
    {/* Zwei-Säulen-Sektion — Variante E vorläufig, Auswahl über /vorschau-leistungen */}
    <LeistungenZweiE />
    <ProzessVarianteB />
    <Ergebnis />
    <TeamVarianteB />
    <Kundenlogos />
    <MarqueeCta />
  </main>
  <Footer />
</BaseLayout>
