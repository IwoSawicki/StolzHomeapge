---
/* Startseite – Aneinanderreihung der Sektionen in der Reihenfolge der
   Vorlage (design/README.md, „Screens / Views" → 1. Startseite). */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import LogoMarquee from '../components/sections/LogoMarquee.astro';
import Leistungen from '../components/sections/Leistungen.astro';
import Projekte from '../components/sections/Projekte.astro';
import Branchen from '../components/sections/BranchenGrid.astro';
import WarumEsFunktioniert from '../components/sections/WarumEsFunktioniert.astro';
import UeberUns from '../components/sections/UeberUns.astro';
import Bewertungen from '../components/sections/Bewertungen.astro';
import Standort from '../components/sections/Standort.astro';
import Faq from '../components/sections/Faq.astro';
import Zusammenarbeit from '../components/sections/Zusammenarbeit.astro';
import KiFragen from '../components/sections/KiFragen.astro';
import Footer from '../components/Footer.astro';

/* Title und Description sind aus der H1 und dem Lead der Vorlage gebildet —
   die Vorlage macht selbst keine Meta-Angaben. Freigabe steht aus,
   siehe docs/ABWEICHUNGEN.md. */
---

<BaseLayout
  title="Stolz Marketing | Volle Auftragsbücher & passende Bewerber"
  description="Marketing für Handwerksbetriebe an der Bergstraße und in Südhessen: Wunschprojekte gewinnen, offene Stellen besetzen und den Betrieb online so zeigen, wie er wirklich ist."
>
  <Hero />
  <main>
    <LogoMarquee />
    <Leistungen />
    <Projekte />
    <Branchen />
    <WarumEsFunktioniert />
    <UeberUns />
    <Bewertungen />
    <Standort />
    <Faq />
    <Zusammenarbeit />
    <KiFragen />
  </main>
  <Footer />
</BaseLayout>
