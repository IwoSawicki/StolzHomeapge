---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/sections/Hero.astro';
import HeroVarianteShape from '../components/sections/HeroVarianteShape.astro';
import HeroVarianteShape2 from '../components/sections/HeroVarianteShape2.astro';
import Einblicke from '../components/sections/Einblicke.astro';
import PainpointTabs from '../components/sections/PainpointTabs.astro';
import Leistungen from '../components/sections/Leistungen.astro';
import Prozess from '../components/sections/Prozess.astro';
import Ergebnis from '../components/sections/Ergebnis.astro';
import Projekte from '../components/sections/Projekte.astro';
import ProjekteVarianteA from '../components/sections/ProjekteVarianteA.astro';
import ProjekteVarianteB from '../components/sections/ProjekteVarianteB.astro';
import ProjekteVarianteC from '../components/sections/ProjekteVarianteC.astro';
import ProjekteVarianteD from '../components/sections/ProjekteVarianteD.astro';
import ProjekteVarianteE from '../components/sections/ProjekteVarianteE.astro';
import Statistics from '../components/sections/Statistics.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main>
    <!-- Hero-Variante mit Hochkant-Video (Shape-Stil) über der bisherigen
         Hero zur Auswahl; nach der Entscheidung bleibt nur eine. -->
    <HeroVarianteShape />
    <HeroVarianteShape2 />
    <Hero />
    <Einblicke />
    <PainpointTabs />
    <Leistungen />
    <Prozess />
    <Ergebnis />
    <!-- Design-Varianten zur Auswahl; alte Sektion darunter, wird nach
         der Entscheidung entfernt. C–E = cleaner/editorial (Shape-inspiriert) -->
    <ProjekteVarianteC />
    <ProjekteVarianteD />
    <ProjekteVarianteE />
    <ProjekteVarianteA />
    <ProjekteVarianteB />
    <Projekte />
    <Statistics />
  </main>
  <Footer />
</BaseLayout>
