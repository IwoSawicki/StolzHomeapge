---
// Platzhalter — hier entsteht der 1:1-Nachbau der Design-Vorlage.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="STOLZ Marketing">
  <main style="font-family: system-ui, sans-serif; padding: 4rem 1.5rem; max-width: 40rem; margin: 0 auto;">
    <h1 style="font-size: 1.5rem; margin: 0 0 0.75rem;">Neuaufbau</h1>
    <p style="margin: 0; color: #555; line-height: 1.6;">
      Branch <code>redesign</code> — leer geräumt und bereit für den Nachbau der
      Design-Vorlage. Die HTML-Dateien aus Claude Design kommen nach
      <code>design/</code>.
    </p>
  </main>
</BaseLayout>
