---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import UeberUns from '../components/sections/UeberUns.astro';
import HeroVarianteShape2 from '../components/sections/HeroVarianteShape2.astro';
import Einblicke from '../components/sections/Einblicke.astro';
import PainpointTabs from '../components/sections/PainpointTabs.astro';
import Leistungen from '../components/sections/Leistungen.astro';
import Prozess from '../components/sections/Prozess.astro';
import Ergebnis from '../components/sections/Ergebnis.astro';
