---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import UeberUns from '../components/sections/UeberUns.astro';
import HeroVarianteShape2 from '../components/sections/HeroVarianteShape2.astro';
import LeistungenExpertise from '../components/sections/LeistungenExpertise.astro';
import Prozess from '../components/sections/Prozess.astro';
import ProzessVarianteA from '../components/sections/ProzessVarianteA.astro';
import ProzessVarianteB from '../components/sections/ProzessVarianteB.astro';
import ProzessVarianteC from '../components/sections/ProzessVarianteC.astro';
import TeamVarianteA from '../components/sections/TeamVarianteA.astro';
import TeamVarianteB from '../components/sections/TeamVarianteB.astro';
import TeamVarianteC from '../components/sections/TeamVarianteC.astro';
import Ergebnis from '../components/sections/Ergebnis.astro';
import ProjekteShape from '../components/sections/ProjekteShape.astro';
import Statistics from '../components/sections/Statistics.astro';
import MarqueeCta from '../components/sections/MarqueeCta.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <Header />
  <main>
    <HeroVarianteShape2 />
    <UeberUns />
    <!-- Team-Designs zur Auswahl; nach der Entscheidung bleibt eins. -->
    <TeamVarianteA />
    <TeamVarianteB />
    <TeamVarianteC />
    <ProjekteShape />
    <LeistungenExpertise />
    <!-- Prozess-Designs zur Auswahl; nach der Entscheidung bleibt eins. -->
    <ProzessVarianteA />
    <ProzessVarianteB />
    <ProzessVarianteC />
    <Ergebnis />
    <Statistics />
    <MarqueeCta />
  </main>
  <Footer />
</BaseLayout>
