---
/* /vakanzkostenrechner — Rechner und SEO-Landingpage zum
   Meistermagnet-System.

   Aufbau nach der Build-Spec:
     1. Kopf       H1 und drei Sätze, dann sofort der Rechner
     2. Rechner    rechnet im Browser, ohne Übertragung und ohne Lead-Gate
     3. Die Lücken was die Zahl nicht zeigt
     4. FAQ        mit FAQPage-Auszeichnung
     5. Abschluss

   Die Sektion mit der offengelegten Formel ist auf Wunsch von Iwo raus.
   Die Annahmen bleiben trotzdem einsehbar: Verrechnungssatz, produktive
   Stunden und Deckungsbeitrag stehen als Regler im Rechner selbst, die
   Sonderfälle als Hinweistexte daneben und in der FAQ.

   ┌──────────────────────────────────────────────────────────────────┐
   │  Solange WERTE_BESTAETIGT in src/data/vakanzkostenrechner.ts auf  │
   │  false steht, trägt die Seite noindex. Die Gewerk-Presets sind    │
   │  Platzhalter aus der Spec und von Iwo noch nicht bestätigt; ein   │
   │  Rechner mit falschen Branchenwerten schadet mehr als keiner.     │
   │  Nach der Freigabe: Konstante auf true setzen und den Footer-     │
   │  Eintrag in src/data/navigation.ts entgrauen.                     │
   └──────────────────────────────────────────────────────────────────┘ */
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import RechnerKopf from '../components/sections/rechner/RechnerKopf.astro';
import Rechner from '../components/sections/rechner/Rechner.astro';
import WasFehlt from '../components/sections/rechner/WasFehlt.astro';
import FaqLeistung from '../components/sections/leistung/FaqLeistung.astro';
import Abschluss from '../components/sections/leistung/Abschluss.astro';
import type { Feld } from '../components/Web3Formular.astro';
import { faqs, abschluss, WERTE_BESTAETIGT } from '../data/vakanzkostenrechner';

const anfrageFelder: Feld[] = [
  { name: 'name', label: 'Name', pflicht: true, breit: true, autocomplete: 'name' },
  {
    name: 'telefon',
    label: 'Telefonnummer',
    type: 'tel',
    pflicht: true,
    breit: true,
    autocomplete: 'tel',
  },
  { name: 'betrieb', label: 'Betrieb', breit: true, autocomplete: 'organization' },
  { name: 'stelle', label: 'Welche Stelle ist offen?', breit: true },
  { name: 'nachricht', label: 'Worum es geht', mehrzeilig: true },
];

/* FAQ als strukturierte Daten — die Fragen stehen wortgleich sichtbar auf
   der Seite, sonst wäre die Auszeichnung regelwidrig. */
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.frage,
    acceptedAnswer: { '@type': 'Answer', text: f.antwort },
  })),
};

/* Der Rechner ist eine Anwendung, keine Textseite. Die Auszeichnung
   erlaubt Google, ihn als Werkzeug auszuweisen. */
const anwendungJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Vakanzkosten-Rechner für Handwerksbetriebe',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Alle — läuft im Browser',
  url: 'https://stolz-marketing.de/vakanzkostenrechner',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  provider: { '@id': 'https://stolz-marketing.de/#organisation' },
};
---

<BaseLayout
  title="Vakanzkosten-Rechner Handwerk — was eine offene Stelle wirklich kostet"
  description="Rechnen Sie aus, was Sie eine unbesetzte Stelle pro Tag kostet. Für Handwerksbetriebe, mit Werten aus Ihrem Gewerk. Konservativ gerechnet, jeder Wert überschreibbar."
  noindex={!WERTE_BESTAETIGT}
>
  <RechnerKopf />

  <main id="rechner-ergebnis">
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(anwendungJsonLd)} />

    <Rechner />

    <WasFehlt />

    <FaqLeistung eintraege={faqs} id="faq-vakanzkosten" />

    <Abschluss
      titelVorn={abschluss.titelVorn}
      titelMarker={abschluss.titelMarker}
      titelMitte={abschluss.titelMitte}
      titelKursiv={abschluss.titelKursiv}
      titelHinten={abschluss.titelHinten}
      lead={abschluss.lead}
      felder={anfrageFelder}
      betreff="Anfrage über den Vakanzkostenrechner"
      ortZeile="Bergstraße und Odenwald"
    />
  </main>

  <Footer />
</BaseLayout>
