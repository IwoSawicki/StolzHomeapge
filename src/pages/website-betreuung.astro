---
// /website-betreuung — Angebotsseite für Bestandskunden (2 Betreuungs-
// Pakete, monatlich/jährlich umschaltbar). Wird Kunden direkt als Link
// geschickt → noindex, nicht in der Sitemap, nicht in der Navigation.
// Design: STOLZ-CI (Pill, Blau, Karten mit Negativ-Rundungs-Ecke) statt
// generischem SaaS-Look.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionLabel from '../components/SectionLabel.astro';

const pakete = [
  {
    key: 'basis',
    name: 'Basis',
    titel: 'Für Selbstständige, die selbst pflegen',
    beschreibung: 'Ihre Seite ist sicher gehostet und immer online — Inhalte pflegen Sie selbst.',
    preisMonat: 25,
    preisJahr: 240,
    beliebt: false,
    ctaText: 'Basis auswählen',
    ctaHref: 'mailto:iwo@stolz-marketing.de?subject=Website-Betreuung%20Basis',
    inklTitel: 'Enthalten',
    punkte: [
      'Hosting auf schneller, sicherer Infrastruktur',
      'SSL-Zertifikat & Domain-Anbindung',
      'Tägliche automatische Backups',
      'Sicherheits-Updates & Uptime-Monitoring',
      'E-Mail-Support bei technischen Fragen',
    ],
  },
  {
    key: 'komplett',
    name: 'Rundum-sorglos',
    titel: 'Sie melden sich — wir kümmern uns',
    beschreibung: 'Alles aus Basis, plus laufende Änderungen und ein persönlicher Ansprechpartner.',
    preisMonat: 80,
    preisJahr: 800,
    beliebt: true,
    ctaText: 'Rundum-sorglos auswählen',
    ctaHref: 'mailto:iwo@stolz-marketing.de?subject=Website-Betreuung%20Rundum-sorglos',
    inklTitel: 'Alles aus Basis, plus',
    punkte: [
      'Inhaltliche Änderungen auf Zuruf — kleinere Anpassungen inklusive',
      'Persönlicher Ansprechpartner, Reaktion innerhalb 24 h',
      'Quartalsweiser Website-Check inkl. Verbesserungsideen',
      'Impressum & Datenschutz regelmäßig auf aktuellem Stand',
      'Priorität bei allen Anfragen',
      'Keine Stundenabrechnung für Kleinigkeiten',
    ],
  },
];
---

<BaseLayout
  title="Website-Betreuung | STOLZ Marketing"
  description="Hosting, Sicherheit und ein persönlicher Ansprechpartner — Website-Betreuung zum Festpreis von STOLZ Marketing."
  noindex
>
  <Header />
  <main>
    <section class="px-5 pt-14 pb-20 md:px-10 md:pt-20 md:pb-28">
      <div class="mx-auto max-w-[960px]">
        <!-- Kopf -->
        <div class="flex flex-col items-center text-center">
          <SectionLabel text="Website-Betreuung" />
          <h1 class="mt-2 max-w-[640px] text-4xl font-bold text-balance leading-[1.05] tracking-[-0.06em] text-dark md:text-40 xl:text-5xl">
            Ihre Website. Sorglos betreut.
          </h1>
          <p class="mt-3 max-w-[560px] text-lg font-medium text-balance leading-[1.4] tracking-[-0.01em] text-dark/70">
            Hosting, Sicherheit und ein persönlicher Ansprechpartner — damit Ihre Seite läuft und Sie sich
            um Ihr Geschäft kümmern.
          </p>
        </div>

        <!-- Abrechnungs-Umschalter -->
        <div class="mt-10 flex flex-wrap items-center justify-center gap-3" data-abrechnung>
          <div class="flex rounded-full border border-border bg-bg-soft p-1">
            <button
              type="button"
              data-zeitraum="monat"
              aria-pressed="true"
              class="rounded-full px-5 py-2 text-sm font-semibold text-dark transition-colors duration-200 aria-pressed:bg-dark aria-pressed:text-white"
            >
              Monatlich
            </button>
            <button
              type="button"
              data-zeitraum="jahr"
              aria-pressed="false"
              class="rounded-full px-5 py-2 text-sm font-semibold text-dark transition-colors duration-200 aria-pressed:bg-dark aria-pressed:text-white"
            >
              Jährlich
            </button>
          </div>
          <span class="rounded-full bg-blue/10 px-3.5 py-1.5 text-xs font-semibold text-blue">2 Monate gratis</span>
        </div>

        <!-- Pakete -->
        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
          {
            pakete.map((paket) => (
              <div
                class:list={[
                  'relative flex flex-col rounded-[28px] p-7 md:p-8',
                  paket.beliebt ? 'bg-bg-blue-light' : 'border border-border bg-white shadow-card-soft',
                ]}
              >
                {paket.beliebt && (
                  <div class="paket-notch absolute top-0 right-0 rounded-bl-[18px] bg-white pb-2 pl-2">
                    <span class="inline-block rounded-full bg-blue px-3.5 py-1.5 text-xs font-semibold text-white">
                      Beliebt
                    </span>
                  </div>
                )}

                <p class="text-xs font-semibold tracking-[0.14em] text-blue uppercase">{paket.name}</p>
                <h2 class="mt-2 text-2xl font-semibold tracking-[-0.02em] text-dark">{paket.titel}</h2>
                <p class="mt-2 min-h-[44px] text-base font-medium leading-[1.5] text-dark/60">{paket.beschreibung}</p>

                <div class="mt-6 flex items-baseline gap-2">
                  <span
                    class="text-52 font-semibold tracking-[-0.03em] text-dark tabular-nums"
                    data-preis={paket.key}
                    data-monat={paket.preisMonat}
                    data-jahr={paket.preisJahr}
                  >
                    {paket.preisMonat}&nbsp;€
                  </span>
                  <span class="text-base font-semibold text-dark/50" data-einheit={paket.key}>/ Monat</span>
                </div>
                <p class="mt-1 min-h-[20px] text-sm font-medium text-dark/50" data-unterzeile={paket.key}>
                  oder {paket.preisJahr} € / Jahr
                </p>
                <p class="mt-1 text-xs font-medium text-dark/40">Preise netto, zzgl. 19 % MwSt.</p>

                <a
                  href={paket.ctaHref}
                  class:list={[
                    'mt-7 inline-flex items-center justify-center rounded-full px-[30px] py-3 text-base font-medium tracking-[-0.02em] transition-colors duration-200',
                    paket.beliebt
                      ? 'bg-blue text-white-soft shadow-blue-glow hover:bg-blue-bright'
                      : 'border border-border-dark bg-transparent text-dark hover:bg-bg-soft',
                  ]}
                >
                  {paket.ctaText}
                </a>

                <p class="mt-7 text-xs font-semibold tracking-[0.14em] text-dark/40 uppercase">{paket.inklTitel}</p>
                <ul class="mt-4 flex flex-col gap-3">
                  {paket.punkte.map((punkt) => (
                    <li class="flex items-start gap-3 text-15 font-medium text-dark/80">
                      <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-blue/10 text-blue">
                        <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="m5 13 4 4L19 7" />
                        </svg>
                      </span>
                      {punkt}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <!-- Preis-Anker -->
        <p class="mx-auto mt-12 max-w-[640px] text-center text-base font-medium leading-[1.6] text-dark/60">
          Zum Vergleich: Ein Agentur-Retainer startet bei{' '}
          <strong class="font-semibold text-dark">150–300&nbsp;€/Monat</strong>, ein Freelancer berechnet{' '}
          <strong class="font-semibold text-dark">60–90&nbsp;€ pro Stunde</strong>. Rundum-sorglos deckt
          all das zum Festpreis ab — ohne dass Sie jedes Mal nachfragen müssen, was es kostet.
        </p>

        <p class="mt-8 text-center text-sm font-medium leading-[1.7] text-dark/50">
          Abrechnung bequem per SEPA-Lastschrift · monatlich bzw. jährlich kündbar<br />
          STOLZ Marketing · <a href="mailto:iwo@stolz-marketing.de" class="text-blue hover:text-blue-bright">iwo@stolz-marketing.de</a>
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Negativ-Rundungen an der „Beliebt"-Ecke (wie die Kategorie-Pills im
     Projekt-Grid): zwei Quadrate, deren Radial-Gradient die konkave
     Kurve in Seiten-Weiß zeichnet. */
  .paket-notch::before,
  .paket-notch::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    background: radial-gradient(circle at 0 100%, transparent 18px, var(--color-white) 18px);
  }
  .paket-notch::before {
    top: 0;
    left: -18px;
  }
  .paket-notch::after {
    top: 100%;
    right: 0;
  }
</style>

<script>
  // Monatlich/Jährlich umschalten: Preise + Unterzeilen aktualisieren.
  const schalter = document.querySelectorAll<HTMLButtonElement>('[data-zeitraum]');
  const euro = (n: number) => `${n.toLocaleString('de-DE')} €`;

  function setze(zeitraum: 'monat' | 'jahr') {
    schalter.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.zeitraum === zeitraum)));
    document.querySelectorAll<HTMLElement>('[data-preis]').forEach((el) => {
      const key = el.dataset.preis!;
      const monat = Number(el.dataset.monat);
      const jahr = Number(el.dataset.jahr);
      const einheit = document.querySelector<HTMLElement>(`[data-einheit="${key}"]`);
      const unterzeile = document.querySelector<HTMLElement>(`[data-unterzeile="${key}"]`);
      if (zeitraum === 'monat') {
        el.textContent = euro(monat);
        if (einheit) einheit.textContent = '/ Monat';
        if (unterzeile) unterzeile.textContent = `oder ${euro(jahr)} / Jahr`;
      } else {
        el.textContent = euro(jahr);
        if (einheit) einheit.textContent = '/ Jahr';
        if (unterzeile) unterzeile.textContent = `entspricht ${euro(Math.round(jahr / 12))} / Monat — 2 Monate gratis`;
      }
    });
  }

  schalter.forEach((b) => b.addEventListener('click', () => setze(b.dataset.zeitraum as 'monat' | 'jahr')));
</script>
