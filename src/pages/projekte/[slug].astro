---
// Projekt-Unterseite /projekte/[slug] — Inhalte kommen komplett aus
// src/data/projekte.ts (dort befüllen, XX = Platzhalter).
//
// Aufbau (inspiriert von madebyshape.co.uk/work/, bewusst simpler):
// 1. Kopf: Zurück-Link, Kategorie-Pills, Name, Einleitung + Keyfacts
// 2. Medien: Website → großes Browser-Mockup / Video → Dreh-Kacheln
// 3. „Was wir umgesetzt haben": Bild links, große Bullet-Points rechts
// 4. nur Website: Seitenstruktur (Sitemap-Karten)
// 5. Ergebnisse: Zahlen-Karten + CTA
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BrowserMockup from '../../components/BrowserMockup.astro';
import VideoTile from '../../components/VideoTile.astro';
import Button from '../../components/Button.astro';
import SeoStadtSitemap from '../../components/SeoStadtSitemap.astro';
import { projekte } from '../../data/projekte';

export function getStaticPaths() {
  // Unterseiten nur für fertig befüllte Projekte
  return projekte
    .filter((projekt) => projekt.bereit && projekt.details)
    .map((projekt) => ({ params: { slug: projekt.slug }, props: { projekt } }));
}

const { projekt } = Astro.props;
const details = projekt.details!;
const istWebsite = projekt.art === 'website';
// Dreh-Kacheln: echte Dreh-Bilder, sonst Still als Platzhalter (3 Kacheln)
const drehKacheln = istWebsite ? [] : (details.drehbilder ?? [projekt.bild, projekt.bild, projekt.bild]);
// „XX"-Platzhalter herausfiltern, bis echte Werte hinterlegt sind
const keyfacts = details.keyfacts.filter((f) => !f.wert.includes('XX'));
const ergebnisse = details.ergebnisse.filter((e) => !e.wert.includes('XX'));
// Live-Link für den mitscrollenden Button (explizit oder aus domain)
const liveUrl = details.liveUrl ?? (projekt.domain ? `https://${projekt.domain}` : null);
// Meta-Description: Einleitung ohne **Marker, auf ~160 Zeichen (Wortgrenze) gekürzt
const rohDesc = details.einleitung.replace(/\*\*/g, '');
const metaDescription = rohDesc.length > 160 ? `${rohDesc.slice(0, 157).replace(/\s+\S*$/, '')}…` : rohDesc;
// Hervorhebung: **Wort** in der Einleitung wird blau (eine Auszeichnung,
// bewusst nicht gemischt — passt zum Über-uns-Statement der Startseite)
const hebeHervor = (text: string) => text.replace(/\*\*(.+?)\*\*/g, '<span class="text-blue">$1</span>');
---

<BaseLayout
  title={`${projekt.name} | Projekte | STOLZ Marketing`}
  description={metaDescription}
>
  <Header />
  <main>
    <!-- 1. Kopf: Pills, Name, Einleitung, Keyfacts (4 nebeneinander) -->
    <section class="px-5 pt-14 md:px-10 md:pt-20">
      <div class="mx-auto max-w-[1200px]">
        <a href="/projekte" class="group inline-flex items-center gap-2 text-sm font-medium text-gray transition-colors duration-200 hover:text-dark">
          <svg class="size-4 transition-transform duration-200 group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M11 18l-6-6 6-6"></path>
          </svg>
          Alle Projekte
        </a>

        <div class="mt-8 flex flex-wrap gap-1.5">
          {
            projekt.kategorien.map((kategorie) => (
              <span class="rounded-full bg-bg-soft px-3.5 py-1.5 text-xs font-semibold text-dark">{kategorie}</span>
            ))
          }
        </div>
        <h1 class="mt-4 max-w-[720px] text-4xl font-semibold text-balance leading-[1.05] tracking-[-0.03em] text-dark md:text-5xl">
          {projekt.name}
        </h1>
        <p
          class="mt-5 max-w-[640px] text-lg font-medium leading-[1.5] tracking-[-0.01em] text-dark"
          set:html={hebeHervor(details.einleitung)}
        />

        <!-- Direktlink zur Website des Kunden (sichtbar im Fließtext) -->
        {
          liveUrl && (
            <p class="mt-5">
              <a
                href={liveUrl}
                target="_blank"
                rel="noopener"
                class="group inline-flex items-center gap-2 text-base font-semibold text-blue transition-colors duration-200 hover:text-blue-bright"
              >
                {liveUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                <svg
                  class="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M7 17 17 7M8 7h9v9" />
                </svg>
              </a>
            </p>
          )
        }

        <!-- Keyfacts (XX-Platzhalter herausgefiltert) -->
        {
          keyfacts.length > 0 && (
            <dl class="mt-10 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-border pt-8 md:grid-cols-4">
              {keyfacts.map((fakt) => (
                <div>
                  <dt class="text-xs font-semibold tracking-[0.14em] text-gray uppercase">{fakt.label}</dt>
                  <dd class="mt-1.5 text-base font-semibold text-dark">{fakt.wert}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </section>

    <!-- 2. Medien: großes Mockup bzw. Video-/Dreh-Kacheln -->
    <section class="px-5 pt-12 md:px-10 md:pt-16">
      <div class="mx-auto max-w-[1200px]">
        {
          istWebsite ? (
            <div class="aspect-[16/10] overflow-hidden rounded-24 md:aspect-[16/9]">
              <BrowserMockup
              domain={projekt.domain}
              bild={projekt.bild}
              alt={`Website von ${projekt.name}`}
              widths={[768, 1200, 1600]}
              sizes="(min-width:1200px) 1200px, 100vw"
              vorrang
            />
            </div>
          ) : details.videos ? (
            <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
              {details.videos.map((video) => (
                <button
                  type="button"
                  class="group relative aspect-[9/16] cursor-pointer overflow-hidden rounded-24 bg-dark"
                  data-video-open
                  data-video-src={video}
                  aria-label={`Clip für ${projekt.name} mit Ton abspielen`}
                >
                  <video
                    class="h-full w-full object-cover"
                    src={video}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    tabindex="-1"
                    aria-hidden="true"
                  />
                  <span class="absolute inset-0 bg-dark/0 transition-colors duration-200 group-hover:bg-dark/20"></span>
                  <span class="absolute bottom-3 left-3 flex size-11 items-center justify-center rounded-full bg-white/90 text-dark shadow-card-soft backdrop-blur-sm transition-transform duration-200 group-hover:scale-105">
                    <svg class="ml-0.5 size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                </button>
              ))}
            </div>
          ) : (
            <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
              {drehKacheln.map((bild, i) => (
                <div class:list={['overflow-hidden rounded-24', i === 0 ? 'aspect-[4/3] md:aspect-[9/14]' : 'hidden aspect-[9/14] md:block']}>
                  <VideoTile bild={bild} alt={`Einblick in den Dreh bei ${projekt.name}`} />
                </div>
              ))}
            </div>
          )
        }
        {
          import.meta.env.DEV &&
          ((istWebsite && !projekt.bild) || (!istWebsite && !details.drehbilder && !details.videos)) && (
            <p class="mt-3 text-sm font-medium text-gray">
              {istWebsite ? 'Platzhalter — echter Website-Screenshot folgt.' : 'Platzhalter — echte Bilder vom Dreh folgen.'}
            </p>
          )
        }
      </div>
    </section>

    <!-- 2b. Feature-Checkliste „Was die Seite kann" -->
    {
      details.webFeatures && (
        <section class="px-5 pt-16 md:px-10 md:pt-24">
          <div class="mx-auto max-w-[1200px]">
            <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Umfang</p>
            <h2 class="mt-3 text-3xl font-semibold text-balance tracking-[-0.02em] text-dark md:text-4xl">
              Was die Seite kann
            </h2>
            <ul class="mt-8 grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2 md:grid-cols-3">
              {details.webFeatures.map((feature) => (
                <li class="flex items-start gap-3 border-t border-border pt-4 text-base font-medium text-dark">
                  <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-blue/10 text-blue">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m5 13 4 4L19 7" />
                    </svg>
                  </span>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- 3. Was wir umgesetzt haben: Bild links, Bullet-Points rechts -->
    <section class="px-5 pt-16 md:px-10 md:pt-24">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-10 xl:flex-row xl:items-center xl:gap-16">
        <div class="w-full shrink-0 xl:w-[480px]">
          <div class:list={['overflow-hidden rounded-24', istWebsite ? 'aspect-[4/3]' : 'aspect-[4/5]']}>
            {
              istWebsite ? (
                <BrowserMockup domain={projekt.domain} bild={projekt.bild} alt={`Ausschnitt der Website von ${projekt.name}`} chrome={false} class="border-0" />
              ) : (
                <VideoTile bild={projekt.bild} alt={`Video-Content für ${projekt.name}`} />
              )
            }
          </div>
        </div>
        <div class="flex-1">
          <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Leistungen</p>
          <h2 class="mt-3 text-3xl font-semibold text-balance tracking-[-0.02em] text-dark md:text-4xl">
            Was wir umgesetzt haben
          </h2>
          <ul class="mt-8 flex flex-col gap-6">
            {
              details.leistungen.map((punkt) => (
                <li class="flex gap-4">
                  <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-blue/10 text-blue">
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m5 13 4 4L19 7" />
                    </svg>
                  </span>
                  <div>
                    <h3 class="text-lg font-semibold tracking-[-0.01em] text-dark">{punkt.titel}</h3>
                    <p class="mt-1 text-base font-medium leading-[1.5] text-dark/60">{punkt.text}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- 3a. Qualifizierung (Recruiting-Projekte mit Vorqualifizierung) -->
    {
      details.qualifizierung && (
        <section class="px-5 pt-16 md:px-10 md:pt-24">
          <div class="mx-auto max-w-[1200px]">
            <div class="grid gap-8 rounded-24 bg-bg-blue-light p-6 md:grid-cols-2 md:gap-14 md:p-12">
              <div>
                <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Qualifizierung</p>
                <h2 class="mt-3 text-2xl font-semibold text-balance tracking-[-0.02em] text-dark md:text-3xl">
                  {details.qualifizierung.titel}
                </h2>
                <p class="mt-4 text-base font-medium leading-[1.6] text-dark/70">
                  {details.qualifizierung.text}
                </p>
              </div>
              <div class="md:self-center">
                <p class="text-sm font-semibold text-dark">Diese Kriterien wurden vorab geprüft:</p>
                <ul class="mt-4 flex flex-col gap-3">
                  {details.qualifizierung.kriterien.map((kriterium) => (
                    <li class="flex items-center gap-3 rounded-14 bg-white px-4 py-3 text-base font-medium text-dark shadow-card-soft">
                      <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-blue text-white">
                        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="m5 13 4 4L19 7" />
                        </svg>
                      </span>
                      {kriterium}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <!-- 3b. Seitenstruktur — visuelle SEO-Sitemap bevorzugt -->
    {
      istWebsite && details.stadtStruktur ? (
        <section class="px-5 pt-16 md:px-10 md:pt-24">
          <div class="mx-auto max-w-[1200px]">
            <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Struktur & lokales SEO</p>
            <h2 class="mt-3 max-w-[720px] text-3xl font-semibold text-balance tracking-[-0.02em] text-dark md:text-4xl">
              Eine Seite für jede Stadt
            </h2>
            <p class="mt-4 max-w-[620px] text-lg font-medium leading-[1.5] text-dark/60">
              Damit HEPA nicht nur in Weinheim, sondern in jeder Stadt der Region gefunden wird, haben wir die
              Struktur konsequent lokal gedacht.
            </p>
            <div class="mt-10">
              <SeoStadtSitemap struktur={details.stadtStruktur} />
            </div>
          </div>
        </section>
      ) : istWebsite && details.sitemap ? (
        <section class="px-5 pt-16 md:px-10 md:pt-24">
          <div class="mx-auto max-w-[1200px]">
            <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Struktur</p>
            <h2 class="mt-3 text-3xl font-semibold text-balance tracking-[-0.02em] text-dark md:text-4xl">
              Die neue Seitenstruktur
            </h2>
            <div class="mt-8 flex flex-wrap gap-3">
              {details.sitemap.map((seite, i) => (
                <span class:list={[
                  'rounded-14 border px-5 py-3.5 text-base font-semibold tracking-[-0.01em]',
                  i === 0 ? 'border-blue bg-blue text-white' : 'border-border bg-white text-dark',
                ]}>
                  {seite}
                </span>
              ))}
            </div>
            <p class="mt-4 max-w-[560px] text-base font-medium leading-[1.5] text-dark/60">
              Jede Seite hat eine Aufgabe — vom ersten Eindruck bis zur Anfrage. Keine Sackgassen, keine
              Platzhalter-Seiten.
            </p>
          </div>
        </section>
      ) : null
    }

    <!-- 3c. Die Leistungen im Detail (nur wenn hinterlegt) -->
    {
      details.leistungsseiten && (
        <section class="px-5 pt-16 md:px-10 md:pt-24">
          <div class="mx-auto max-w-[1200px]">
            <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Leistungen</p>
            <h2 class="mt-3 max-w-[720px] text-3xl font-semibold text-balance tracking-[-0.02em] text-dark md:text-4xl">
              Drei Leistungen, ein Auftritt
            </h2>
            <p class="mt-4 max-w-[620px] text-lg font-medium leading-[1.5] text-dark/60">
              Jede Leistung hat ihre eigene Startseite mit passendem Aufbau — und darunter jeweils rund 150
              lokale Städte-Seiten.
            </p>

            <div class="mt-14 flex flex-col gap-16 md:gap-24">
              {details.leistungsseiten.map((seite, i) => (
                <div class={`grid items-center gap-8 md:grid-cols-2 md:gap-14 ${i % 2 === 1 ? 'md:[&>figure]:order-2' : ''}`}>
                  <figure class="group relative overflow-hidden rounded-24 border border-border bg-white shadow-card-soft transition-shadow duration-200 hover:shadow-card">
                    <div class="flex items-center gap-2 border-b border-border bg-bg-soft px-4 py-3">
                      <span class="size-2.5 rounded-full bg-border-gray" aria-hidden="true" />
                      <span class="size-2.5 rounded-full bg-border-gray" aria-hidden="true" />
                      <span class="size-2.5 rounded-full bg-border-gray" aria-hidden="true" />
                      <span class="ml-2 truncate text-xs font-medium text-gray">
                        {seite.url ? seite.url.replace(/^https?:\/\//, '').replace(/\/$/, '') : `${projekt.domain}/${seite.name.toLowerCase()}`}
                      </span>
                    </div>
                    <div class="aspect-[16/10] w-full bg-bg-blue-light">
                      {seite.bild ? (
                        <Image src={seite.bild} alt={`Screenshot der ${seite.name}-Seite von ${projekt.name}`} class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]" widths={[520, 900]} sizes="(min-width:810px) 560px, 100vw" />
                      ) : (
                        <div class="flex h-full w-full flex-col items-center justify-center gap-2 text-center">
                          <span class="font-display text-2xl font-extrabold text-blue/70">{seite.name}</span>
                          <span class="text-xs font-medium text-gray">Screenshot folgt</span>
                        </div>
                      )}
                    </div>
                    {seite.url && (
                      <a
                        href={seite.url}
                        target="_blank"
                        rel="noopener"
                        class="absolute inset-0"
                        aria-label={`${seite.name}-Seite von ${projekt.name} live ansehen`}
                      />
                    )}
                  </figure>

                  <div>
                    <h3 class="text-2xl font-semibold tracking-[-0.02em] text-dark md:text-3xl">{seite.name}</h3>
                    <p class="mt-3 text-base font-medium leading-[1.55] text-dark/60">{seite.beschreibung}</p>
                    <ul class="mt-6 flex flex-col gap-3">
                      {seite.punkte.map((punkt) => (
                        <li class="flex items-start gap-3 text-base font-medium text-dark">
                          <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-blue/10 text-blue">
                            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="m5 13 4 4L19 7" />
                            </svg>
                          </span>
                          {punkt}
                        </li>
                      ))}
                    </ul>

                    {seite.highlight && (
                      <div class="mt-7 rounded-20 border border-blue/20 bg-bg-blue-light p-5">
                        <p class="text-sm font-semibold text-dark">{seite.highlight.titel}</p>
                        <ol class="mt-4 flex flex-col gap-2.5">
                          {seite.highlight.schritte.map((schritt, s) => (
                            <li class="flex items-center gap-3 text-base font-medium text-dark">
                              <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-blue text-sm font-semibold text-white tabular-nums">
                                {s + 1}
                              </span>
                              {schritt}
                            </li>
                          ))}
                        </ol>
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }


    <!-- 4a. Screenshot-Galerie (Zielseiten, Module — nur wenn hinterlegt) -->
    {
      details.galerie && (
        <section class="px-5 pt-16 md:px-10 md:pt-24">
          <div class="mx-auto max-w-[1200px]">
            <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Zielseiten</p>
            <h2 class="mt-3 max-w-[720px] text-3xl font-semibold text-balance tracking-[-0.02em] text-dark md:text-4xl">
              {details.galerieTitel ?? 'Wohin die Kampagnen führen'}
            </h2>

            <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-6">
              {details.galerie.map((eintrag) => (
                <figure>
                  <div class="overflow-hidden rounded-20 border border-border bg-white shadow-card-soft">
                    <div class="flex items-center gap-1.5 border-b border-border bg-bg-soft px-3 py-2">
                      <span class="size-2 rounded-full bg-border-gray" aria-hidden="true" />
                      <span class="size-2 rounded-full bg-border-gray" aria-hidden="true" />
                      <span class="size-2 rounded-full bg-border-gray" aria-hidden="true" />
                    </div>
                    <Image
                      src={eintrag.bild}
                      alt={`${eintrag.titel} – ${projekt.name}`}
                      widths={[420, 840]}
                      sizes="(min-width:810px) 380px, 100vw"
                      class="aspect-[16/11] w-full object-cover object-top"
                    />
                  </div>
                  <figcaption class="mt-4">
                    <p class="text-lg font-semibold tracking-[-0.02em] text-dark">{eintrag.titel}</p>
                    <p class="mt-1.5 text-base font-medium leading-[1.5] text-dark/60">{eintrag.text}</p>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- 4b. Kundenzitat (nur wenn hinterlegt) -->
    {
      details.zitat && (
        <section class="px-5 pt-16 md:px-10 md:pt-24">
          <div class="mx-auto max-w-[900px] text-center">
            <svg class="mx-auto size-10 text-blue/30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M9.5 7C6.5 7 4 9.5 4 12.5V19h7v-7H7.5c0-1.4 1.1-2.5 2.5-2.5V7zm9 0c-3 0-5.5 2.5-5.5 5.5V19h7v-7h-3.5c0-1.4 1.1-2.5 2.5-2.5V7z" />
            </svg>
            <blockquote class="mt-6 text-2xl font-semibold text-balance leading-[1.3] tracking-[-0.02em] text-dark md:text-3xl">
              „{details.zitat.text}"
            </blockquote>
            <p class="mt-6 text-base font-semibold text-gray">— {details.zitat.autor}</p>
          </div>
        </section>
      )
    }

    <!-- 5. Ergebnisse (nur wenn echte Werte da sind) + CTA -->
    <section class="px-5 pt-16 pb-20 md:px-10 md:pt-24 md:pb-28">
      <div class="mx-auto max-w-[1200px]">
        {
          ergebnisse.length > 0 && (
            <div class="mb-14">
              <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Ergebnis</p>
              <h2 class="mt-3 text-3xl font-semibold text-balance tracking-[-0.02em] text-dark md:text-4xl">
                Das kam dabei raus
              </h2>
              <dl class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
                {ergebnisse.map((ergebnis) => (
                  <div class="rounded-24 border border-border bg-white p-7">
                    <dd class="text-40 font-semibold tracking-[-0.03em] text-dark">{ergebnis.wert}</dd>
                    <dt class="mt-1 text-base font-medium text-dark/60">{ergebnis.label}</dt>
                  </div>
                ))}
              </dl>
            </div>
          )
        }

        <div class="flex flex-col items-start gap-2.5 md:flex-row md:items-center">
          <Button href="/kontakt" variant="blue" shadow="blue-glow">Ähnliches Projekt anfragen</Button>
          <Button href="/projekte" variant="light">Weitere Projekte ansehen</Button>
        </div>
      </div>
    </section>

    <!-- Mitscrollender Live-Button (nur Website-Projekte mit Live-Link) -->
    {
      istWebsite && liveUrl && (
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener"
          class="fixed right-4 bottom-4 z-40 inline-flex items-center gap-2 rounded-full bg-blue px-5 py-3 text-sm font-semibold text-white-soft shadow-blue-glow transition-colors duration-200 hover:bg-blue-bright md:right-6 md:bottom-6 md:text-base"
        >
          <span class="relative flex size-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white opacity-60" />
            <span class="relative inline-flex size-2 rounded-full bg-white" />
          </span>
          Live-Seite ansehen
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7M8 7h9v9" />
          </svg>
        </a>
      )
    }

    <!-- Video-Lightbox: großes Popup mit Blur + Ton (wie Hero-Showreel) -->
    {
      details.videos && (
        <div
          class="fixed inset-0 z-[100] hidden items-center justify-center bg-dark/70 p-5 backdrop-blur-lg md:p-10"
          data-video-modal
          role="dialog"
          aria-modal="true"
          aria-label={`Video von ${projekt.name} in groß`}
        >
          <button
            type="button"
            data-video-close
            class="absolute top-5 right-5 flex size-11 cursor-pointer items-center justify-center rounded-full bg-white text-dark transition-transform duration-200 hover:scale-105"
            aria-label="Video schließen"
          >
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6 6 18" />
            </svg>
          </button>
          <video
            class="max-h-[85vh] w-auto max-w-full rounded-24 shadow-stack-strong"
            controls
            playsinline
            preload="none"
            data-video-el
          />
        </div>
      )
    }
  </main>
  <Footer />
</BaseLayout>

<script>
  // Klick auf eine Video-Kachel öffnet sie groß im Blur-Popup mit Ton.
  const modal = document.querySelector<HTMLElement>('[data-video-modal]');
  const el = document.querySelector<HTMLVideoElement>('[data-video-el]');
  const closeBtn = document.querySelector<HTMLElement>('[data-video-close]');
  const openers = document.querySelectorAll<HTMLElement>('[data-video-open]');

  if (modal && el && closeBtn) {
    const oeffne = (src: string) => {
      el.src = src;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      el.currentTime = 0;
      el.muted = false;
      el.volume = 1;
      void el.play();
    };
    const schliesse = () => {
      el.pause();
      el.removeAttribute('src');
      el.load();
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    };
    openers.forEach((btn) =>
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-video-src');
        if (src) oeffne(src);
      }),
    );
    closeBtn.addEventListener('click', schliesse);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) schliesse();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('flex')) schliesse();
    });
  }
</script>

