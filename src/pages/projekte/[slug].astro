---
// Projekt-Unterseite /projekte/[slug] — Inhalte kommen komplett aus
// src/data/projekte.ts (dort befüllen, XX = Platzhalter).
//
// Aufbau (inspiriert von madebyshape.co.uk/work/, bewusst simpler):
// 1. Kopf: Zurück-Link, Kategorie-Pills, Name, Einleitung + Keyfacts
// 2. Medien: Website → großes Browser-Mockup / Video → Dreh-Kacheln
// 3. „Was wir umgesetzt haben": Bild links, große Bullet-Points rechts
// 4. nur Website: Seitenstruktur (Sitemap-Karten)
// 5. Ergebnisse: Zahlen-Karten + CTA
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BrowserMockup from '../../components/BrowserMockup.astro';
import VideoTile from '../../components/VideoTile.astro';
import Button from '../../components/Button.astro';
import { projekte } from '../../data/projekte';

export function getStaticPaths() {
  // Unterseiten nur für Projekte mit hinterlegten Details
  return projekte
    .filter((projekt) => projekt.details)
    .map((projekt) => ({ params: { slug: projekt.slug }, props: { projekt } }));
}

const { projekt } = Astro.props;
const details = projekt.details!;
const istWebsite = projekt.art === 'website';
// Dreh-Kacheln: echte Dreh-Bilder, sonst Still als Platzhalter (3 Kacheln)
const drehKacheln = istWebsite ? [] : (details.drehbilder ?? [projekt.bild, projekt.bild, projekt.bild]);
---

<BaseLayout
  title={`${projekt.name} | Projekte | STOLZ Marketing`}
  description={projekt.beschreibung}
>
  <Header />
  <main>
    <!-- 1. Kopf: Pills, Name, Einleitung, Keyfacts -->
    <section class="px-5 pt-14 md:px-10 md:pt-20">
      <div class="mx-auto max-w-[1200px]">
        <a href="/projekte" class="group inline-flex items-center gap-2 text-sm font-medium text-gray transition-colors duration-200 hover:text-dark">
          <svg class="size-4 transition-transform duration-200 group-hover:-translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M11 18l-6-6 6-6"></path>
          </svg>
          Alle Projekte
        </a>

        <div class="mt-8 flex flex-wrap gap-1.5">
          {
            projekt.kategorien.map((kategorie) => (
              <span class="rounded-full bg-bg-soft px-3.5 py-1.5 text-xs font-semibold text-dark">{kategorie}</span>
            ))
          }
        </div>
        <h1 class="mt-4 max-w-[720px] text-4xl font-semibold text-balance leading-[1.05] tracking-[-0.03em] text-dark md:text-5xl">
          {projekt.name}
        </h1>
        <p class="mt-5 max-w-[640px] text-lg font-medium leading-[1.5] tracking-[-0.01em] text-dark">
          {details.einleitung}
        </p>

        <!-- Keyfacts -->
        <dl class="mt-10 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-border pt-8 md:grid-cols-4">
          {
            details.keyfacts.map((fakt) => (
              <div>
                <dt class="text-xs font-semibold tracking-[0.14em] text-gray uppercase">{fakt.label}</dt>
                <dd class="mt-1.5 text-base font-semibold text-dark">{fakt.wert}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- 2. Medien: großes Mockup bzw. Dreh-Kacheln -->
    <section class="px-5 pt-12 md:px-10 md:pt-16">
      <div class="mx-auto max-w-[1200px]">
        {
          istWebsite ? (
            <div class="aspect-[16/10] overflow-hidden rounded-24 md:aspect-[16/9]">
              <BrowserMockup domain={projekt.domain} bild={projekt.bild} alt={`Website von ${projekt.name}`} />
            </div>
          ) : (
            <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
              {drehKacheln.map((bild, i) => (
                <div class:list={['overflow-hidden rounded-24', i === 0 ? 'aspect-[4/3] md:aspect-[9/14]' : 'hidden aspect-[9/14] md:block']}>
                  <VideoTile bild={bild} alt={`Einblick in den Dreh bei ${projekt.name}`} />
                </div>
              ))}
            </div>
          )
        }
        {
          /* Hinweis nur, solange noch kein echtes Material hinterlegt ist */
          ((istWebsite && !projekt.bild) || (!istWebsite && !details.drehbilder)) && (
            <p class="mt-3 text-sm font-medium text-gray">
              {istWebsite
                ? 'Platzhalter — echter Website-Screenshot folgt.'
                : 'Platzhalter — echte Bilder vom Dreh folgen.'}
            </p>
          )
        }
      </div>
    </section>

    <!-- 3. Was wir umgesetzt haben: Bild links, Bullet-Points rechts -->
    <section class="px-5 pt-16 md:px-10 md:pt-24">
      <div class="mx-auto flex max-w-[1200px] flex-col gap-10 xl:flex-row xl:items-center xl:gap-16">
        <div class="w-full shrink-0 xl:w-[480px]">
          <div class:list={['overflow-hidden rounded-24', istWebsite ? 'aspect-[4/3]' : 'aspect-[4/5]']}>
            {
              istWebsite ? (
                <BrowserMockup domain={projekt.domain} bild={projekt.bild} alt={`Ausschnitt der Website von ${projekt.name}`} chrome={false} class="border-0" />
              ) : (
                <VideoTile bild={projekt.bild} alt={`Video-Content für ${projekt.name}`} />
              )
            }
          </div>
        </div>
        <div class="flex-1">
          <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Leistungen</p>
          <h2 class="mt-3 text-3xl font-semibold text-balance tracking-[-0.02em] text-dark md:text-4xl">
            Was wir umgesetzt haben
          </h2>
          <ul class="mt-8 flex flex-col gap-6">
            {
              details.leistungen.map((punkt) => (
                <li class="flex gap-4">
                  <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-blue/10 text-blue">
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m5 13 4 4L19 7" />
                    </svg>
                  </span>
                  <div>
                    <h3 class="text-lg font-semibold tracking-[-0.01em] text-dark">{punkt.titel}</h3>
                    <p class="mt-1 text-base font-medium leading-[1.5] text-dark/60">{punkt.text}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- 4. nur Websites: Seitenstruktur -->
    {
      istWebsite && details.sitemap && (
        <section class="px-5 pt-16 md:px-10 md:pt-24">
          <div class="mx-auto max-w-[1200px]">
            <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Struktur</p>
            <h2 class="mt-3 text-3xl font-semibold text-balance tracking-[-0.02em] text-dark md:text-4xl">
              Die neue Seitenstruktur
            </h2>
            <div class="mt-8 flex flex-wrap gap-3">
              {details.sitemap.map((seite, i) => (
                <span class:list={[
                  'rounded-14 border px-5 py-3.5 text-base font-semibold tracking-[-0.01em]',
                  i === 0 ? 'border-blue bg-blue text-white' : 'border-border bg-white text-dark',
                ]}>
                  {seite}
                </span>
              ))}
            </div>
            <p class="mt-4 max-w-[560px] text-base font-medium leading-[1.5] text-dark/60">
              Jede Seite hat eine Aufgabe — vom ersten Eindruck bis zur Anfrage. Keine Sackgassen, keine
              Platzhalter-Seiten.
            </p>
          </div>
        </section>
      )
    }

    <!-- 5. Ergebnisse + CTA -->
    <section class="px-5 pt-16 pb-20 md:px-10 md:pt-24 md:pb-28">
      <div class="mx-auto max-w-[1200px]">
        <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Ergebnis</p>
        <h2 class="mt-3 text-3xl font-semibold text-balance tracking-[-0.02em] text-dark md:text-4xl">
          Das kam dabei raus
        </h2>
        <dl class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-3">
          {
            details.ergebnisse.map((ergebnis) => (
              <div class="rounded-24 border border-border bg-white p-7">
                <dd class="text-40 font-semibold tracking-[-0.03em] text-dark">{ergebnis.wert}</dd>
                <dt class="mt-1 text-base font-medium text-dark/60">{ergebnis.label}</dt>
              </div>
            ))
          }
        </dl>

        <div class="mt-14 flex flex-col items-start gap-2.5 md:flex-row md:items-center">
          <Button href="/kontakt" variant="blue" shadow="blue-glow">Ähnliches Projekt anfragen</Button>
          <Button href="/projekte" variant="light">Weitere Projekte ansehen</Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
