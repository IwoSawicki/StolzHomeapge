---
/* /korbaktion — Landingpage hinter dem QR-Code auf dem Flyer der
   Door-to-Door-Aktion.

   Diese Adresse steht gedruckt und lässt sich nicht mehr ändern. Sie war
   bis vor kurzem eine reine Weiterleitung auf die Startseite; jetzt ist
   sie die Seite, auf der der Lead landet.

   Wer hier ankommt, hat ein Brötchenkörbchen bekommen, den Flyer
   umgedreht und den Code gescannt — und in der Regel vorher mit Iwo an
   der Tür gesprochen. Deshalb kommt direkt nach dem Hero die Begrüßung
   und nicht ein Formular: die Person kennt bereits ein Gesicht.

     1. Hero             wie auf den Leistungsseiten, Bild rechts
     2. Hallo, ich bin Iwo   das Gesicht von heute Morgen
     3. Der Check        was drinsteht, und dass es nichts kostet
     4. Die Aktion       warum jemand mit einem Körbchen vorbeikommt
     5. Leistungen       die beiden Systeme, bebildert wie auf der Startseite
     6. Abschluss        das einzige Formular der Seite

   Die Seite trägt seit dem Umbau die normale Kopfzeile: sie steckt in
   HeroLeistung mit drin. Das ist der Preis für diese Hero — wer vom
   Flyer kommt, hat damit auch ein Menü.

   noindex und nicht in der Sitemap (Filter in astro.config.mjs): die Seite
   ist das Ziel einer Kampagne, kein organischer Einstieg. Sie träte sonst
   gegen die Startseite an, die auf dieselben Begriffe optimiert ist. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import HeroLeistung from '../components/sections/HeroLeistung.astro';
import heroBild from '../assets/leistungen/kundengewinnung.JPG';
import Ansprechpartner from '../components/sections/webdesign/Ansprechpartner.astro';
import CheckInhalt from '../components/sections/korbaktion/CheckInhalt.astro';
import WarumKoerbchen from '../components/sections/korbaktion/WarumKoerbchen.astro';
import Leistungen from '../components/sections/Leistungen.astro';
import Abschluss from '../components/sections/leistung/Abschluss.astro';
import type { Feld } from '../components/Web3Formular.astro';
import { hero, ansprechpartner, abschluss } from '../data/korbaktion';

/* Das Adressfeld steht bewusst obenan und ist nicht Pflicht: Wer gar
   keine Webseite hat, ist genau der Betrieb, den wir sprechen wollen —
   ein Pflichtfeld würde ihn wegschicken. */
const anfrageFelder: Feld[] = [
  {
    name: 'webseite',
    label: 'Ihre Webseite',
    breit: true,
    inputmode: 'url',
    platzhalter: 'ihre-webseite.de',
  },
  { name: 'name', label: 'Name', pflicht: true, breit: true, autocomplete: 'name' },
  {
    name: 'telefon',
    label: 'Telefonnummer',
    type: 'tel',
    pflicht: true,
    breit: true,
    autocomplete: 'tel',
  },
  { name: 'betrieb', label: 'Betrieb', breit: true, autocomplete: 'organization' },
];
---

<BaseLayout
  title="Danke für den Scan | Stolz Marketing"
  description="Sie haben den Code auf unserem Flyer gescannt. Hier gibt es den kostenlosen Sichtbarkeits-Check für Ihren Betrieb."
  noindex={true}
>
  <HeroLeistung
    eyebrow={hero.eyebrow}
    titelVorn={hero.titelVorn}
    titelAkzent={hero.titelAkzent}
    titelHinten={hero.titelHinten}
    lead={hero.lead}
    bild={heroBild}
    bildAlt="Zwei Handwerker bei der Arbeit auf einer Baustelle an der Bergstraße"
    ctaZiel="#anfrage"
    vertrauenText={hero.vertrauen}
    titelBreite="max-w-760"
  />

  <main>
    <Ansprechpartner
      titelVorn={ansprechpartner.titelVorn}
      titelMarker={ansprechpartner.titelMarker}
      text={ansprechpartner.text}
      rolle={ansprechpartner.rolle}
    />

    <CheckInhalt />

    <WarumKoerbchen />

    <Leistungen />

    <Abschluss
      titelVorn={abschluss.titelVorn}
      titelMarker={abschluss.titelMarker}
      titelMitte={abschluss.titelMitte}
      titelKursiv={abschluss.titelKursiv}
      titelHinten={abschluss.titelHinten}
      lead={abschluss.lead}
      felder={anfrageFelder}
      betreff="Sichtbarkeits-Check über /korbaktion"
      ortZeile="Bergstraße und Odenwald"
    />
  </main>

  <Footer />
</BaseLayout>
