---
/* /korbaktion — Landingpage hinter dem QR-Code auf dem Flyer der
   Door-to-Door-Aktion.

   Diese Adresse steht gedruckt und lässt sich nicht mehr ändern. Sie war
   bis hierher eine reine Weiterleitung auf die Startseite; jetzt ist sie
   die Seite, auf der der Lead landet.

   Wer hier ankommt, hat gerade ein Brötchenkörbchen bekommen, den Flyer
   umgedreht und den Code gescannt. Er kennt uns seit zwei Minuten und hat
   keine Frage — deshalb bekommt er eine Sache angeboten, die ihn nichts
   kostet, und zwar sofort:

     1. Hero + Formular   der Anschluss an den Flyer, daneben der Check
     2. Logo-Marquee      Beleg, direkt unter dem Formular
     3. Der Check         was drinsteht, und dass es wirklich nichts kostet
     4. Die Aktion        warum jemand mit einem Körbchen vorbeikommt
     5. Leistungen        die beiden Systeme, bebildert wie auf der Startseite
     6. Ansprechpartner
     7. Abschluss         für die, denen ein Anruf lieber ist

   Kein Header und kein Menü: die Seite hat ein Ziel. Das Logo im Hero
   führt trotzdem auf die Startseite, und der Footer trägt Impressum und
   Datenschutz — beides ist Pflicht.

   noindex und nicht in der Sitemap (Filter in astro.config.mjs): die Seite
   ist das Ziel einer Kampagne, kein organischer Einstieg. Sie träte sonst
   gegen die Startseite an, die auf dieselben Begriffe optimiert ist. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import HeroKorbaktion from '../components/sections/korbaktion/HeroKorbaktion.astro';
import LogoMarquee from '../components/sections/LogoMarquee.astro';
import CheckInhalt from '../components/sections/korbaktion/CheckInhalt.astro';
import WarumKoerbchen from '../components/sections/korbaktion/WarumKoerbchen.astro';
import Leistungen from '../components/sections/Leistungen.astro';
import Ansprechpartner from '../components/sections/webdesign/Ansprechpartner.astro';
import Abschluss from '../components/sections/leistung/Abschluss.astro';
import type { Feld } from '../components/Web3Formular.astro';
import { ansprechpartner, abschluss } from '../data/korbaktion';

/* Kürzer als im Hero: wer bis hier unten gescrollt hat und trotzdem nicht
   angefragt hat, soll nicht noch einmal dasselbe Formular sehen. */
const anfrageFelder: Feld[] = [
  { name: 'name', label: 'Name', pflicht: true, breit: true, autocomplete: 'name' },
  {
    name: 'telefon',
    label: 'Telefonnummer',
    type: 'tel',
    pflicht: true,
    breit: true,
    autocomplete: 'tel',
  },
  { name: 'betrieb', label: 'Betrieb', breit: true, autocomplete: 'organization' },
  { name: 'nachricht', label: 'Worum es geht', mehrzeilig: true },
];
---

<BaseLayout
  title="Danke für den Scan | Stolz Marketing"
  description="Sie haben den Code auf unserem Flyer gescannt. Hier gibt es den kostenlosen Sichtbarkeits-Check für Ihren Betrieb."
  noindex={true}
>
  <HeroKorbaktion />

  <main>
    <LogoMarquee variante="hell" />

    <CheckInhalt />

    <WarumKoerbchen />

    <Leistungen />

    <Ansprechpartner
      titelVorn={ansprechpartner.titelVorn}
      titelMarker={ansprechpartner.titelMarker}
      text={ansprechpartner.text}
      rolle={ansprechpartner.rolle}
    />

    <Abschluss
      titelVorn={abschluss.titelVorn}
      titelMarker={abschluss.titelMarker}
      titelMitte={abschluss.titelMitte}
      titelKursiv={abschluss.titelKursiv}
      titelHinten={abschluss.titelHinten}
      lead={abschluss.lead}
      felder={anfrageFelder}
      betreff="Anfrage über /korbaktion"
      ortZeile="Bergstraße und Odenwald"
    />
  </main>

  <Footer />
</BaseLayout>
