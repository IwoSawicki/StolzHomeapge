---
// Impressum – Texte 1:1 aus original/impressum.html.
// Bewusste Abweichungen (docs/DESIGN-SYSTEM.md):
// - Telefonnummer einheitlich 0178 4444 156 (Antwort Iwo, Frage A;
//   Original zeigte 0173 4388519 mit defektem tel:-Link)
// - mailto-Link korrigiert (Original verlinkte florian@rebland-marketing.de,
//   ein Template-Rest)
// - Zwischenüberschriften semantisch als h2 (Original: h6 mit 40px)
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const bloecke = [
  {
    titel: 'Angaben gemäß § 5 TMG',
    html: 'Iwo Sawicki<br />Heidelbergerstraße 15D<br />64385 Reichelsheim',
  },
  {
    titel: 'Kontakt',
    html: 'Telefon: <a href="tel:+491784444156">+49 178 4444 156</a><br />E-Mail: <a href="mailto:iwo@stolz-marketing.de">iwo@stolz-marketing.de</a>',
  },
  {
    titel: 'Umsatzsteuer-ID',
    html: 'Umsatzsteuer-Identifikationsnummer gemäß § 27 a Umsatzsteuergesetz:<br />DE350093785',
  },
  {
    titel: 'Redaktionell verantwortlich',
    html: 'Iwo Sawicki<br />Heidelbergerstraße 15D<br />64385 Reichelsheim',
  },
  {
    titel: 'EU-Streitschlichtung',
    html: 'Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit: <a href="https://ec.europa.eu/consumers/odr/" rel="noopener" target="_blank">https://ec.europa.eu/consumers/odr/</a>.<br />Unsere E-Mail-Adresse finden Sie oben im Impressum.',
  },
  {
    titel: 'Verbraucher­streit­beilegung/Universal­schlichtungs­stelle',
    html: 'Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.',
  },
];
---

<BaseLayout title="Impressum | STOLZ Marketing">
  <Header />
  <main>
    <section class="px-4.5 pt-14 pb-20 md:px-10 md:pt-26 md:pb-36">
      <div class="mx-auto flex max-w-[1300px] flex-col gap-10 md:flex-row md:justify-between">
        <h1 class="text-5xl font-semibold tracking-[-0.03em] text-black md:text-6xl">
          Impressum<span class="text-blue">.</span>
        </h1>
        <div class="w-full max-w-[810px]">
          {
            bloecke.map((block, i) => (
              <section class:list={[i > 0 && 'mt-12']}>
                <h2 class="text-40 font-medium tracking-[-0.02em] text-black" set:html={block.titel} />
                <p
                  class="mt-6 text-lg font-medium leading-[1.5] text-gray-light [&_a]:underline [&_a]:underline-offset-2"
                  set:html={block.html}
                />
              </section>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
