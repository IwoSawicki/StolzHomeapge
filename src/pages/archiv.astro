---
// /archiv – internes Design-Archiv: nicht gewählte Hero-Varianten
// (v4 Skizze, v1 Shape, v3 Shape-Treppe, alte 1:1-Original-Hero) und
// Projekt-Grid-Designs (A Clean Showcase, B Case Cards, D Projekt-Index,
// E Galerie + alte 1:1-Sektion) sowie die KI-Section. Nur als Referenz,
// falls später etwas wiederverwendet werden soll. Nicht verlinkt und für
// Suchmaschinen gesperrt (robots.txt + Sitemap-Filter). Mehrere h1 hier
// bewusst egal.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import HeroVarianteShape from '../components/sections/HeroVarianteShape.astro';
import HeroVarianteShape3 from '../components/sections/HeroVarianteShape3.astro';
import HeroVarianteShape4 from '../components/sections/HeroVarianteShape4.astro';
import Einblicke from '../components/sections/Einblicke.astro';
import PainpointTabs from '../components/sections/PainpointTabs.astro';
import Leistungen from '../components/sections/Leistungen.astro';
import ProjekteVarianteA from '../components/sections/ProjekteVarianteA.astro';
import ProjekteVarianteB from '../components/sections/ProjekteVarianteB.astro';
import ProjekteVarianteD from '../components/sections/ProjekteVarianteD.astro';
import ProjekteVarianteE from '../components/sections/ProjekteVarianteE.astro';
import Projekte from '../components/sections/Projekte.astro';
import KiStimmen from '../components/sections/KiStimmen.astro';
import Prozess from '../components/sections/Prozess.astro';
import ProzessVarianteA from '../components/sections/ProzessVarianteA.astro';
import ProzessVarianteC from '../components/sections/ProzessVarianteC.astro';
import TeamVarianteA from '../components/sections/TeamVarianteA.astro';
import TeamVarianteC from '../components/sections/TeamVarianteC.astro';
---

<BaseLayout
  title="Design-Archiv | STOLZ Marketing"
  description="Internes Archiv nicht verwendeter Design-Varianten."
>
  <Header />
  <main>
    <div class="px-5 pt-14 text-center md:px-10 md:pt-20">
      <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Internes Archiv</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-[-0.03em] text-dark">
        Nicht verwendete Designs
      </h1>
    </div>

    <p class="mt-16 px-5 text-center text-xs font-medium tracking-wide text-gray uppercase">Hero-Variante 4 · Skizze (1:1-Video + Treppe)</p>
    <HeroVarianteShape4 />
    <p class="px-5 text-center text-xs font-medium tracking-wide text-gray uppercase">Hero-Variante 1 · Shape (Video links)</p>
    <HeroVarianteShape />
    <HeroVarianteShape3 />
    <p class="px-5 text-center text-xs font-medium tracking-wide text-gray uppercase">Alte Hero · 1:1-Nachbau des Originals</p>
    <Hero />

    <p class="mt-16 px-5 text-center text-xs font-medium tracking-wide text-gray uppercase">Alte Sektion · Einblicke (von der Startseite entfernt)</p>
    <Einblicke />
    <p class="mt-16 px-5 text-center text-xs font-medium tracking-wide text-gray uppercase">Alte Sektion · Ihre Herausforderungen (Painpoint-Tabs)</p>
    <PainpointTabs />
    <p class="mt-16 px-5 text-center text-xs font-medium tracking-wide text-gray uppercase">Alte Sektion · Warum wir?</p>
    <Leistungen />
    <ProjekteVarianteD />
    <ProjekteVarianteE />
    <ProjekteVarianteA />
    <ProjekteVarianteB />
    <Projekte />
    <p class="mt-16 px-5 text-center text-xs font-medium tracking-wide text-gray uppercase">Sektion · KI-Stimmen (auch live auf der Startseite)</p>
    <KiStimmen />
    <p class="mt-16 px-5 text-center text-xs font-medium tracking-wide text-gray uppercase">Prozess-Variante A · Sticky Split (nicht gewählt)</p>
    <ProzessVarianteA />
    <p class="mt-16 px-5 text-center text-xs font-medium tracking-wide text-gray uppercase">Prozess-Variante C · Timeline (nicht gewählt)</p>
    <ProzessVarianteC />
    <p class="mt-16 px-5 text-center text-xs font-medium tracking-wide text-gray uppercase">Prozess · alte 1:1-Sektion</p>
    <Prozess />
    <p class="mt-16 px-5 text-center text-xs font-medium tracking-wide text-gray uppercase">Team-Variante A · Gründer mit Text (nicht gewählt)</p>
    <TeamVarianteA />
    <p class="mt-16 px-5 text-center text-xs font-medium tracking-wide text-gray uppercase">Team-Variante C · Slider inkl. Freelancer (nicht gewählt)</p>
    <TeamVarianteC />
  </main>
  <Footer />
</BaseLayout>
