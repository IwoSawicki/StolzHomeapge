---
// Interne Vorschau: die drei Design-Varianten der neuen Zwei-Säulen-
// Leistungssektion untereinander zum Vergleichen. Nicht verlinkt,
// noindex, nicht in der Sitemap. Nach der Entscheidung kann diese
// Seite gelöscht werden (die Varianten liegen als Komponenten vor).
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeistungenZweiA from '../components/sections/LeistungenZweiA.astro';
import LeistungenZweiB from '../components/sections/LeistungenZweiB.astro';
import LeistungenZweiC from '../components/sections/LeistungenZweiC.astro';

const varianten = [
  { key: 'a', titel: 'Variante A — Zwei Karten (dunkel/hell)' },
  { key: 'b', titel: 'Variante B — Riesige Zeilen (wie bisher, nur zwei)' },
  { key: 'c', titel: 'Variante C — Bild-Panels mit Verlauf' },
];
---

<BaseLayout title="Vorschau: Leistungs-Sektion | STOLZ Marketing" noindex>
  <Header />
  <main>
    <section class="px-5 pt-12 pb-4 text-center md:pt-16">
      <h1 class="text-3xl font-bold tracking-[-0.04em] text-dark md:text-4xl">
        Leistungs-Sektion: 3 Varianten
      </h1>
      <p class="mt-2 text-base font-medium text-dark/60">
        Interne Vorschau — beide Kacheln verlinken jeweils auf die neue Unterseite.
      </p>
    </section>

    <div class="mt-8 bg-blue px-5 py-3 text-center text-sm font-bold text-white">{varianten[0].titel}</div>
    <LeistungenZweiA id="variante-a" />

    <div class="bg-blue px-5 py-3 text-center text-sm font-bold text-white">{varianten[1].titel}</div>
    <LeistungenZweiB id="variante-b" />

    <div class="bg-blue px-5 py-3 text-center text-sm font-bold text-white">{varianten[2].titel}</div>
    <LeistungenZweiC id="variante-c" />
  </main>
  <Footer />
</BaseLayout>
