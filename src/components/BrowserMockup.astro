---
// Browser-Rahmen für Website-Projekte. Zeigt die Domain in der Adressleiste;
// ohne Screenshot ein gestalteter Platzhalter (unter gleichem Namen
// austauschbar).
// mockup=true: Portfolio-Look — Browser-Fenster mit Schatten schwebt auf
// einer Markenfarben-Fläche und ist unten angeschnitten.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  domain?: string;
  /** optionaler echter Screenshot */
  bild?: ImageMetadata;
  alt?: string;
  /** Browser-Leiste anzeigen (false = nur rohe Medienfläche, cleaner Look) */
  chrome?: boolean;
  /** Portfolio-Mockup: Fenster mit Schatten auf Farbfläche */
  mockup?: boolean;
  class?: string;
}
const { domain = '', bild, alt = `Website ${domain}`, chrome = true, mockup = false, class: extra = '' } = Astro.props;
const wortmarke = domain.replace(/^www\./, '').split('.')[0];
---

{
  mockup ? (
    <div class={`flex h-full w-full flex-col justify-end bg-linear-to-br from-bg-blue to-bg-blue-light px-[9%] pt-[9%] ${extra}`}>
      <div class="flex min-h-0 w-full flex-1 flex-col overflow-hidden rounded-t-[12px] bg-white shadow-stack-strong ring-1 ring-dark/5">
        <div class="flex shrink-0 items-center gap-1.5 border-b border-border bg-bg-soft px-3 py-2">
          <span class="size-2 rounded-full bg-border-gray" />
          <span class="size-2 rounded-full bg-border-gray" />
          <span class="size-2 rounded-full bg-border-gray" />
          {domain && (
            <span class="mx-auto flex items-center gap-1.5 rounded-full border border-border bg-white px-2.5 py-0.5 text-[11px] font-medium text-gray-slate">
              <svg class="size-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <rect x="5" y="11" width="14" height="9" rx="2" />
                <path d="M8 11V7a4 4 0 0 1 8 0v4" />
              </svg>
              {domain}
            </span>
          )}
        </div>
        <div class="relative min-h-0 flex-1 overflow-hidden bg-white">
          {bild ? (
            <Image src={bild} alt={alt} class="absolute inset-0 h-full w-full object-cover object-top" widths={[480, 768, 1024]} sizes="(min-width: 810px) 50vw, 100vw" />
          ) : (
            <div class="absolute inset-0 flex items-center justify-center bg-linear-to-br from-bg-blue to-bg-blue-light">
              <span class="font-display text-2xl font-extrabold tracking-[-0.04em] text-slate/20 select-none md:text-3xl">
                {wortmarke}
              </span>
            </div>
          )}
        </div>
      </div>
    </div>
  ) : null
}

{
  !mockup && (
    <div class={`flex h-full w-full flex-col overflow-hidden rounded-14 border border-border bg-white ${extra}`}>
      <div class:list={['flex shrink-0 items-center gap-1.5 border-b border-border bg-bg-soft px-3.5 py-2.5', !chrome && 'hidden']}>
        <span class="size-2 rounded-full bg-border-gray" />
        <span class="size-2 rounded-full bg-border-gray" />
        <span class="size-2 rounded-full bg-border-gray" />
        <span class="mx-auto flex items-center gap-1.5 rounded-full border border-border bg-white px-3 py-0.5 text-xs font-medium text-gray-slate">
          <svg class="size-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <rect x="5" y="11" width="14" height="9" rx="2" />
            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
          </svg>
          {domain}
        </span>
      </div>
      <div class="relative flex-1 overflow-hidden bg-linear-to-br from-bg-blue to-bg-blue-light">
        {bild ? (
          <Image src={bild} alt={alt} class="absolute inset-0 h-full w-full object-cover object-top" widths={[480, 768, 1024]} sizes="(min-width: 810px) 50vw, 100vw" />
        ) : (
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="font-display text-3xl font-extrabold tracking-[-0.04em] text-slate/20 select-none md:text-4xl">
              {wortmarke}
            </span>
          </div>
        )}
      </div>
    </div>
  )
}
