---
// Browser-Rahmen für Website-Projekte. Zeigt die Domain in der Adressleiste;
// ohne Screenshot ein gestalteter Platzhalter (unter gleichem Namen
// austauschbar).
// Der Screenshot läuft immer über die volle Breite und wird nur unten
// angeschnitten (wie ein echtes Browserfenster) — NICHT seitlich
// beschneiden, sonst fehlen Logo und Navigation am Rand.
// mockup=true: Portfolio-Look — Browser-Fenster mit Schatten schwebt auf
// einer Markenfarben-Fläche und ist unten angeschnitten.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  domain?: string;
  /** optionaler echter Screenshot */
  bild?: ImageMetadata;
  alt?: string;
  /** Browser-Leiste anzeigen (false = nur rohe Medienfläche, cleaner Look) */
  chrome?: boolean;
  /** Portfolio-Mockup: Fenster mit Schatten auf Farbfläche */
  mockup?: boolean;
  /** Breiten der generierten Varianten (Default: Raster mit 2 Spalten) */
  widths?: number[];
  /** sizes-Attribut — muss zur echten Anzeigebreite passen, sonst lädt
   *  der Browser eine zu kleine (unscharfe) oder zu große Datei */
  sizes?: string;
  /** Beschriftung der Platzhalter-Fläche, wenn kein Screenshot da ist */
  platzhalterText?: string;
  /** WebP-Qualität; Fotos vertragen weniger als UI-Screenshots */
  qualitaet?: number;
  /** true = Bild sofort laden (nur für das erste Bild über der Falz) */
  vorrang?: boolean;
  class?: string;
}
const {
  domain = '',
  bild,
  alt = `Website ${domain}`,
  chrome = true,
  mockup = false,
  widths = [480, 768, 1024],
  qualitaet = 70,
  platzhalterText,
  sizes = '(min-width: 810px) 50vw, 100vw',
  vorrang = false,
  class: extra = '',
} = Astro.props;
const wortmarke = platzhalterText ?? domain.replace(/^www\./, '').split('.')[0];
---

{
  mockup ? (
    <div class={`flex h-full w-full flex-col justify-end bg-linear-to-br from-bg-blue to-bg-blue-light px-[9%] pt-[9%] ${extra}`}>
      <div class="flex max-h-full w-full flex-col overflow-hidden rounded-t-[12px] bg-white shadow-stack-strong ring-1 ring-dark/5">
        <div class="flex shrink-0 items-center gap-1.5 border-b border-border bg-bg-soft px-3 py-2">
          <span class="size-2 rounded-full bg-border-gray" />
          <span class="size-2 rounded-full bg-border-gray" />
          <span class="size-2 rounded-full bg-border-gray" />
          {domain && (
            <span class="mx-auto flex items-center gap-1.5 rounded-full border border-border bg-white px-2.5 py-0.5 text-[11px] font-medium text-gray-slate">
              <svg class="size-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <rect x="5" y="11" width="14" height="9" rx="2" />
                <path d="M8 11V7a4 4 0 0 1 8 0v4" />
              </svg>
              {domain}
            </span>
          )}
        </div>
        <div class="relative min-h-0 overflow-hidden bg-white">
          {bild ? (
            <Image src={bild} alt={alt} class="block h-auto w-full" widths={widths} sizes={sizes} quality={qualitaet} loading={vorrang ? 'eager' : 'lazy'} {...(vorrang ? { fetchpriority: 'high' } : {})} />
          ) : (
            <div class="flex aspect-[16/10] items-center justify-center bg-linear-to-br from-bg-blue to-bg-blue-light">
              <span class="font-display text-2xl font-extrabold tracking-[-0.04em] text-slate/20 select-none md:text-3xl">
                {wortmarke}
              </span>
            </div>
          )}
        </div>
      </div>
    </div>
  ) : null
}

{
  !mockup && (
    <div class={`flex h-full w-full flex-col overflow-hidden rounded-14 border border-border bg-white ${extra}`}>
      <div class:list={['flex shrink-0 items-center gap-1.5 border-b border-border bg-bg-soft px-3.5 py-2.5', !chrome && 'hidden']}>
        <span class="size-2 rounded-full bg-border-gray" />
        <span class="size-2 rounded-full bg-border-gray" />
        <span class="size-2 rounded-full bg-border-gray" />
        <span class="mx-auto flex items-center gap-1.5 rounded-full border border-border bg-white px-3 py-0.5 text-xs font-medium text-gray-slate">
          <svg class="size-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
            <rect x="5" y="11" width="14" height="9" rx="2" />
            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
          </svg>
          {domain}
        </span>
      </div>
      <div class="relative min-h-0 overflow-hidden bg-linear-to-br from-bg-blue to-bg-blue-light">
        {bild ? (
          <Image src={bild} alt={alt} class="block h-auto w-full" widths={widths} sizes={sizes} quality={qualitaet} loading={vorrang ? 'eager' : 'lazy'} {...(vorrang ? { fetchpriority: 'high' } : {})} />
        ) : (
          <div class="flex aspect-[16/10] items-center justify-center">
            <span class="font-display text-3xl font-extrabold tracking-[-0.04em] text-slate/20 select-none md:text-4xl">
              {wortmarke}
            </span>
          </div>
        )}
      </div>
    </div>
  )
}
