---
// Hochformat-Video-Kachel (Still, ohne Play-Button) im Stil der
// Einblicke-Frames. `bild` ist das Video-Standbild; ohne Bild dunkler
// Gradient wie im Original.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  bild?: ImageMetadata;
  alt?: string;
  /** Breiten der generierten Varianten */
  widths?: number[];
  /** sizes muss zur echten Anzeigebreite passen (sonst unscharf oder zu groß) */
  sizes?: string;
  /** WebP-Qualität; Fotos vertragen weniger als UI-Screenshots */
  qualitaet?: number;
  /** true = sofort laden (nur für Kacheln über der Falz) */
  vorrang?: boolean;
  class?: string;
}
const {
  bild,
  alt = 'Video-Beispiel',
  widths = [380, 576, 760],
  qualitaet = 70,
  sizes = '(min-width: 810px) 33vw, 100vw',
  vorrang = false,
  class: extra = '',
} = Astro.props;
---

<div class={`relative h-full w-full overflow-hidden bg-linear-160 from-video-dark-1 to-video-dark-2 ${extra}`}>
  {
    bild && (
      <Image src={bild} alt={alt} class="absolute inset-0 h-full w-full object-cover" widths={widths} sizes={sizes} quality={qualitaet} loading={vorrang ? 'eager' : 'lazy'} {...(vorrang ? { fetchpriority: 'high' } : {})} />
    )
  }
</div>
