---
/* „Was die KI über uns sagt": letzte Sektion der Startseite. Vier Knöpfe
   öffnen den jeweiligen Dienst mit einer bereits eingetragenen Frage.

   Steht nicht in der Design-Vorlage — Wunsch von Iwo, Vorbild ist die
   Sektion „See what AI has to say about us" von madebyshape.co.uk, dort mit
   verstreuten Bildern um die Überschrift herum.

   Die Bilder sind echte Aufnahmen aus dem Bestand (Projekte, Team, Dreh) —
   keine Platzhalter, keine Stockfotos. Sie sind reine Dekoration, tragen
   deshalb ein leeres alt und liegen erst ab 1040px im Layout: darunter
   würden sie der Überschrift den Platz nehmen. */
import { Image } from 'astro:assets';
import { kiFrage, kiDienste } from '../../data/ki-frage';

const frage = encodeURIComponent(kiFrage);

const projekte = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/projekte/*.{png,jpg}',
  { eager: true },
);
const leistungen = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/leistungen/*.{jpg,JPG}',
  { eager: true },
);

/* Position, Größe und leichte Drehung je Kachel — von Hand gesetzt, damit
   es gestreut wirkt und nicht wie ein Raster. */
const kacheln = [
  { bild: projekte['../../assets/projekte/hepa-baut-startseite.png']!.default,
    stil: 'left:-5%; top:3%;   width:clamp(150px,15vw,250px)', dreh: '-3deg', schnitt: '50% 0%' },
  { bild: leistungen['../../assets/leistungen/kundengewinnung.JPG']!.default,
    stil: 'left:1%;  top:44%;  width:clamp(120px,12vw,195px)', dreh: '4deg', schnitt: '50% 45%' },
  { bild: projekte['../../assets/projekte/nkn-pv-elektrik-startseite.png']!.default,
    stil: 'left:-4%; top:80%;  width:clamp(140px,13vw,215px)', dreh: '2deg', schnitt: '50% 0%' },
  { bild: projekte['../../assets/projekte/dmk-fotoshooting-platzhalter.jpg']!.default,
    stil: 'right:-5%; top:0%;  width:clamp(120px,11vw,180px)', dreh: '3deg', schnitt: '50% 35%' },
  { bild: projekte['../../assets/projekte/jhoch2-startseite.png']!.default,
    stil: 'right:1%;  top:42%; width:clamp(150px,15vw,250px)', dreh: '-4deg', schnitt: '50% 0%' },
  { bild: leistungen['../../assets/leistungen/mitarbeitergewinnung.jpg']!.default,
    stil: 'right:-4%; top:81%; width:clamp(120px,12vw,195px)', dreh: '-2deg', schnitt: '50% 40%' },
];
---

<section class="overflow-hidden bg-paper px-20 py-[clamp(96px,12vw,168px)]">
  <div class="relative mx-auto max-w-content-wide nav:min-h-680">
    {/* --- verstreute Bilder, erst ab 1040px --- */}
    <div class="pointer-events-none absolute inset-0 hidden nav:block" aria-hidden="true">
      {
        kacheln.map((kachel) => (
          <div
            class="absolute overflow-hidden rounded-16 border border-line bg-paper-warm shadow-card-light"
            style={`${kachel.stil}; rotate:${kachel.dreh}`}
          >
            <Image
              src={kachel.bild}
              alt=""
              widths={[260, 520]}
              sizes="250px"
              loading="lazy"
              decoding="async"
              class="block aspect-[4/3] w-full object-cover"
              style={`object-position:${kachel.schnitt}`}
            />
          </div>
        ))
      }
    </div>

    {/* --- Mitte --- */}
    <div
      class="relative mx-auto flex max-w-680 flex-col items-center gap-22 py-16 text-center nav:py-96"
    >
      <span class="flex items-center gap-8 text-15 font-medium text-ink-muted">
        <span class="h-6 w-6 rounded-full bg-lime" aria-hidden="true"></span>
        Nicht glauben, nachfragen
      </span>

      <h2
        class="m-0 text-h2-claim leading-claim font-bold tracking-claim text-balance text-ink"
      >
        Was die KI <span class="font-display font-semibold tracking-none italic"
          >über uns sagt</span
        >
      </h2>

      <div class="mt-6 flex flex-wrap justify-center gap-10">
        {
          kiDienste.map((dienst) => (
            <a
              href={dienst.adresse(frage)}
              target="_blank"
              rel="noopener"
              class="inline-flex h-50 items-center gap-8 rounded-full bg-lime px-22 text-17 font-bold text-forest-deep no-underline shadow-glow transition-transform duration-200 hover:scale-[1.04] hover:bg-lime-bright"
            >
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                class="flex-none"
              >
                <path d="M12 1.6l2.1 6.3 6.3 2.1-6.3 2.1-2.1 6.3-2.1-6.3-6.3-2.1 6.3-2.1z" />
              </svg>
              {dienst.name}
            </a>
          ))
        }
      </div>

      {/* Ehrlich und zugleich Positionierung: Die Antwort selbst ist nicht
          steuerbar, das Fundament darunter schon — und genau das ist eine
          unserer Leistungen („Sichtbarkeit in ChatGPT, Perplexity und
          anderen KI-Antworten", /kunden-gewinnen). */}
      <p class="m-0 mt-10 max-w-560 text-17 leading-body text-ink-muted">
        Was die KI antwortet, entscheidet sie selbst. Beeinflussen lässt sich, was sie
        über Sie findet — und genau daran arbeiten wir.
      </p>

      <a
        href="/kontakt"
        class="text-17 font-medium text-ink underline decoration-1 underline-offset-4 transition-colors hover:text-lime-link-hover"
      >
        Wissen, was die KI über Ihren Betrieb sagt? <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
