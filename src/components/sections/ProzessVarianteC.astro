---
// PROZESS-VARIANTE C – „Fortschritts-Timeline":
// Vertikale Linie, die sich beim Scrollen mit Blau füllt; nummerierte
// Punkte, Karten mit Bild + Text, die einzeln einblenden. Der Fortschritt
// wird scroll-gesteuert (kleines Vanilla-JS) berechnet.
import { Image } from 'astro:assets';
import workshop from '../../assets/prozess-workshop-strategie.png';
import umsetzung from '../../assets/prozess-umsetzung.jpg';
import skalierung from '../../assets/prozess-skalierung-optimierung.png';

const steps = [
  { titel: 'Workshop & Strategie', text: 'In einem kompakten Workshop lernen wir Ihr Unternehmen, Ihre Zielgruppe und Ihren Markt kennen — daraus entsteht eine klare Strategie.', bild: workshop, alt: 'Strategie-Workshop bei einem lokalen Betrieb' },
  { titel: 'Umsetzung', text: 'Wir setzen Kampagnen, Landingpages und Inhalte um. Sie bekommen regelmäßige Updates und behalten den vollen Überblick.', bild: umsetzung, alt: 'Content-Produktion vor Ort' },
  { titel: 'Skalierung & Optimierung', text: 'Nach dem Start optimieren wir laufend Anzeigen, Zielgruppen und Budgets — Ihr Marketing wird planbarer.', bild: skalierung, alt: 'Auswertung laufender Kampagnen am Bildschirm' },
];
---

<section class="px-5 py-16 md:px-10 md:py-24">
  <p class="mb-10 text-center text-xs font-medium tracking-wide text-gray uppercase">
    Prozess-Variante C · Fortschritts-Timeline (zur Auswahl)
  </p>

  <div class="mx-auto max-w-[760px]">
    <div class="text-center" data-reveal>
      <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Prozess</p>
      <h2 class="mt-3 text-4xl font-semibold text-balance leading-[1.08] tracking-[-0.03em] text-dark md:text-5xl">
        Unser Prozess zum Erfolg
      </h2>
    </div>

    <div class="relative mt-16" data-timeline>
      {/* Track + Füll-Linie */}
      <div class="absolute top-0 bottom-0 left-[18px] w-[3px] -translate-x-1/2 rounded-full bg-border"></div>
      <div class="absolute top-0 left-[18px] w-[3px] -translate-x-1/2 rounded-full bg-blue" data-fill style="height:0"></div>

      {
        steps.map((step, i) => (
          <div class="relative pb-12 pl-14 last:pb-0" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span class="absolute top-0 left-0 z-10 flex size-9 items-center justify-center rounded-full bg-blue text-sm font-semibold text-white tabular-nums">
              {i + 1}
            </span>
            <div class="overflow-hidden rounded-24 border border-border bg-white shadow-card-soft md:flex md:items-stretch">
              <div class="aspect-[16/10] w-full overflow-hidden md:aspect-auto md:w-[220px] md:shrink-0">
                <Image src={step.bild} alt={step.alt} class="h-full w-full object-cover" widths={[280, 480]} sizes="220px" />
              </div>
              <div class="p-5 md:p-6">
                <h3 class="text-xl font-semibold tracking-[-0.02em] text-dark md:text-2xl">{step.titel}</h3>
                <p class="mt-2 text-base font-medium leading-[1.5] text-dark/60">{step.text}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Füll-Linie folgt dem Scroll-Fortschritt durch die Timeline.
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  const fill = timeline?.querySelector<HTMLElement>('[data-fill]');
  if (timeline && fill) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = timeline.getBoundingClientRect();
      const start = window.innerHeight * 0.55;
      const h = Math.max(0, Math.min(rect.height, start - rect.top));
      fill.style.height = `${h}px`;
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
