---
/* Hero der Projekte-Seite: heller Grund, Eyebrow, H1, Lead und zwei Buttons.
   Vorlage: design/Projekte.dc.html, data-screen-label="Hero Projekte" */
import Eyebrow from '../Eyebrow.astro';
---

<section
  class="flex flex-col items-center gap-24 bg-paper px-20 pt-[clamp(56px,8vw,92px)] pb-[clamp(64px,9vw,104px)] text-center"
>
  <Eyebrow variante="hell">Projekte</Eyebrow>

  <h1
    class="m-0 max-w-900 text-h1-sub leading-hero font-bold tracking-faq text-ink"
  >
    Was wir für Betriebe in der Region <span
      class="font-display font-semibold tracking-none italic">gebaut haben</span
    >
  </h1>

  <p class="m-0 max-w-660 text-19 leading-body text-ink-muted">
    Marke, Webseite, Fotos, Video und bezahlte Werbung — je nachdem, was der Betrieb
    gebraucht hat. Hier sehen Sie, was dabei entstanden ist.
  </p>

  <div class="mt-8 flex flex-wrap justify-center gap-12">
    <a
      href="/erstgespraech"
      class="inline-flex h-56 items-center gap-10 rounded-8 bg-lime px-28 text-16 font-bold text-forest-deep no-underline shadow-glow transition-colors duration-200 hover:bg-lime-bright"
    >
      Kostenloses Erstgespräch<span class="text-18" aria-hidden="true">→</span>
    </a>
    <a
      href="#projekte"
      class="box-content inline-flex h-56 items-center rounded-8 border border-line-strong bg-paper px-26 text-16 font-medium text-ink no-underline transition-colors duration-200 hover:border-sketch-light hover:bg-paper-hover"
    >
      Projekte ansehen
    </a>
  </div>
</section>
