---
// TEAM-SEKTION – „Ihr Ansprechpartner" (kompakt, clean):
// Eine ruhige Karte mit Portrait, Rolle, kurzem Text und Kontakt.
// Steht ganz unten auf der Startseite (nach Ergebnis).
// Hinweis: STOLZ Marketing ist Einzelunternehmen (Iwo Sawicki) — hier
// steht bewusst nur Iwo; Spezialisten kommen projektweise dazu.
import { Image } from 'astro:assets';
import SectionHeading from '../SectionHeading.astro';
import iwoBild from '../../assets/about/Iwo-StolzMarketing.jpg';

const person = {
  name: 'Iwo Sawicki',
  rolle: 'Marketing & Projektleitung',
  bild: iwoBild,
  text: 'Ich betreue jedes Projekt von der Strategie bis zur Auswertung — Website, Google Ads und Sichtbarkeit. Sie haben einen Ansprechpartner, der Ihren Betrieb kennt. Für Schnitt und Grafik arbeite ich mit festen Spezialisten.',
  email: 'iwo@stolz-marketing.de',
  tel: '0178 4444 156',
  telLink: '+491784444156',
};
---

<section id="team" class="scroll-mt-24 px-5 py-14 md:px-10 md:py-20">
  <div class="mx-auto max-w-[820px]">
    <div class="mx-auto max-w-[560px]" data-reveal>
      <SectionHeading label="Ihr Ansprechpartner">
        Wer hinter STOLZ steckt
        <Fragment slot="description">
          Kein Callcenter, kein wechselnder Kundenberater — Sie sprechen direkt mit mir.
        </Fragment>
      </SectionHeading>
    </div>

    <!-- Eine Person: Portrait links, Inhalt rechts (mobil gestapelt) -->
    <div
      class="mt-10 flex flex-col gap-5 rounded-24 border border-border bg-white p-4 shadow-card-soft md:mt-12 md:flex-row md:items-center md:gap-7 md:p-5"
      data-reveal
    >
      <div class="w-full shrink-0 overflow-hidden rounded-20 bg-bg-blue-light md:w-[280px]">
        <div class="aspect-square w-full">
          <Image
            src={person.bild}
            alt={`Portrait von ${person.name}`}
            class="h-full w-full object-cover object-top"
            widths={[320, 560, 720]}
            sizes="(min-width:810px) 280px, 100vw"
          />
        </div>
      </div>

      <div class="min-w-0 md:py-2">
        <h3 class="text-xl font-semibold tracking-[-0.02em] text-dark md:text-2xl">{person.name}</h3>
        <p class="text-sm font-semibold text-blue md:text-base">{person.rolle}</p>
        <p class="mt-3 text-sm font-medium leading-[1.5] text-dark/60 md:text-base">{person.text}</p>
        <div class="mt-5 flex flex-col gap-2">
          <a
            href={`mailto:${person.email}`}
            class="inline-flex items-center gap-2 text-base font-semibold text-blue transition-colors hover:text-blue-bright"
          >
            <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
            {person.email}
          </a>
          <a
            href={`tel:${person.telLink}`}
            class="inline-flex items-center gap-2 text-base font-semibold text-blue transition-colors hover:text-blue-bright"
          >
            <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.5-1.2a2 2 0 0 1 2.1-.4c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2Z" />
            </svg>
            {person.tel}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
