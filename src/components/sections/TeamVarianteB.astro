---
// TEAM-VARIANTE B – „Nebeneinander, clean":
// Zwei ruhige Karten nebeneinander, Portrait + Name + Rolle + Ein-Zeiler +
// Kontakt. Minimalistisch, viel Weißraum. Zeigt Iwo & Eric.
// FOTOS: sobald vorhanden `bild` setzen, sonst Initialen-Platzhalter.
// TEXTE = VORSCHLAG.
const gruender = [
  {
    name: 'Iwo Sawicki',
    rolle: 'Gründer & Strategie',
    initialen: 'IS',
    bild: null,
    zeile: 'Plant Ihre Sichtbarkeit — von der Website bis zur Google-Strategie.',
    email: 'iwo@stolz-marketing.de',
    tel: '+49 178 4444156',
  },
  {
    name: 'Eric',
    rolle: 'Gründer & Kundenbetreuung',
    initialen: 'E',
    bild: null,
    zeile: 'Ihr fester Ansprechpartner für Umsetzung und laufende Betreuung.',
    email: 'eric@stolz-marketing.de',
    tel: '+49 178 4444156',
  },
];
---

<section id="team" class="scroll-mt-24 px-5 py-16 md:px-10 md:py-24">
  <p class="mb-10 text-center text-xs font-medium tracking-wide text-gray uppercase">
    Team-Variante B · Nebeneinander clean (zur Auswahl)
  </p>

  <div class="mx-auto max-w-[960px]">
    <div class="mx-auto max-w-[560px] text-center" data-reveal>
      <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Das Team</p>
      <h2 class="mt-3 text-4xl font-semibold text-balance leading-[1.08] tracking-[-0.03em] text-dark md:text-5xl">
        Ihre festen Ansprechpartner
      </h2>
      <p class="mt-4 text-lg font-medium leading-[1.5] text-dark/60">
        Kein Callcenter, keine wechselnden Kontakte — Sie sprechen direkt mit den Gründern.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 md:gap-8">
      {
        gruender.map((person, i) => (
          <div
            class="group flex flex-col rounded-28 border border-border bg-white p-4 shadow-card-soft transition-shadow hover:shadow-card"
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
          >
            <div class="overflow-hidden rounded-24 bg-bg-blue-light">
              <div class="aspect-[4/5] w-full">
                {person.bild ? (
                  <img src={person.bild} alt={`Portrait von ${person.name}`} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
                ) : (
                  <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-blue via-blue-bright to-slate">
                    <span class="font-display text-6xl font-extrabold text-white/90">{person.initialen}</span>
                  </div>
                )}
              </div>
            </div>

            <div class="px-2 pt-5 pb-2">
              <h3 class="text-2xl font-semibold tracking-[-0.02em] text-dark">{person.name}</h3>
              <p class="mt-1 text-sm font-semibold text-blue">{person.rolle}</p>
              <p class="mt-3 text-base font-medium leading-[1.5] text-dark/60">{person.zeile}</p>

              <div class="mt-5 flex flex-col gap-1.5 border-t border-border pt-4 text-sm font-medium">
                <a href={`mailto:${person.email}`} class="text-dark/70 transition-colors hover:text-blue">
                  {person.email}
                </a>
                <a href={`tel:${person.tel.replace(/\s/g, '')}`} class="text-dark/70 transition-colors hover:text-blue">
                  {person.tel}
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
