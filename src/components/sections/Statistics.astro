---
// Statistics – großes Statement + 3 Werte (Messbar/Planbar/Transparent).
// Statement 52px/600 (Phone 40px), Werte 50px Inter 400 blau,
// Beschreibungen 20px. Grid: 3 Spalten (D) / 2 (T) / 1 (P), Spalte 360.
const werte = [
  { wert: 'Messbar', text: 'Jede Kampagne wird darauf ausgewertet, wie viele Anfragen sie bringt' },
  { wert: 'Planbar', text: 'Budget, Zielgruppe und Ergebnis werden nachvollziehbar gemacht' },
  { wert: 'Transparent', text: 'Sie erhalten jeden Monat eine klare Einschätzung statt Zahlenchaos' },
];
---

<section class="px-3 py-12 md:px-10 md:py-25">
  <div class="mx-auto max-w-[1200px]">
    <p class="text-40 font-semibold text-balance tracking-[-0.04em] text-dark md:text-52">
      Ihre Arbeit spricht für sich.
    </p>
    <p class="text-40 font-semibold text-balance tracking-[-0.04em] text-dark md:text-52">
      Ich sorge dafür, dass die richtigen Leute das wissen.
    </p>

    <dl class="mt-20 grid grid-cols-1 gap-x-15 gap-y-10 md:grid-cols-2 xl:grid-cols-3">
      {
        werte.map((w) => (
          <div class="max-w-[360px]">
            <dt class="text-5xl font-normal leading-[1.3] tracking-[-0.03em] text-blue">{w.wert}</dt>
            <dd class="text-xl leading-[1.3] tracking-[-0.01em] text-dark">{w.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
