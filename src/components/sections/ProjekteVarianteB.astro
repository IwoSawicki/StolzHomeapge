---
// DESIGN-VARIANTE B – „Case Cards" (editorial):
// Weiße Karten im bekannten Karten-Stil der Seite (Radius 30, Rahmen,
// 4px-Medienrahmen wie die bisherigen Projekt-Karten), darunter Name,
// Kurzbeschreibung und Kategorie-Badges. Websites mit Browser-Mockup,
// Videos als Hochformat im Ausschnitt. 2 Spalten, ruhig und informativ.
import SectionHeading from '../SectionHeading.astro';
import Button from '../Button.astro';
import BrowserMockup from '../BrowserMockup.astro';
import VideoTile from '../VideoTile.astro';
import { startseitenProjekte } from '../../data/projekte';
---

<section class="bg-bg-soft px-3 pt-24 pb-12 md:px-9 md:pt-[150px] md:pb-25">
  <p class="mb-6 text-center text-xs font-medium tracking-wide text-gray uppercase">
    Design-Variante B · Case Cards (zur Auswahl, wird später entfernt)
  </p>
  <SectionHeading label="Kunden" headingMaxWidth={800}>
    Erfolgreiche Projekte
    <Fragment slot="description">
      Websites, Kampagnen und Recruiting-Content für Handwerksbetriebe – ein Ausschnitt aus unserer Arbeit.
    </Fragment>
  </SectionHeading>

  <div class="mx-auto mt-17 grid max-w-[1200px] grid-cols-1 gap-4 md:grid-cols-2">
    {
      startseitenProjekte.map((projekt) => (
        <article class="group flex flex-col rounded-30 border border-border bg-white p-1 shadow-card-soft transition-shadow duration-300 hover:shadow-card">
          <div class="h-[300px] overflow-hidden rounded-[26px] md:h-[340px]">
            {projekt.art === 'website' ? (
              <BrowserMockup domain={projekt.domain!} alt={`Website-Projekt ${projekt.name}`} class="rounded-[26px] border-0" />
            ) : (
              <div class="relative h-full w-full bg-bg-blue">
                {/* Hochformat-Video mittig als „Phone"-Ausschnitt */}
                <div class="absolute inset-x-0 top-6 bottom-0 mx-auto w-[46%] overflow-hidden rounded-t-20 shadow-stack">
                  <VideoTile bild={projekt.bild} alt={`Video-Projekt ${projekt.name}`} />
                </div>
              </div>
            )}
          </div>
          <div class="flex flex-1 flex-col px-5 pt-4 pb-5">
            <h3 class="text-2xl font-semibold tracking-[-0.02em] text-dark">{projekt.name}</h3>
            <p class="mt-1 text-15 font-medium tracking-[-0.01em] text-dark/60">{projekt.beschreibung}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {projekt.kategorien.map((kategorie) => (
                <span class="rounded-full border border-border bg-bg-soft px-3 py-1 text-xs font-semibold text-gray-slate">
                  {kategorie}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="mt-12 flex justify-center">
    <Button href="/projekte" variant="blue" shadow="blue-glow">Alle Projekte ansehen</Button>
  </div>
</section>
