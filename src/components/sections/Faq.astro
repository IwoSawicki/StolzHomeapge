---
/* FAQ der Startseite: links ein mitlaufender Kopf, rechts das Akkordeon.
   Vorlage: design/STARTSEITE.dc.html, data-screen-label="FAQ"

   Hinweis: Die Antworten sind laut design/README.md noch Entwürfe und
   inhaltlich nicht freigegeben. */
import Button from '../Button.astro';
import Akkordeon from '../Akkordeon.astro';
import { faqs } from '../../data/startseite';
---

<section class="bg-paper px-20 py-section-y-lg">
  <div class="mx-auto flex max-w-content flex-wrap items-start gap-spalten-faq">
    {/* Der Kopf läuft nur mit, solange er neben dem Akkordeon steht. Die
        Spalten brechen bei rund 776px um; darunter würde sticky den Kopf
        über das Akkordeon schieben. */}
    <div
      class="flex flex-[0.8] basis-280 flex-col items-start gap-20 min-[800px]:sticky min-[800px]:top-40"
    >
      <span
        class="inline-block rounded-6 border border-line-strong px-9 py-4 font-mono text-12 tracking-mono text-ink-faint"
      >
        FAQ
      </span>
      <h2 class="m-0 text-h2-faq leading-tightest font-bold tracking-faq text-ink">
        Häufige <span class="font-display font-semibold italic">Fragen</span>
      </h2>
      <p class="m-0 max-w-340 text-17 leading-prose text-ink-soft">
        Steht Ihre Frage nicht dabei, rufen Sie an. Antwort kostet nichts.
      </p>
      <Button href="/kontakt" variante="tinte" class="mt-6">
        <span aria-hidden="true">→</span>Frage stellen
      </Button>
    </div>

    <Akkordeon
      eintraege={faqs}
      mitNummern
      frageGroesse="text-20"
      id="faq-start"
      class="flex-[1.2] basis-420"
    />
  </div>
</section>
