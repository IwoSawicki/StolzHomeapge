---
// HERO-VARIANTE 2 „Shape-Überlappung" (inspiriert von madebyshape.co.uk):
// Großes Hochkant-Video rechts; das weiße Text-Panel überlappt am Desktop
// links ins Video hinein — mit den Shape-typischen Außenrundungen:
// konvexer Panel-Kante plus umgekehrten Kurven (Inverted Corners) oben
// und unten am Übergang. Mobil: Text oben, Video darunter.
//
// VIDEO EINBINDEN: wie bei der ersten Variante — MP4 nach
// public/videos/hero-hochkant.mp4 laden (Poster optional daneben).
import { existsSync } from 'node:fs';
import Button from '../Button.astro';

const hatVideo = existsSync(new URL('../../../public/videos/hero-hochkant.mp4', import.meta.url));
const hatPoster = existsSync(new URL('../../../public/videos/hero-hochkant-poster.jpg', import.meta.url));
---

<section class="px-5 pt-16 pb-16 md:px-10 md:pt-24 md:pb-24">
  <p class="mb-8 text-center text-xs font-medium tracking-wide text-gray uppercase">
    Hero-Variante 2 · Shape-Überlappung (zur Auswahl, wird später entfernt)
  </p>

  <div class="mx-auto max-w-[1200px] xl:flex xl:items-center">
    {/* Text-Panel: überlappt am Desktop ins Video, mit Außenrundungen */}
    <div class="shape2-panel relative z-10 bg-white xl:-mr-28 xl:rounded-r-[32px] xl:py-12 xl:pr-14">
      <p class="flex items-center gap-2.5 text-sm font-medium text-dark">
        <span class="size-1.5 rounded-full bg-dark" aria-hidden="true"></span>
        Hey, wir sind Stolz Marketing
      </p>
      {/* bewusst kein <h1>: das hat die bestehende Hero; wird diese Variante
          gewählt, übernimmt diese Zeile das h1 */}
      <p class="mt-4 max-w-[560px] text-40 font-semibold text-balance leading-[1.02] tracking-[-0.04em] text-dark md:text-52 xl:text-6xl">
        Ein Ansprechpartner für Ihr gesamtes Marketing.
      </p>
      <p class="mt-6 max-w-[460px] text-lg font-medium text-balance leading-[1.4] tracking-[-0.01em] text-dark">
        Wir bringen Handwerksbetrieben im Rhein-Main-Gebiet planbare Anfragen – ohne Marketingblabla.{' '}
        <strong>Nur Ergebnisse, die auf Ihrer Rechnung auftauchen.</strong>
      </p>
      <div class="mt-8 flex flex-col items-start gap-2.5 md:flex-row md:items-center">
        <Button href="/kontakt" variant="blue" shadow="blue-glow">Jetzt Potenzial checken lassen</Button>
        <Button href="tel:+491784444156" variant="light">Direkt anrufen – 0178 4444 156</Button>
      </div>
    </div>

    {/* Großes Hochkant-Video rechts */}
    <div class="relative mx-auto mt-10 w-full max-w-[440px] shrink-0 xl:mx-0 xl:mt-0 xl:w-[500px] xl:max-w-none">
      <div class="aspect-[9/16] overflow-hidden rounded-[32px] bg-linear-160 from-video-dark-1 to-video-dark-2">
        {
          hatVideo ? (
            <video
              class="h-full w-full object-cover"
              src="/videos/hero-hochkant.mp4"
              poster={hatPoster ? '/videos/hero-hochkant-poster.jpg' : undefined}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            />
          ) : (
            <div class="flex h-full w-full flex-col items-center justify-center gap-4 px-8 text-center">
              <span class="flex size-[58px] items-center justify-center rounded-full bg-white/14 backdrop-blur-[2px]">
                <svg class="size-[22px] translate-x-px" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M 6.75 3.74 L 6.75 20.26 C 6.755 20.53 6.9 20.77 7.14 20.9 C 7.37 21.03 7.66 21.03 7.89 20.89 L 21.4 12.63 C 21.62 12.49 21.75 12.25 21.75 12 C 21.75 11.74 21.62 11.5 21.4 11.37 L 7.89 3.11 C 7.66 2.97 7.37 2.96 7.14 3.09 C 6.9 3.22 6.755 3.47 6.75 3.74 Z" />
                </svg>
              </span>
              <p class="text-sm font-medium text-white/60">
                Hochkant-Video folgt — Datei nach{' '}
                <code class="text-white/80">public/videos/hero-hochkant.mp4</code> laden
              </p>
            </div>
          )
        }
      </div>

      <div class="absolute right-4 bottom-4 flex items-center gap-3 rounded-full bg-white py-2 pr-5 pl-2 shadow-card">
        <span class="flex size-9 items-center justify-center rounded-full bg-dark">
          <svg class="size-3.5 translate-x-px" viewBox="0 0 24 24" fill="white" aria-hidden="true">
            <path d="M 6.75 3.74 L 6.75 20.26 C 6.755 20.53 6.9 20.77 7.14 20.9 C 7.37 21.03 7.66 21.03 7.89 20.89 L 21.4 12.63 C 21.62 12.49 21.75 12.25 21.75 12 C 21.75 11.74 21.62 11.5 21.4 11.37 L 7.89 3.11 C 7.66 2.97 7.37 2.96 7.14 3.09 C 6.9 3.22 6.755 3.47 6.75 3.74 Z" />
          </svg>
        </span>
        <span class="text-sm leading-tight font-semibold text-dark">
          Einblick in unsere Arbeit
          <span class="block text-xs font-medium text-gray">STOLZ Marketing</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Umgekehrte Kurven am Übergang Panel → Video (nur Desktop-Layout):
     zwei Quadrate direkt über/unter dem überlappenden Panel-Rand, deren
     Radial-Gradient die konkave Rundung in Weiß zeichnet. Das Panel ragt
     112px (xl:-mr-28) ins Video; die Quadrate sitzen an der linken
     Videokante, also 112px vor der Panel-Kante. */
  @media (min-width: 1200px) {
    .shape2-panel::before,
    .shape2-panel::after {
      content: '';
      position: absolute;
      width: 24px;
      height: 24px;
      right: calc(7rem - 24px);
    }
    .shape2-panel::before {
      top: -24px;
      background: radial-gradient(circle at 100% 0, transparent 24px, var(--color-white) 24px);
    }
    .shape2-panel::after {
      bottom: -24px;
      background: radial-gradient(circle at 100% 100%, transparent 24px, var(--color-white) 24px);
    }
  }
</style>
