---
// LEISTUNGEN-VARIANTE A „Zwei Karten": die beiden Säulen als große
// nebeneinanderliegende Karten — Kundengewinnung dunkel, Mitarbeiter-
// gewinnung hell. Nummer, Headline, Kurztext, Werkzeug-Pills, Bild,
// Pfeil-Kreis; die ganze Karte verlinkt auf die Unterseite.
import { Image } from 'astro:assets';
import SectionHeading from '../SectionHeading.astro';
import { saeulen } from '../../data/leistungen';

interface Props {
  /** Anker-ID — auf der Vorschau-Seite überschreiben (sonst doppelt) */
  id?: string;
}
const { id = 'leistungen' } = Astro.props;
---

<section id={id} class="scroll-mt-24 px-5 py-16 md:px-10 md:py-24">
  <div class="mx-auto max-w-[1200px]">
    <SectionHeading label="Leistungen" headingMaxWidth={720}>
      <svg slot="icon" class="size-[7px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <circle cx="12" cy="12" r="10" />
      </svg>
      Zwei Dinge, die jeder Betrieb braucht.
      <Fragment slot="description">
        Kunden und Mitarbeiter. Alles, was wir tun, zahlt auf eines dieser beiden Ziele ein — die
        Werkzeuge dahinter zeigen wir auf den Unterseiten.
      </Fragment>
    </SectionHeading>

    <div class="mt-12 grid grid-cols-1 gap-5 md:mt-16 xl:grid-cols-2">
      {
        saeulen.map((s, i) => {
          const dunkel = i === 0;
          return (
            <a
              href={s.href}
              class={`group relative flex flex-col overflow-hidden rounded-[24px] p-7 transition-transform duration-300 hover:-translate-y-1 md:p-9 ${
                dunkel ? 'bg-dark text-white' : 'bg-bg-soft text-dark'
              }`}
            >
              <span class={`text-sm font-semibold tabular-nums ${dunkel ? 'text-lime' : 'text-blue'}`}>
                {s.nummer}
              </span>
              <h3 class="mt-2 text-3xl font-bold tracking-[-0.04em] md:text-4xl">{s.name}</h3>
              <p class={`mt-3 max-w-[440px] text-base font-medium leading-[1.5] ${dunkel ? 'text-white/70' : 'text-dark/70'}`}>
                {s.kurz}
              </p>
              <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={`Werkzeuge für ${s.name}`}>
                {s.pills.map((pill) => (
                  <li
                    class={`rounded-full border px-3 py-1 text-sm font-medium ${
                      dunkel ? 'border-white/20 text-white/90' : 'border-dark/15 text-dark/80'
                    }`}
                  >
                    {pill}
                  </li>
                ))}
              </ul>
              <div class="mt-7 overflow-hidden rounded-2xl">
                <Image
                  src={s.bild}
                  alt={`Beispiele aus unserer Arbeit: ${s.name}`}
                  widths={[600, 1200]}
                  sizes="(min-width:1200px) 560px, 100vw"
                  class={`aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03] ${s.fokus === 'top' ? 'object-top' : 'object-center'}`}
                />
              </div>
              <span
                class={`absolute top-6 right-6 flex size-11 items-center justify-center rounded-full transition-transform duration-300 group-hover:rotate-45 md:top-8 md:right-8 ${
                  dunkel ? 'bg-lime text-dark' : 'bg-dark text-white'
                }`}
                aria-hidden="true"
              >
                <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 17 17 7M8 7h9v9" />
                </svg>
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
