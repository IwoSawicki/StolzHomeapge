---
/* Hero der Startseite: dunkles Band mit statischer Navigation, Eyebrow,
   H1, Lead, zwei Sekundärbuttons mit Lichtschimmer und der Videofläche,
   die per negativem margin-bottom in die nächste Sektion hineinragt.
   Vorlage: design/STARTSEITE.dc.html, "Hero zentriert"

   Das Showreel ist dasselbe wie im bisherigen Auftritt (Branch main):
   Hochformat 9:16, 22 Sekunden, mit Ton. In der Kachel läuft es stumm
   und endlos, ein Klick öffnet es groß mit Ton — Overlay-Logik ebenfalls
   von dort übernommen.

   Format der Kachel: unter 1040px steht das Video hochkant und füllt die
   Kachel; ab 1040px bleibt es beim Querformat der Vorlage, das Video steht
   darin mittig und der Rest ist eine unscharfe Vergrößerung des Standbilds,
   damit neben dem Hochformat keine tote Fläche entsteht. */
import { getImage } from 'astro:assets';
import Header from '../Header.astro';
import Eyebrow from '../Eyebrow.astro';
import showreel from '../../assets/startseite/stolz-showreel.mp4';
import posterBild from '../../assets/startseite/hero-videopreview.png';

/* Standbild als optimiertes WebP: liegt sofort da, während das Video lädt
   (kein schwarzes Flackern) und ist zugleich der unscharfe Hintergrund. */
const poster = await getImage({
  src: posterBild,
  format: 'webp',
  width: 720,
  quality: 62,
});
---

{/* Standbild früh laden – es ist das LCP-Element der Startseite */}
<link rel="preload" as="image" href={poster.src} type="image/webp" fetchpriority="high" />

<div class="bg-forest">
  <Header />
  <div class="border-b border-edge-soft"></div>

  <section
    class="flex flex-col items-center gap-28 px-20 pt-hero-top text-center"
  >
    <Eyebrow variante="lime">Stolz Marketing</Eyebrow>

    <h1
      class="m-0 max-w-900 text-h1 leading-hero font-bold tracking-heading text-paper"
    >
      <span class="font-display font-semibold tracking-none italic"
        >Volle Auftragsbücher</span
      > &amp; passende Bewerber
    </h1>

    <p class="m-0 max-w-680 text-19 leading-body text-mint">
      Für Handwerksbetriebe, die ihre Wunschprojekte gewinnen, offene Stellen besetzen
      und ihren Betrieb online so zeigen wollen, wie er wirklich ist.
    </p>

    {/* Beide Buttons liegen nebeneinander und brechen erst unter 390px um */}
    <div
      class="flex w-full max-w-560 flex-wrap justify-center gap-10 hero:flex-nowrap"
    >
      <a
        href="/kunden-gewinnen"
        class="relative box-content inline-flex min-h-46 basis-full items-center justify-center overflow-hidden rounded-8 border border-lime-edge bg-lime/7 px-12 py-8 text-center text-14 leading-card font-medium text-cream no-underline transition-colors duration-200 hover:border-lime-edge-hover hover:bg-lime/14 hero:flex-1 hero:basis-0 btn:min-h-52 btn:px-18 btn:py-0 btn:text-16"
      >
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-y-0 left-0 w-[45%] animate-sheen"
          style="background: linear-gradient(100deg, rgb(228 245 63 / 0) 0%, rgb(228 245 63 / 0.22) 50%, rgb(228 245 63 / 0) 100%)"
        ></span>
        Neue Aufträge gewinnen
      </a>
      <a
        href="/mitarbeiter-gewinnen"
        class="relative box-content inline-flex min-h-46 basis-full items-center justify-center overflow-hidden rounded-8 border border-lime-edge bg-lime/7 px-12 py-8 text-center text-14 leading-card font-medium text-cream no-underline transition-colors duration-200 hover:border-lime-edge-hover hover:bg-lime/14 hero:flex-1 hero:basis-0 btn:min-h-52 btn:px-18 btn:py-0 btn:text-16"
      >
        <span
          aria-hidden="true"
          class="pointer-events-none absolute inset-y-0 left-0 w-[45%] animate-sheen"
          style="background: linear-gradient(100deg, rgb(228 245 63 / 0) 0%, rgb(228 245 63 / 0.22) 50%, rgb(228 245 63 / 0) 100%)"
        ></span>
        Neue Mitarbeiter einstellen
      </a>
    </div>

    {/* --- Videofläche ------------------------------------------------- */}
    <div class="relative z-1 mt-32 mb-hero-overlap w-full max-w-440 nav:w-[min(1160px,100%)] nav:max-w-none">
      <div
        class="group relative box-border aspect-[9/16] max-h-[80vh] w-full overflow-hidden rounded-16 border border-edge bg-forest-card nav:aspect-video nav:max-h-none"
      >
        {/* Unscharfe Vergrößerung des Standbilds – nur im Querformat sichtbar */}
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 hidden scale-110 bg-cover bg-center opacity-40 blur-[40px] nav:block"
          style={`background-image: url(${poster.src})`}
        >
        </div>

        <video
          class="relative h-full w-full object-cover nav:object-contain"
          src={showreel}
          poster={poster.src}
          fetchpriority="high"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          data-hero-video
          aria-label="Showreel von Stolz Marketing, läuft stumm"></video>

        {/* Die ganze Kachel öffnet das Showreel groß mit Ton */}
        <button
          type="button"
          data-showreel-open
          class="absolute inset-0 flex cursor-pointer items-center justify-center border-none bg-transparent p-0"
          aria-label="Showreel mit Ton in groß ansehen"
        >
          <span
            class="flex h-88 w-88 items-center justify-center rounded-full bg-lime shadow-glow-play transition-transform duration-200 group-hover:scale-105"
          >
            <span
              aria-hidden="true"
              class="ml-6 h-0 w-0 border-y-14 border-l-22 border-y-transparent border-l-forest-deep"
            ></span>
          </span>
        </button>
      </div>
    </div>
  </section>
</div>

{/* --- Overlay: Showreel groß, Seite dahinter geblurrt ----------------- */}
<div
  data-showreel-modal
  role="dialog"
  aria-modal="true"
  aria-label="Showreel in groß"
  class="fixed inset-0 z-100 hidden items-center justify-center bg-forest-deep/80 p-20 backdrop-blur-lg btn:p-40"
>
  <button
    type="button"
    data-showreel-close
    aria-label="Video schließen"
    class="absolute top-20 right-20 flex h-44 w-44 cursor-pointer items-center justify-center rounded-full border-none bg-paper text-ink transition-transform duration-200 hover:scale-105"
  >
    <svg
      class="h-20 w-20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M6 6l12 12M18 6 6 18"></path>
    </svg>
  </button>
  {/* width/height geben das Seitenverhältnis schon vor dem Laden vor, damit
      der Rahmen beim Öffnen nicht von 300×150 aufspringt. */}
  <video
    data-showreel-video
    class="h-auto w-auto max-h-[85vh] max-w-full rounded-20 bg-forest-deep"
    src={showreel}
    width="800"
    height="1422"
    controls
    playsinline
    preload="none"></video>
</div>

<script>
  // Showreel-Overlay: öffnet das Video groß und mit Ton von vorn;
  // schließen über X, Klick auf den Hintergrund oder Escape.
  const modal = document.querySelector<HTMLElement>('[data-showreel-modal]');
  const video = document.querySelector<HTMLVideoElement>('[data-showreel-video]');
  const oeffnen = document.querySelector<HTMLElement>('[data-showreel-open]');
  const schliessen = document.querySelector<HTMLElement>('[data-showreel-close]');
  let zurueckZu: HTMLElement | null = null;

  function oeffneModal() {
    if (!modal || !video) return;
    zurueckZu = document.activeElement as HTMLElement;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    video.currentTime = 0;
    video.muted = false;
    video.volume = 1;
    void video.play();
    schliessen?.focus();
  }

  function schliesseModal() {
    if (!modal || !video) return;
    video.pause();
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    zurueckZu?.focus();
  }

  oeffnen?.addEventListener('click', oeffneModal);
  schliessen?.addEventListener('click', schliesseModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) schliesseModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) schliesseModal();
  });

  // Autoplay-Anstoß für die Kachel: mobile Browser starten Videos trotz
  // autoplay/muted nicht immer (iOS im Stromsparmodus). Wer „weniger
  // Bewegung" eingestellt hat, bekommt das Standbild statt der Schleife.
  const kachel = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (kachel) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      kachel.removeAttribute('autoplay');
      kachel.pause();
    } else {
      const anspielen = () => {
        if (kachel.paused) kachel.play().catch(() => {});
      };
      anspielen();
      ['touchstart', 'scroll', 'click'].forEach((ev) =>
        window.addEventListener(ev, anspielen, { once: true, passive: true }),
      );
    }
  }
</script>
