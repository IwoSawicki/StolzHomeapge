---
// PROZESS-VARIANTE B – „Große Zeilen" (editorial, Shape-Stil):
// Zentrierter Kopf, darunter 3 breite Zeilen mit riesiger Nummer links,
// Titel + Text mittig, Bild rechts. Trennlinien, Scroll-Reveal je Zeile.
import { Image } from 'astro:assets';
import workshop from '../../assets/prozess-workshop-strategie.png';
import umsetzung from '../../assets/prozess-umsetzung.jpg';
import skalierung from '../../assets/prozess-skalierung-optimierung.png';

const steps = [
  { titel: 'Workshop & Strategie', text: 'Wir lernen Ihr Unternehmen, Ihre Zielgruppe und Ihren Markt kennen — daraus entsteht eine klare Strategie.', bild: workshop, alt: 'Strategie-Workshop bei einem lokalen Betrieb' },
  { titel: 'Umsetzung', text: 'Kampagnen, Landingpages und Inhalte werden umgesetzt. Sie bekommen regelmäßige Updates und den vollen Überblick.', bild: umsetzung, alt: 'Content-Produktion vor Ort' },
  { titel: 'Skalierung & Optimierung', text: 'Nach dem Start optimieren wir laufend — so wird Ihr Marketing mit jedem Monat planbarer.', bild: skalierung, alt: 'Auswertung laufender Kampagnen am Bildschirm' },
];
---

<section class="px-5 py-16 md:px-10 md:py-24">
  <p class="mb-10 text-center text-xs font-medium tracking-wide text-gray uppercase">
    Prozess-Variante B · Große Zeilen (zur Auswahl)
  </p>

  <div class="mx-auto max-w-[1100px]">
    <div class="mx-auto max-w-[640px] text-center" data-reveal>
      <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Prozess</p>
      <h2 class="mt-3 text-4xl font-semibold text-balance leading-[1.08] tracking-[-0.03em] text-dark md:text-5xl">
        Unser Prozess zum Erfolg
      </h2>
    </div>

    <div class="mt-14">
      {
        steps.map((step, i) => (
          <div
            class="grid grid-cols-[auto_1fr] items-center gap-x-6 gap-y-4 border-t border-border py-10 last:border-b md:grid-cols-[auto_1fr_240px] md:gap-x-10 md:py-14"
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
          >
            <span class="text-6xl font-semibold leading-none tracking-[-0.04em] text-blue/20 tabular-nums md:text-8xl">
              0{i + 1}
            </span>
            <div>
              <h3 class="text-2xl font-semibold tracking-[-0.02em] text-dark md:text-3xl">{step.titel}</h3>
              <p class="mt-2 max-w-[520px] text-lg font-medium leading-[1.5] text-dark/60">{step.text}</p>
            </div>
            <div class="col-span-2 aspect-[16/10] overflow-hidden rounded-20 md:col-span-1 md:aspect-[4/3]">
              <Image src={step.bild} alt={step.alt} class="h-full w-full object-cover" widths={[280, 480]} sizes="240px" />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
