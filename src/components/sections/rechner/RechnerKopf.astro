---
/* Kopf der Rechnerseite: Kopfzeile, Überschrift, drei Sätze — dann kommt
   sofort der Rechner.

   Bewusst kein großes Hero-Band mit Bild: wer „was kostet eine offene
   Stelle" sucht, will rechnen und nicht scrollen. Die Vorrede steht nach
   dem Rechner, nicht davor. */
import Header from '../../Header.astro';
import Eyebrow from '../../Eyebrow.astro';
import { hero } from '../../../data/vakanzkostenrechner';
---

<div class="bg-forest">
  <Header />

  <section class="px-page-x pt-40 pb-section-y-sm">
    <div class="mx-auto flex max-w-content flex-col items-start gap-20">
      <Eyebrow variante="lime">Vakanzkosten</Eyebrow>

      <h1
        class="m-0 max-w-860 text-h1-sub leading-tightest font-bold tracking-system text-paper"
      >
        {hero.titelVorn}<span class="font-display font-semibold tracking-none italic"
          >{hero.titelKursiv}</span
        >{hero.titelHinten}
      </h1>

      <p class="m-0 max-w-760 text-19 leading-body text-mint">{hero.lead}</p>
    </div>
  </section>
</div>
