---
/* Der Vakanzkostenrechner.

   Links die Eingaben in vier Gruppen, rechts das Ergebnis, das beim
   Scrollen stehen bleibt. Unterhalb von 1040px rutscht das Ergebnis unter
   die Eingaben, und eine feste Leiste am unteren Rand hält die
   Schadenssumme sichtbar.

   Die größte Zahl ist der Schaden am Betriebsergebnis, in Rot
   (Entscheidung Iwo). Die Build-Spec hatte dafür die Tageszahl
   vorgesehen — die steht jetzt eine Stufe kleiner darunter, damit das
   Argument „das kostet jeden Tag" nicht verlorengeht.

   Drei Entscheidungen, die den Rechner vom Wettbewerb unterscheiden und
   die deshalb nicht wegoptimiert werden dürfen:

     1. Überstunden zählen nur mit dem Zuschlag, nicht mit dem vollen
        Lohn. Sie ersetzen Arbeit, die sonst auch bezahlt worden wäre.
     2. Recruitingkosten stehen nicht im Schaden. Sie hängen nicht von
        der Vakanzdauer ab.
     3. Fahrzeug-Fixkosten nur, wenn der Nutzer aktiv angibt, dass eines
        stillsteht — nicht als stiller Standardwert.

   Gerechnet wird ausschließlich im Browser. Es gibt keinen Endpunkt, und
   die eingegebenen Werte verlassen das Gerät nicht. Der Zustand steht in
   der Adresszeile, damit sich ein Ergebnis verschicken lässt.

   Kein Framework: die Seite setzt durchgehend auf <script> im .astro-File
   (siehe CLAUDE.md). */
import Eyebrow from '../../Eyebrow.astro';
import Button from '../../Button.astro';
import Signet from '../../Signet.astro';
import {
  gewerke,
  GEWERK_STANDARD,
  grenzen,
  hero,
  ergebnisTexte,
  ARBEITSTAGE_PRO_MONAT,
  UEBERSTUNDEN_ZUSCHLAG,
  LOHNNEBENKOSTEN,
} from '../../../data/vakanzkostenrechner';

/* Die Presets wandern als JSON in die Seite, damit das Script sie ohne
   zweite Quelle kennt. */
const konfiguration = {
  gewerke,
  standard: GEWERK_STANDARD,
  grenzen,
  konstanten: {
    arbeitstage: ARBEITSTAGE_PRO_MONAT,
    zuschlag: UEBERSTUNDEN_ZUSCHLAG,
    lohnnebenkosten: LOHNNEBENKOSTEN,
  },
};

const feldKlasse =
  'w-full rounded-10 border border-edge bg-forest px-16 py-13 text-17 font-bold text-cream outline-none transition-colors focus:border-lime-edge';
const labelKlasse = 'text-14 font-medium text-mint-dim';
const gruppeKlasse = 'flex flex-col gap-16 rounded-20 border border-edge bg-forest-card p-24';
/* Die zugeklappten Gruppen: auf schmalen Geräten ist die Zusammenfassung
   ein Knopf mit Rahmen und 52px Höhe — sonst erkennt niemand, dass sich
   da etwas aufklappen lässt. Ab 720px genügt wieder die reine Zeile, und
   die Gruppe bekommt denselben Innenabstand wie die festen Gruppen. */
const aufklappKlasse =
  'flex flex-col gap-16 rounded-20 border border-edge bg-forest-card p-12 btn:p-24';
const summaryKlasse =
  'flex cursor-pointer list-none items-center justify-between gap-16 rounded-12 border border-edge bg-forest px-16 py-14 font-mono text-12 tracking-eyebrow uppercase text-lime transition-colors hover:border-lime-edge btn:border-0 btn:bg-transparent btn:p-0 btn:hover:border-0';
---

<section id="rechner" class="bg-forest px-page-x pt-8 pb-section-y-lg">
  <div class="mx-auto flex max-w-content flex-wrap items-start gap-x-40 gap-y-32">
    {/* ==================== Eingaben ==================== */}
    <form
      id="vk-form"
      class="flex flex-1 basis-[min(520px,100%)] flex-col gap-16"
      novalidate
    >
      {/* --- 1 · Ihre Situation --- */}
      <fieldset class={gruppeKlasse}>
        <legend class="font-mono text-12 tracking-eyebrow uppercase text-lime">
          1 · Ihre Situation
        </legend>

        <div class="grid grid-cols-1 gap-16 btn:grid-cols-2">
          <div class="flex flex-col gap-8">
            <label class={labelKlasse} for="vk-stellen">Offene Stellen</label>
            <input
              class={feldKlasse}
              id="vk-stellen"
              name="stellen"
              type="number"
              inputmode="numeric"
              min={grenzen.stellen.min}
              max={grenzen.stellen.max}
              step="1"
              value={grenzen.stellen.standard}
            />
          </div>

          <div class="flex flex-col gap-8">
            <label class={labelKlasse} for="vk-monate">
              Seit wie vielen Monaten offen?
            </label>
            <input
              class={feldKlasse}
              id="vk-monate"
              name="monate"
              type="number"
              inputmode="numeric"
              min={grenzen.monate.min}
              max={grenzen.monate.max}
              step="1"
              value={grenzen.monate.standard}
            />
          </div>
        </div>

        <input
          class="vk-regler"
          id="vk-monate-regler"
          type="range"
          aria-label="Vakanzdauer in Monaten"
          min={grenzen.monate.min}
          max={grenzen.monate.max}
          step="1"
          value={grenzen.monate.standard}
        />
      </fieldset>

      {/* --- 2 · Ihr Gewerk --- */}
      <fieldset class={gruppeKlasse}>
        <legend class="font-mono text-12 tracking-eyebrow uppercase text-lime">
          2 · Ihr Gewerk
        </legend>
        <div class="flex flex-col gap-8">
          <label class={labelKlasse} for="vk-gewerk">
            Auswählen — die Werte darunter füllen sich von selbst
          </label>
          <select class={feldKlasse} id="vk-gewerk" name="gewerk">
            {
              gewerke.map((g) => (
                <option value={g.schluessel} selected={g.schluessel === GEWERK_STANDARD}>
                  {g.name}
                </option>
              ))
            }
            <option value="eigene">Eigene Werte eingeben</option>
          </select>
        </div>
      </fieldset>

      {/* --- 3 · Feinjustierung --- */}
      <details class={aufklappKlasse} data-vk-gruppe>
        <summary class={summaryKlasse}>
          3 · Feinjustierung
          <span class="vk-pfeil text-19 text-mint-dim" aria-hidden="true">▾</span>
        </summary>

        <div class="flex flex-col gap-20 pt-16 btn:pt-4">
          <div class="flex flex-col gap-8">
            <div class="flex items-baseline justify-between gap-12">
              <label class={labelKlasse} for="vk-satz">Netto-Verrechnungssatz je Stunde</label>
              <output class="text-19 font-bold text-lime" id="vk-satz-wert" for="vk-satz"
              ></output>
            </div>
            <input
              class="vk-regler"
              id="vk-satz"
              type="range"
              min={grenzen.satz.min}
              max={grenzen.satz.max}
              step="1"
            />
          </div>

          <div class="flex flex-col gap-8">
            <div class="flex items-baseline justify-between gap-12">
              <label class={labelKlasse} for="vk-stunden">Produktive Stunden je Monat</label>
              <output class="text-19 font-bold text-lime" id="vk-stunden-wert" for="vk-stunden"
              ></output>
            </div>
            <input
              class="vk-regler"
              id="vk-stunden"
              type="range"
              min={grenzen.stunden.min}
              max={grenzen.stunden.max}
              step="1"
            />
          </div>

          <div class="flex flex-col gap-8">
            <div class="flex items-baseline justify-between gap-12">
              <label class={labelKlasse} for="vk-db">Deckungsbeitrag</label>
              <output class="text-19 font-bold text-lime" id="vk-db-wert" for="vk-db"></output>
            </div>
            <input
              class="vk-regler"
              id="vk-db"
              type="range"
              min={grenzen.db.min}
              max={grenzen.db.max}
              step="1"
            />
          </div>

          <p class="m-0 border-l-2 border-lime-edge pl-16 text-15 leading-body text-mint-dim">
            <strong class="font-bold text-mint">Produktive Stunden</strong> sind die Stunden,
            die Sie tatsächlich abrechnen — nach Abzug von Fahrtzeit, Rüstzeit, Werkstatt und
            Dokumentation. Von rund 165 Arbeitsstunden im Monat bleiben im Handwerk
            realistisch 120 bis 135 übrig.<br /><br />
            <strong class="font-bold text-mint">Deckungsbeitrag</strong> ist, was nach Abzug von
            Material und Lohn vom Umsatz übrig bleibt.
          </p>
        </div>
      </details>

      {/* --- 4 · Zusatzkosten --- */}
      <details class={aufklappKlasse} data-vk-gruppe>
        <summary class={summaryKlasse}>
          <span>4 · Zusatzkosten <span class="text-mint-dim normal-case">(optional)</span></span>
          <span class="vk-pfeil text-19 text-mint-dim" aria-hidden="true">▾</span>
        </summary>

        <div class="flex flex-col gap-16 pt-16 btn:pt-4">
          <label class="flex cursor-pointer items-start gap-12 text-16 text-mint">
            <input
              class="mt-2 h-18 w-18 flex-none accent-lime"
              id="vk-kfz-aktiv"
              type="checkbox"
            />
            Ein Firmenfahrzeug steht ungenutzt
          </label>

          <div class="hidden flex-col gap-8" id="vk-kfz-feld">
            <label class={labelKlasse} for="vk-kfz">Fixkosten dafür je Monat (€)</label>
            <input
              class={feldKlasse}
              id="vk-kfz"
              type="number"
              inputmode="numeric"
              min={grenzen.kfz.min}
              max={grenzen.kfz.max}
              value={grenzen.kfz.standard}
            />
          </div>

          <div class="flex flex-col gap-8">
            <label class={labelKlasse} for="vk-ueberstunden">
              Überstunden, die das Team zusätzlich leistet (h/Monat)
            </label>
            <input
              class={feldKlasse}
              id="vk-ueberstunden"
              type="number"
              inputmode="numeric"
              min={grenzen.ueberstunden.min}
              max={grenzen.ueberstunden.max}
              value={grenzen.ueberstunden.standard}
            />
          </div>

          <div class="hidden flex-col gap-8" id="vk-lohn-feld">
            <label class={labelKlasse} for="vk-lohn">Bruttolohn Geselle je Stunde (€)</label>
            <input
              class={feldKlasse}
              id="vk-lohn"
              type="number"
              inputmode="numeric"
              min={grenzen.bruttolohn.min}
              max={grenzen.bruttolohn.max}
              value={grenzen.bruttolohn.standard}
            />
          </div>

          <div class="flex flex-col gap-8">
            <label class={labelKlasse} for="vk-recruiting">
              Bisherige Recruitingkosten gesamt (€)
            </label>
            <input
              class={feldKlasse}
              id="vk-recruiting"
              type="number"
              inputmode="numeric"
              min={grenzen.recruiting.min}
              max={grenzen.recruiting.max}
              value={grenzen.recruiting.standard}
            />
          </div>

          <p class="m-0 border-l-2 border-lime-edge pl-16 text-15 leading-body text-mint-dim">
            Überstunden zählen mit dem Zuschlag von 25 % plus 21 % Lohnnebenkosten darauf —
            nicht mit dem vollen Lohn. Die Arbeit hätte der fehlende Mitarbeiter sonst
            gemacht, und gekostet hätte sie auch.
          </p>
        </div>
      </details>

      <p class="m-0 px-4 text-14 leading-body text-mint-dim">{hero.hinweisDaten}</p>
    </form>

    {/* ==================== Ergebnis ==================== */}
    <div class="flex flex-1 basis-[min(420px,100%)] flex-col nav:sticky nav:top-24">
      <div
        class="vk-tafel relative isolate flex flex-col gap-24 overflow-hidden rounded-20 border border-lime-edge bg-forest-card p-24"
      >
        {/* Signet als leiser Wasserzeichen-Akzent, wie in „Die Lücken“ */}
        <Signet
          class="pointer-events-none absolute -right-56 -bottom-40 -z-10 w-260 text-lime opacity-[0.045]"
        />

        {/* Schadenssumme — die dominanteste Zahl der Seite */}
        <div class="flex flex-col gap-6" aria-live="polite">
          <span class="font-mono text-12 tracking-eyebrow uppercase text-mint-dim">
            Schaden am Betriebsergebnis
          </span>
          <span
            class="vk-zahl text-h1-sub leading-tightest font-bold tracking-system text-schaden"
            id="vk-gesamt">0 €</span
          >
          <span class="text-18 leading-body text-mint" id="vk-zeitraum"></span>
        </div>

        <div class="h-px w-full bg-edge"></div>

        <div class="flex flex-col gap-14">
          <div class="flex items-baseline justify-between gap-12">
            <span class="text-16 text-mint">Kosten je Arbeitstag</span>
            <span class="vk-zahl text-26 font-bold tracking-name text-schaden" id="vk-pro-tag"
              >0 €</span
            >
          </div>
          <div class="flex items-baseline justify-between gap-12">
            <span class="text-15 text-mint-dim">Entgangener Umsatz</span>
            <span class="vk-zahl text-17 font-bold text-mint" id="vk-umsatz">0 €</span>
          </div>
        </div>

        {/* Aufschlüsselung — gestapelte Balken, keine Diagrammbibliothek */}
        <div class="flex flex-col gap-12" id="vk-aufschluesselung">
          <div
            class="flex h-10 w-full gap-2 overflow-hidden rounded-full border border-edge bg-forest"
            id="vk-balken"
          >
            <span class="h-full rounded-full bg-schaden transition-all duration-300" data-balken="db"
            ></span>
            <span
              class="h-full rounded-full bg-schaden-soft transition-all duration-300"
              data-balken="kfz"></span>
            <span
              class="h-full rounded-full bg-mint-dim transition-all duration-300"
              data-balken="ueber"></span>
          </div>
          <ul class="m-0 flex list-none flex-col gap-8 p-0" id="vk-posten"></ul>
        </div>

        {/* Recruiting steht abgesetzt, nicht in der Summe */}
        <div
          class="hidden flex-col gap-6 rounded-12 border border-dashed border-edge p-16"
          id="vk-recruiting-block"
        >
          <div class="flex items-baseline justify-between gap-12">
            <span class="text-15 text-mint">Ihre bisherigen Recruitingkosten</span>
            <span class="text-17 font-bold text-mint" id="vk-recruiting-wert">0 €</span>
          </div>
          <p class="m-0 text-13 leading-body text-mint-dim">
            {ergebnisTexte.recruitingHinweis}
          </p>
        </div>

        <div class="h-px w-full bg-edge"></div>

        {/* Break-even statt Druck */}
        <div class="flex flex-col gap-10">
          <span class="text-16 leading-body text-mint">
            Wenn Sie die Suche um <strong class="font-bold text-paper" id="vk-wochen">6</strong>{' '}
            Wochen verkürzen, sparen Sie{' '}
            <strong class="vk-zahl font-bold text-lime" id="vk-ersparnis">0 €</strong>.
          </span>
          <input
            class="vk-regler"
            id="vk-verkuerzung"
            type="range"
            aria-label="Verkürzung der Suche in Wochen"
            min={grenzen.verkuerzung.min}
            max={grenzen.verkuerzung.max}
            step="1"
            value={grenzen.verkuerzung.standard}
          />
        </div>

        <p class="m-0 text-13 leading-body text-mint-dim">{ergebnisTexte.konservativ}</p>

        <div class="flex flex-col gap-12">
          <span class="text-16 leading-body text-paper">{ergebnisTexte.ctaTitel}</span>
          <Button href="/kontakt" variante="lime">
            {ergebnisTexte.ctaKnopf}<span class="text-18" aria-hidden="true">→</span>
          </Button>
        </div>
      </div>
    </div>
  </div>

  {/* ==================== Leiste auf schmalen Geräten ==================== */}
  <div
    class="fixed inset-x-0 bottom-0 z-40 border-t border-lime-edge bg-forest-card px-page-x py-12 nav:hidden"
    id="vk-leiste"
    hidden
  >
    <div class="mx-auto flex max-w-content items-center justify-between gap-16">
      <span class="text-14 leading-caption text-mint-dim">
        Schaden am Betriebsergebnis<br />
        <strong class="vk-zahl text-22 font-bold text-schaden" id="vk-leiste-wert">0 €</strong>
      </span>
      <a
        href="#rechner-ergebnis"
        class="rounded-full border border-lime-edge px-16 py-10 text-14 font-bold text-lime"
        id="vk-leiste-knopf">Ergebnis ansehen</a
      >
    </div>
  </div>
</section>

<script is:inline define:vars={{ konfiguration }}>
  window.vkKonfiguration = konfiguration;
</script>

<style>
  /* Regler in Markenfarben. Die Werte kommen aus den Tokens, damit hier
     keine zweite Farbdefinition entsteht. */
  .vk-regler {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 999px;
    background: var(--color-forest);
    border: 1px solid var(--color-edge);
    outline: none;
    cursor: pointer;
  }

  .vk-regler::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--color-lime);
    border: 2px solid var(--color-forest-deep);
    cursor: grab;
  }

  .vk-regler::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--color-lime);
    border: 2px solid var(--color-forest-deep);
    cursor: grab;
  }

  .vk-regler:focus-visible {
    border-color: var(--color-lime);
  }

  /* Die Ergebniszahlen zählen hoch. Ohne feste Ziffernbreite zappelt die
     Zahl dabei hin und her, weil die 1 schmaler ist als die 8. */
  .vk-zahl {
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }

  /* Die Ergebnistafel bekommt einen weichen Schein hinter der großen
     Zahl — sie ist der Grund, warum jemand hier ist. */
  .vk-tafel::before {
    content: '';
    position: absolute;
    top: -30%;
    left: -10%;
    z-index: -1;
    width: 70%;
    aspect-ratio: 1;
    max-width: 100%;
    border-radius: 999px;
    background: radial-gradient(circle, var(--color-schaden) 0%, transparent 70%);
    opacity: 0.14;
    pointer-events: none;
  }

  /* Aufklappbare Gruppen: Pfeil dreht sich mit */
  details[open] .vk-pfeil {
    transform: rotate(180deg);
  }

  .vk-pfeil {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Platz für die feste Leiste, damit sie nichts verdeckt */
  @media (max-width: 1039px) {
    :global(body:has(#vk-leiste:not([hidden]))) {
      padding-bottom: 76px;
    }
  }
</style>

<script>
  /* --------------------------------------------------------------------
     Vakanzkostenrechner — Rechnung und Anzeige.

     Läuft vollständig im Browser. Es gibt keinen Endpunkt, keine
     Übertragung und kein Tracking der eingegebenen Werte.
     -------------------------------------------------------------------- */
  interface Gewerk {
    schluessel: string;
    name: string;
    satz: number;
    stunden: number;
    db: number;
  }
  interface Konfiguration {
    gewerke: Gewerk[];
    standard: string;
    grenzen: Record<string, { min: number; max: number; standard?: number }>;
    konstanten: { arbeitstage: number; zuschlag: number; lohnnebenkosten: number };
  }

  const kfg = (window as unknown as { vkKonfiguration?: Konfiguration }).vkKonfiguration;
  const form = document.getElementById('vk-form');

  if (kfg && form) {
    const euro = new Intl.NumberFormat('de-DE', { maximumFractionDigits: 0 });
    const hole = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    /* Auf dem Desktop stehen die beiden Zusatzgruppen offen — dort ist
       Platz, und wer die Werte sieht, traut dem Ergebnis eher. Auf
       schmalen Geräten bleiben sie zu, sonst scrollt man ewig. Danach
       gehört die Entscheidung dem Nutzer: hier wird nur einmal gesetzt. */
    const NAV_BREITE = 1040;
    document
      .querySelectorAll<HTMLDetailsElement>('[data-vk-gruppe]')
      .forEach((d) => (d.open = window.innerWidth >= NAV_BREITE));

    const feld = {
      stellen: hole<HTMLInputElement>('vk-stellen'),
      monate: hole<HTMLInputElement>('vk-monate'),
      monateRegler: hole<HTMLInputElement>('vk-monate-regler'),
      gewerk: hole<HTMLSelectElement>('vk-gewerk'),
      satz: hole<HTMLInputElement>('vk-satz'),
      stunden: hole<HTMLInputElement>('vk-stunden'),
      db: hole<HTMLInputElement>('vk-db'),
      kfzAktiv: hole<HTMLInputElement>('vk-kfz-aktiv'),
      kfz: hole<HTMLInputElement>('vk-kfz'),
      ueberstunden: hole<HTMLInputElement>('vk-ueberstunden'),
      lohn: hole<HTMLInputElement>('vk-lohn'),
      recruiting: hole<HTMLInputElement>('vk-recruiting'),
      verkuerzung: hole<HTMLInputElement>('vk-verkuerzung'),
    };

    /** Wert einlesen und auf die erlaubten Grenzen ziehen. */
    const zahl = (el: HTMLInputElement, schluessel: string) => {
      const g = kfg.grenzen[schluessel];
      const roh = Number.parseFloat(el.value.replace(',', '.'));
      if (!Number.isFinite(roh)) return g?.standard ?? g?.min ?? 0;
      if (!g) return roh;
      return Math.min(g.max, Math.max(g.min, roh));
    };

    /* --- Zahlen zählen beim Wechsel hoch, statt zu springen ----------- */
    const laufend = new WeakMap<HTMLElement, number>();
    const setzeZahl = (el: HTMLElement, ziel: number, einheit = ' €') => {
      const start = laufend.get(el) ?? 0;
      if (start === ziel) return;
      laufend.set(el, ziel);
      const dauer = 400;
      const beginn = performance.now();
      const schritt = (jetzt: number) => {
        const t = Math.min(1, (jetzt - beginn) / dauer);
        const weich = 1 - Math.pow(1 - t, 3);
        el.textContent = euro.format(Math.round(start + (ziel - start) * weich)) + einheit;
        if (t < 1 && laufend.get(el) === ziel) requestAnimationFrame(schritt);
      };
      requestAnimationFrame(schritt);
    };

    /* --- Gewerk setzt die Feinjustierung ------------------------------ */
    const gewerkAnwenden = (schluessel: string) => {
      const g = kfg.gewerke.find((x) => x.schluessel === schluessel);
      if (!g) return;
      feld.satz.value = String(g.satz);
      feld.stunden.value = String(g.stunden);
      feld.db.value = String(g.db);
    };

    /* --- Adresszeile: Zustand lesen und schreiben --------------------- */
    const ausAdresse = () => {
      const p = new URLSearchParams(window.location.search);
      const setze = (el: HTMLInputElement, name: string) => {
        const v = p.get(name);
        if (v !== null && v !== '') el.value = v;
      };
      const gewerk = p.get('gewerk');
      if (gewerk && (gewerk === 'eigene' || kfg.gewerke.some((g) => g.schluessel === gewerk))) {
        feld.gewerk.value = gewerk;
      }
      gewerkAnwenden(feld.gewerk.value);
      setze(feld.stellen, 'stellen');
      setze(feld.monate, 'monate');
      setze(feld.satz, 'satz');
      setze(feld.stunden, 'stunden');
      setze(feld.db, 'db');
      setze(feld.ueberstunden, 'ueberstunden');
      setze(feld.lohn, 'lohn');
      setze(feld.recruiting, 'recruiting');
      setze(feld.verkuerzung, 'verkuerzung');
      if (p.get('kfz') === '1') {
        feld.kfzAktiv.checked = true;
        setze(feld.kfz, 'kfzkosten');
      }
    };

    let adresseTimer = 0;
    const inAdresse = () => {
      window.clearTimeout(adresseTimer);
      adresseTimer = window.setTimeout(() => {
        const p = new URLSearchParams();
        p.set('gewerk', feld.gewerk.value);
        p.set('stellen', feld.stellen.value);
        p.set('monate', feld.monate.value);
        p.set('satz', feld.satz.value);
        p.set('stunden', feld.stunden.value);
        p.set('db', feld.db.value);
        if (feld.kfzAktiv.checked) {
          p.set('kfz', '1');
          p.set('kfzkosten', feld.kfz.value);
        }
        if (zahl(feld.ueberstunden, 'ueberstunden') > 0) {
          p.set('ueberstunden', feld.ueberstunden.value);
          p.set('lohn', feld.lohn.value);
        }
        if (zahl(feld.recruiting, 'recruiting') > 0) p.set('recruiting', feld.recruiting.value);
        p.set('verkuerzung', feld.verkuerzung.value);
        history.replaceState(null, '', '?' + p.toString());
      }, 400);
    };

    /* --- Die Rechnung ------------------------------------------------- */
    const rechnen = () => {
      const stellen = zahl(feld.stellen, 'stellen');
      const monate = zahl(feld.monate, 'monate');
      const satz = zahl(feld.satz, 'satz');
      const stunden = zahl(feld.stunden, 'stunden');
      const db = zahl(feld.db, 'db');
      const ueberstunden = zahl(feld.ueberstunden, 'ueberstunden');
      const lohn = zahl(feld.lohn, 'bruttolohn');
      const recruiting = zahl(feld.recruiting, 'recruiting');
      const verkuerzung = zahl(feld.verkuerzung, 'verkuerzung');

      const umsatz = stellen * monate * stunden * satz;
      const dbVerlust = umsatz * (db / 100);
      const fixkosten = feld.kfzAktiv.checked ? zahl(feld.kfz, 'kfz') * monate : 0;
      const ueberMehr =
        ueberstunden *
        monate *
        lohn *
        kfg.konstanten.zuschlag *
        (1 + kfg.konstanten.lohnnebenkosten);

      const gesamt = dbVerlust + fixkosten + ueberMehr;
      const proTag = gesamt / (monate * kfg.konstanten.arbeitstage);
      const ersparnis = proTag * verkuerzung * 5;

      /* --- Anzeige --- */
      setzeZahl(hole('vk-pro-tag'), Math.round(proTag));
      setzeZahl(hole('vk-gesamt'), Math.round(gesamt));
      setzeZahl(hole('vk-umsatz'), Math.round(umsatz));
      setzeZahl(hole('vk-leiste-wert'), Math.round(gesamt));
      setzeZahl(hole('vk-ersparnis'), Math.round(ersparnis));
      hole('vk-wochen').textContent = String(verkuerzung);
      hole('vk-zeitraum').textContent =
        'in ' + monate + (monate === 1 ? ' Monat' : ' Monaten');

      hole<HTMLOutputElement>('vk-satz-wert').textContent = euro.format(satz) + ' €';
      hole<HTMLOutputElement>('vk-stunden-wert').textContent = euro.format(stunden) + ' h';
      hole<HTMLOutputElement>('vk-db-wert').textContent = euro.format(db) + ' %';

      /* Balken und Liste: nur Posten über null */
      const posten = [
        { name: 'Verlorener Deckungsbeitrag', wert: dbVerlust, balken: 'db' },
        { name: 'Fixkosten Fahrzeug', wert: fixkosten, balken: 'kfz' },
        { name: 'Überstunden-Mehrkosten', wert: ueberMehr, balken: 'ueber' },
      ];
      posten.forEach((p) => {
        const el = document.querySelector<HTMLElement>(`[data-balken="${p.balken}"]`);
        if (el) el.style.width = gesamt > 0 ? (p.wert / gesamt) * 100 + '%' : '0%';
      });

      const liste = hole('vk-posten');
      liste.innerHTML = '';
      posten
        .filter((p) => p.wert > 0)
        .forEach((p) => {
          const li = document.createElement('li');
          li.className = 'flex items-baseline justify-between gap-12 text-15 text-mint-dim';
          const name = document.createElement('span');
          name.textContent = p.name;
          const wert = document.createElement('span');
          wert.className = 'font-bold text-mint';
          wert.textContent = euro.format(Math.round(p.wert)) + ' €';
          li.append(name, wert);
          liste.append(li);
        });

      /* Recruiting getrennt, nur wenn angegeben */
      const rBlock = hole('vk-recruiting-block');
      rBlock.classList.toggle('hidden', recruiting <= 0);
      rBlock.classList.toggle('flex', recruiting > 0);
      if (recruiting > 0) setzeZahl(hole('vk-recruiting-wert'), Math.round(recruiting));

      /* Folgefelder nur zeigen, wenn sie gebraucht werden */
      const kfzFeld = hole('vk-kfz-feld');
      kfzFeld.classList.toggle('hidden', !feld.kfzAktiv.checked);
      kfzFeld.classList.toggle('flex', feld.kfzAktiv.checked);
      const lohnFeld = hole('vk-lohn-feld');
      lohnFeld.classList.toggle('hidden', ueberstunden <= 0);
      lohnFeld.classList.toggle('flex', ueberstunden > 0);

      inAdresse();
    };

    /* --- Verdrahtung -------------------------------------------------- */
    feld.gewerk.addEventListener('change', () => {
      gewerkAnwenden(feld.gewerk.value);
      rechnen();
    });

    /* Wer die Feinjustierung anfasst, hat eigene Werte. */
    [feld.satz, feld.stunden, feld.db].forEach((el) =>
      el.addEventListener('input', () => {
        feld.gewerk.value = 'eigene';
        rechnen();
      }),
    );

    /* Monatsfeld und Monatsregler halten sich gegenseitig aktuell. */
    feld.monate.addEventListener('input', () => {
      feld.monateRegler.value = String(zahl(feld.monate, 'monate'));
      rechnen();
    });
    feld.monateRegler.addEventListener('input', () => {
      feld.monate.value = feld.monateRegler.value;
      rechnen();
    });

    form.addEventListener('input', rechnen);
    form.addEventListener('submit', (e) => e.preventDefault());
    feld.verkuerzung.addEventListener('input', rechnen);

    /* Grenzen erst beim Verlassen erzwingen — sonst lässt sich im Feld
       nichts mehr tippen, weil jede Zwischenzahl korrigiert würde. */
    Object.entries({
      stellen: feld.stellen,
      monate: feld.monate,
      kfz: feld.kfz,
      ueberstunden: feld.ueberstunden,
      bruttolohn: feld.lohn,
      recruiting: feld.recruiting,
    }).forEach(([schluessel, el]) => {
      el.addEventListener('blur', () => {
        el.value = String(zahl(el, schluessel));
        rechnen();
      });
    });

    ausAdresse();
    rechnen();

    /* Feste Leiste erst zeigen, wenn das Ergebnis aus dem Bild ist. */
    const leiste = hole('vk-leiste');
    const panel = document.getElementById('vk-gesamt');
    if (panel && 'IntersectionObserver' in window) {
      const beobachter = new IntersectionObserver(
        ([eintrag]) => {
          leiste.hidden = eintrag.isIntersecting;
        },
        { threshold: 0 },
      );
      beobachter.observe(panel);
    }
    hole('vk-leiste-knopf').addEventListener('click', (e) => {
      e.preventDefault();
      panel?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
</script>
