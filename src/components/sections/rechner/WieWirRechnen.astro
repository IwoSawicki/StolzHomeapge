---
/* „Wie wir rechnen" — die Formel offen dargelegt.

   Das ist kein Betriebsgeheimnis, sondern das eigentliche Argument: Wer
   nachrechnen kann, glaubt das Ergebnis. Und es ist der Ort, an dem die
   drei konservativen Entscheidungen begründet werden, die den Rechner
   vom Wettbewerb unterscheiden. */
import Eyebrow from '../../Eyebrow.astro';
import { rechenschritte } from '../../../data/vakanzkostenrechner';
---

<section id="rechenweg" class="bg-paper-soft px-page-x py-section-y-lg">
  <div class="mx-auto flex max-w-content flex-col gap-40">
    <div class="flex max-w-760 flex-col items-start gap-18">
      <Eyebrow variante="hell">Der Rechenweg</Eyebrow>
      <h2 class="m-0 text-h2-sub leading-tightest font-bold tracking-system text-ink">
        Wir legen die Formel <span
          class="font-display font-semibold tracking-none italic">offen</span
        >
      </h2>
      <p class="m-0 max-w-660 text-18 leading-quote text-ink-muted">
        Jeder Schritt einzeln, damit Sie prüfen können, ob die Zahl zu Ihrem Betrieb passt.
      </p>
    </div>

    <ol class="m-0 grid list-none grid-cols-1 gap-16 p-0 btn:grid-cols-2">
      {
        rechenschritte.map((schritt, i) => (
          <li class="flex flex-col gap-12 rounded-20 border border-line bg-paper px-28 py-26">
            <div class="flex items-baseline gap-12">
              <span class="font-mono text-13 text-ink-label" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-21 leading-card font-bold tracking-heading text-ink">
                {schritt.titel}
              </span>
            </div>
            <code
              class="rounded-10 bg-paper-grey px-14 py-10 font-mono text-14 leading-body text-ink-body"
            >
              {schritt.formel}
            </code>
            <p class="m-0 text-17 leading-body text-ink-quiet">{schritt.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
