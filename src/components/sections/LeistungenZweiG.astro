---
// LEISTUNGEN-VARIANTE G „Bento wie damals": die alte „Warum wir?"-
// Sektion aus der ersten Framer-Version (heller Bento-Container mit
// weißen Karten, Radius 30, shadow-stack), reduziert auf die zwei
// Säulen und mit Link auf die neuen Unterseiten. Texte = Original.
import { Image } from 'astro:assets';
import SectionHeading from '../SectionHeading.astro';
import kundengewinnung from '../../assets/leistung-kundengewinnung.png';
import mitarbeitergewinnung from '../../assets/leistung-mitarbeitergewinnung.png';

interface Props {
  /** Anker-ID — auf der Vorschau-Seite überschreiben (sonst doppelt) */
  id?: string;
}
const { id = 'leistungen' } = Astro.props;
---

<section id={id} class="scroll-mt-24 px-3 py-12 md:px-10 md:py-25">
  <SectionHeading label="Warum wir?" headingMaxWidth={800}>
    Wir bauen, was funktioniert. Den Rest lassen wir weg.
  </SectionHeading>

  <div class="mx-auto mt-15 grid max-w-[1200px] grid-cols-1 gap-2 rounded-30 bg-bg-soft p-5 shadow-stack xl:grid-cols-2">
    <!-- Karte 1: Kundengewinnung (Bild unten mittig, wie die hohe Original-Karte) -->
    <a
      href="/leistungen/kundengewinnung"
      class="group flex flex-col rounded-30 border border-border bg-white transition-shadow duration-300 hover:shadow-card-soft"
    >
      <div class="p-5">
        <h3 class="text-2xl font-medium leading-[1.3] tracking-[-0.03em] text-dark">Kundengewinnung</h3>
        <p class="mt-[7px] text-15 font-medium tracking-[-0.02em] text-dark/60">
          Google- und Meta-Kampagnen, die Menschen erreichen, die aktiv nach Ihrer Leistung suchen oder kurz vor
          einer Entscheidung stehen. Mit passender Landingpage, damit aus Klicks echte Anfragen werden.
        </p>
        <span class="mt-3 inline-flex items-center gap-1.5 text-15 font-semibold text-blue">
          Mehr erfahren
          <svg class="size-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </span>
      </div>
      <Image
        src={kundengewinnung}
        alt="Smartphone-Ansicht einer Werbekampagne zur Kundengewinnung für Handwerksbetriebe"
        class="mx-auto mt-auto w-[156px] shrink-0 md:w-[205px] xl:w-[232px]"
        widths={[232, 464, 645]}
        sizes="232px"
      />
    </a>

    <!-- Karte 2: Mitarbeitergewinnung -->
    <a
      href="/leistungen/mitarbeitergewinnung"
      class="group flex flex-col rounded-30 border border-border bg-white transition-shadow duration-300 hover:shadow-card-soft"
    >
      <div class="p-5">
        <h3 class="text-2xl font-medium leading-[1.3] tracking-[-0.03em] text-dark">Mitarbeitergewinnung</h3>
        <p class="mt-[7px] text-15 font-medium tracking-[-0.02em] text-dark/60">
          Kampagnen, die passende Fachkräfte erreichen – auch dann, wenn sie nicht aktiv auf Jobsuche sind. Mit
          Bewerbungsseite, die schnell Vertrauen schafft und die Hürde zur Anfrage senkt.
        </p>
        <span class="mt-3 inline-flex items-center gap-1.5 text-15 font-semibold text-blue">
          Mehr erfahren
          <svg class="size-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </span>
      </div>
      <div class="mt-auto px-5 pb-5">
        <Image
          src={mitarbeitergewinnung}
          alt="Anzeige zur Mitarbeitergewinnung mit Bewerbungsseite für Fachkräfte"
          class="h-[220px] w-full rounded-14 object-cover object-top"
          widths={[540, 1080]}
          sizes="(min-width:1200px) 540px, 100vw"
        />
      </div>
    </a>
  </div>
</section>
