---
// KUNDEN-LOGOWAND: fünfspaltiges Raster, bewusst ohne Überschrift —
// die Wand steht für sich (Startseite und /projekte).
// Zellen ohne hinterlegtes Logo zeigen den Kundennamen als Wortmarke —
// Logos werden in src/data/kundenlogos.ts nach und nach ergänzt.
// Logos laufen in Graustufen und werden beim Hover farbig, damit die
// Wand ruhig bleibt und nicht mit der Seite konkurriert.
import { Image } from 'astro:assets';
import { kunden } from '../../data/kundenlogos';
---

<section class="px-5 py-16 md:px-10 md:py-24">
  <div class="mx-auto max-w-[1200px]">
    <ul
      class="grid grid-cols-2 gap-2 md:grid-cols-3 md:gap-2.5 xl:grid-cols-5"
      aria-label="Kunden von STOLZ Marketing"
    >
      {
        kunden.map((kunde) => (
          <li class="group flex aspect-[3/2] items-center justify-center rounded-20 border border-border bg-white px-4 transition-colors duration-300 hover:border-border-gray hover:bg-bg-soft">
            {kunde.logo ? (
              <Image
                src={kunde.logo}
                alt={`Logo ${kunde.name}`}
                widths={[220, 440]}
                sizes="200px"
                class="max-h-[52px] w-auto max-w-full object-contain opacity-70 grayscale transition duration-300 group-hover:opacity-100 group-hover:grayscale-0"
              />
            ) : (
              <span class="text-center text-sm font-semibold text-balance tracking-[-0.02em] text-dark/45 transition-colors duration-300 group-hover:text-dark md:text-base">
                {kunde.name}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
