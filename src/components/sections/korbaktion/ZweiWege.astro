---
/* Zwei Karten statt einer Leistungsliste.

   Der Chef soll in einem Blick erkennen, welche der beiden Fragen seine
   ist — fehlen Aufträge oder fehlen Leute. Die Karten sind deshalb nach
   seinem Problem benannt, nicht nach unserer Leistung; der Systemname
   steht erst im Link.

   Die Landingpage erklärt beides absichtlich nicht zu Ende: dafür gibt es
   die Leistungsseiten, und ein Klick dorthin ist ein besseres Signal als
   ein längerer Text hier. */
import Eyebrow from '../../Eyebrow.astro';
import { wege } from '../../../data/korbaktion';
---

<section class="bg-paper px-page-x py-section-y-lg">
  <div class="mx-auto flex max-w-content flex-col gap-40">
    <div class="flex max-w-760 flex-col items-start gap-18">
      <Eyebrow variante="hell">Zwei Wege</Eyebrow>
      <h2 class="m-0 text-h2-sub leading-tightest font-bold tracking-system text-ink">
        Was klemmt bei Ihnen <span
          class="font-display font-semibold tracking-none italic">gerade</span
        >?
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-16 btn:grid-cols-2">
      {
        wege.map((weg) => (
          <div class="flex flex-col items-start gap-14 rounded-20 border border-line bg-paper-soft px-28 py-26">
            <span class="font-mono text-12 tracking-eyebrow uppercase text-ink-label">
              {weg.eyebrow}
            </span>
            <span class="text-22 leading-card font-bold tracking-heading text-ink">
              {weg.titel}
            </span>
            <p class="m-0 text-17 leading-body text-ink-quiet">{weg.text}</p>
            <a
              href={weg.href}
              class="mt-auto pt-6 text-16 font-bold text-ink underline decoration-line-strong underline-offset-4 transition-colors hover:decoration-ink"
            >
              {weg.linkText} →
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
