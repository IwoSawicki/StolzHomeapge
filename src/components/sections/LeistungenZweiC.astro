---
// LEISTUNGEN-VARIANTE C „Bild-Panels": zwei hohe Bild-Kacheln mit
// dunklem Verlauf, Text unten auf dem Bild, Werkzeug-Chips in Glas-Optik,
// Lime-Pfeil oben rechts. Beim Hover zoomt das Bild leicht.
import { Image } from 'astro:assets';
import SectionHeading from '../SectionHeading.astro';
import { saeulen } from '../../data/leistungen';

interface Props {
  /** Anker-ID — auf der Vorschau-Seite überschreiben (sonst doppelt) */
  id?: string;
}
const { id = 'leistungen' } = Astro.props;
---

<section id={id} class="scroll-mt-24 px-5 py-16 md:px-10 md:py-24">
  <div class="mx-auto max-w-[1200px]">
    <SectionHeading label="Leistungen" headingMaxWidth={720}>
      <svg slot="icon" class="size-[7px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <circle cx="12" cy="12" r="10" />
      </svg>
      Zwei Dinge, die jeder Betrieb braucht.
      <Fragment slot="description">
        Kunden und Mitarbeiter. Alles, was wir tun, zahlt auf eines dieser beiden Ziele ein — die
        Werkzeuge dahinter zeigen wir auf den Unterseiten.
      </Fragment>
    </SectionHeading>

    <div class="mt-12 grid grid-cols-1 gap-5 md:mt-16 xl:grid-cols-2">
      {
        saeulen.map((s) => (
          <a href={s.href} class="group relative block overflow-hidden rounded-[24px]">
            <Image
              src={s.bild}
              alt={`Beispiele aus unserer Arbeit: ${s.name}`}
              widths={[600, 1200]}
              sizes="(min-width:1200px) 590px, 100vw"
              class={`aspect-[4/4.4] w-full object-cover transition-transform duration-500 group-hover:scale-[1.04] md:aspect-[4/3] xl:aspect-[4/4.2] ${s.fokus === 'top' ? 'object-top' : 'object-center'}`}
            />
            <span class="absolute inset-0 bg-gradient-to-t from-dark/90 via-dark/35 to-dark/5" aria-hidden="true" />
            <span
              class="absolute top-5 right-5 flex size-11 items-center justify-center rounded-full bg-lime text-dark transition-transform duration-300 group-hover:rotate-45 md:top-6 md:right-6"
              aria-hidden="true"
            >
              <svg class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17 17 7M8 7h9v9" />
              </svg>
            </span>
            <span class="absolute right-0 bottom-0 left-0 flex flex-col items-start p-6 md:p-8">
              <span class="text-sm font-semibold text-lime tabular-nums">{s.nummer}</span>
              <span class="mt-1 text-3xl font-bold tracking-[-0.04em] text-white md:text-4xl">{s.name}</span>
              <span class="mt-2 max-w-[440px] text-base font-medium leading-[1.5] text-white/80">{s.kurz}</span>
              <span class="mt-4 flex flex-wrap gap-1.5">
                {s.pills.map((pill) => (
                  <span class="rounded-full bg-white/14 px-3 py-1 text-sm font-medium text-white backdrop-blur-sm">
                    {pill}
                  </span>
                ))}
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
