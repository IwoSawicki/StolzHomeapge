---
/* „Auch ChatGPT & Co. empfehlen Betriebe": dunkles Band, links Text und
   drei Punkte, rechts ein angedeuteter KI-Chat.

   Der Chat ist ausdrücklich ein Beispiel („Ihr Betrieb" statt eines
   Namens) und trägt den Hinweis, dass er keine Zusage ist. Er spielt
   einmal ab, sobald er ins Bild kommt: erst die Frage, dann drei Punkte
   wie beim Tippen, dann die Antwort. Ohne Bewegung steht er fertig da. */
import Eyebrow from '../../Eyebrow.astro';
import { ki } from '../../../data/seo-ki-sichtbarkeit';
---

<section class="relative overflow-hidden bg-forest px-page-x py-section-y-md">
  <div
    class="pointer-events-none absolute right-0 bottom-0 h-420 w-420 translate-x-1/3 translate-y-1/3 rounded-full opacity-30 blur-[90px]"
    style="background: radial-gradient(circle, var(--color-lime) 0%, transparent 70%)"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto flex max-w-content flex-wrap items-center gap-x-64 gap-y-48">
    <div class="flex flex-1 basis-[min(440px,100%)] flex-col items-start gap-20">
      <Eyebrow variante="lime">{ki.eyebrow}</Eyebrow>
      <h2 class="m-0 text-h2-sub leading-tightest font-bold tracking-system text-paper">
        {ki.titelVorn}<span class="font-display font-semibold tracking-none italic"
          >{ki.titelKursiv}</span
        >{ki.titelHinten}
      </h2>
      {ki.absaetze.map((a) => <p class="m-0 text-18 leading-prose text-mint">{a}</p>)}
      <ul class="m-0 mt-4 flex list-none flex-col gap-12 p-0">
        {
          ki.punkte.map((punkt) => (
            <li class="flex items-start gap-12 text-17 leading-body text-cream">
              <span class="mt-2 flex h-22 w-22 flex-none items-center justify-center rounded-full bg-lime text-forest-deep" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="w-12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12.5l4.5 4.5L19 7.5" />
                </svg>
              </span>
              {punkt}
            </li>
          ))
        }
      </ul>
    </div>

    {/* --- angedeuteter KI-Chat --- */}
    <figure class="m-0 flex flex-1 basis-[min(420px,100%)] flex-col gap-12" data-chat>
      <div class="flex flex-col gap-14 rounded-20 border border-edge bg-forest-deep p-[clamp(16px,3vw,24px)]">
        {/* Frage */}
        <p class="chat-frage m-0 max-w-[85%] self-end rounded-16 rounded-br-4 bg-forest-card px-16 py-12 text-16 leading-body text-cream">
          {ki.frage}
        </p>

        {/* Antwort */}
        <div class="flex items-start gap-10">
          <span class="flex h-30 w-30 flex-none items-center justify-center rounded-full bg-lime text-forest-deep" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="w-16" fill="currentColor">
              <path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8z" />
            </svg>
          </span>
          <div class="relative min-w-0 flex-1">
            <span class="chat-tippen absolute top-12 left-16 flex gap-4" aria-hidden="true">
              <span class="h-6 w-6 rounded-full bg-mint"></span>
              <span class="h-6 w-6 rounded-full bg-mint"></span>
              <span class="h-6 w-6 rounded-full bg-mint"></span>
            </span>
            <p class="chat-antwort m-0 rounded-16 rounded-tl-4 bg-paper px-16 py-12 text-16 leading-body text-ink">
              {ki.antwortVorn}<span class="marker font-bold">{ki.antwortName}</span>{ki.antwortHinten}
            </p>
          </div>
        </div>
      </div>
      <figcaption class="text-13 text-mint-dim">{ki.beispielHinweis}</figcaption>
    </figure>
  </div>
</section>

<style>
  /* Grundzustand ohne Skript: alles sichtbar. Erst wenn das Skript die
     Abspielklasse setzt, startet die Folge Frage → Tippen → Antwort. */
  [data-chat].spielt .chat-frage {
    animation: chat-rein 0.5s ease-out both;
  }
  [data-chat].spielt .chat-tippen {
    animation: chat-tippen 1.6s ease-in-out 0.6s both;
  }
  [data-chat].spielt .chat-antwort {
    animation: chat-rein 0.6s ease-out 2.1s both;
  }
  .chat-tippen {
    opacity: 0;
  }
  @keyframes chat-rein {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes chat-tippen {
    0% {
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
</style>

<script>
  const chat = document.querySelector<HTMLElement>('[data-chat]');
  if (chat && 'IntersectionObserver' in window) {
    const beobachter = new IntersectionObserver(
      (eintraege) => {
        if (eintraege.some((e) => e.isIntersecting)) {
          chat.classList.add('spielt');
          beobachter.disconnect();
        }
      },
      { threshold: 0.5 },
    );
    beobachter.observe(chat);
  }
</script>
