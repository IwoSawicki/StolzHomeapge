---
/* Logo-Marquee mit Caption darüber, in zwei Ausprägungen:

   startseite – davor der Farbverlauf Dunkelgrün → Weiß, der die
                überlappende Videofläche des Heros auffängt
   hell       – ohne Verlauf, direkt unter dem Hero der Projekte-Seite

   Vorlage: design/STARTSEITE.dc.html bzw. design/Projekte.dc.html */
import LogoRail from '../LogoRail.astro';

interface Props {
  variante?: 'startseite' | 'hell';
}
const { variante = 'startseite' } = Astro.props;
---

{
  variante === 'startseite' && (
    <div
      class="h-[clamp(196px,calc(28vw+96px),422px)]"
      style="background: linear-gradient(180deg, var(--color-forest) 0%, var(--color-paper) clamp(110px, 15vw, 220px))"
    />
  )
}

<div
  class:list={[
    'flex flex-col items-center gap-20 bg-paper px-24',
    variante === 'startseite' ? 'pt-8' : 'pb-[clamp(48px,6vw,72px)]',
  ]}
>
  <p class="m-0 text-center text-14 font-medium tracking-caps uppercase text-ink-muted">
    50+ Partnerbetriebe vertrauen uns seit 2022
  </p>
  <LogoRail class="mx-auto w-[min(1160px,100%)]" />
</div>
