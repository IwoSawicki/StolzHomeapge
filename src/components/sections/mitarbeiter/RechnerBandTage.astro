---
/* Rechner-Band, Entwurf B „Tagesbalken".

   Anderer Zuschnitt als Entwurf A: kein Zeichen neben dem Text, sondern
   eine breite, flache Karte, deren rechte Hälfte das Bild IST. Zwanzig
   Balken stehen für vier Arbeitswochen. Sie wachsen nacheinander von
   links nach rechts und färben sich dabei von Limette nach Rot — der
   Schaden, der sich Tag für Tag aufbaut.

   Keine Zahl an den Balken, keine Achse: Es ist ein Bild, kein zweiter
   Rechner, und die Höhen sind frei gewählt und stehen für nichts. */
import Eyebrow from '../../Eyebrow.astro';
import Button from '../../Button.astro';

const TAGE = 20;

/* Die Balken wachsen gleichmäßig an, mit leichtem Auf und Ab — eine
   glatte Rampe sähe aus wie ein Diagramm und würde Genauigkeit
   behaupten, die es nicht gibt. */
const zacken = [0, 0.04, -0.03, 0.05, -0.02, 0.03, -0.04, 0.02, 0.05, -0.03];
const balken = Array.from({ length: TAGE }, (_, i) => {
  const anteil = (i + 1) / TAGE;
  return {
    /* 22 % bis 100 % der Feldhöhe */
    hoehe: Math.round((0.22 + anteil * 0.78 + zacken[i % zacken.length]) * 100),
    /* über die Reihe von Limette nach Rot */
    mischung: Math.round(anteil * 100),
    /* Startversatz: gut eine Sekunde über die ganze Reihe */
    verzoegerung: (i * 0.07).toFixed(2),
  };
});
---

<section class="bg-paper px-page-x pt-0 pb-section-y-sm">
  <div class="relative mx-auto max-w-content">
    <div
      class="relative flex flex-wrap items-center gap-x-56 gap-y-32 overflow-hidden rounded-band bg-forest px-innen-block py-32 btn:py-40"
    >
      {/* --- Text --- */}
      <div class="flex flex-1 basis-[min(400px,100%)] flex-col items-start gap-20">
        <Eyebrow variante="lime">Vakanzkosten</Eyebrow>

        <h2 class="m-0 text-h2-sub leading-tightest font-bold tracking-system text-paper">
          Was kostet Sie die offene Stelle, <span
            class="font-display font-semibold tracking-none italic">während Sie suchen</span
          >?
        </h2>

        <p class="m-0 max-w-620 text-18 leading-quote text-mint">
          Eine unbesetzte Stelle kostet nicht erst, wenn jemand kündigt. Sie kostet jeden
          Arbeitstag, an dem die Arbeit liegen bleibt oder das Team sie mitmacht. Im
          Rechner sehen Sie die Zahl für Ihr Gewerk — in unter einer Minute, ohne Eingabe
          von Kontaktdaten.
        </p>

        <Button href="/vakanzkostenrechner" variante="lime" sheen class="mt-4">
          Zum Vakanzkosten-Rechner<span class="text-18" aria-hidden="true">→</span>
        </Button>
      </div>

      {/* --- Balkenfeld --- */}
      {/* `basis` statt fester Breite: unter 720px rutscht das Feld unter
          den Text und läuft dort über die volle Breite. */}
      <div class="flex flex-1 basis-[min(320px,100%)] flex-col gap-14" aria-hidden="true">
        <div class="flex h-[min(150px,34vw)] items-end gap-[min(8px,1.6vw)]">
          {
            balken.map((b) => (
              <span
                class="animate-tagesbalken flex-1 origin-bottom rounded-full"
                style={`height:${b.hoehe}%;
                        background: color-mix(in oklab, var(--color-schaden) ${b.mischung}%, var(--color-lime));
                        animation-delay:${b.verzoegerung}s`}
              />
            ))
          }
        </div>
        <div class="flex items-center justify-between border-t border-edge pt-12">
          <span class="font-mono text-12 tracking-eyebrow uppercase text-mint-dim">Tag 1</span>
          <span class="font-mono text-12 tracking-eyebrow uppercase text-mint-dim">
            nach vier Wochen
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
