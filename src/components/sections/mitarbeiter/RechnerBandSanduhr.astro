---
/* Rechner-Band, Entwurf A „Sanduhr".

   Aufbau wie beim bisherigen Band: weich gerundete grüne Karte auf
   hellem Grund, links das Zeichen, rechts Überschrift und Text. Neu ist
   nur das Zeichen.

   Die Sanduhr erzählt die Aussage des Rechners in einem Bild: oben läuft
   ab, was noch da ist (Limette), unten sammelt sich, was weg ist (Rot).
   Sie zählt nichts mit und nennt keine Zahl — ein Bild, kein zweiter
   Rechner.

   Der leuchtende Ring des bisherigen Bands bleibt — er trägt den Schein
   und war so von Iwo vorgegeben. */
import Eyebrow from '../../Eyebrow.astro';
import Button from '../../Button.astro';
---

<section class="bg-paper px-page-x pt-0 pb-section-y-sm">
  <div class="relative mx-auto max-w-content">
    <div
      class="relative flex flex-wrap items-center gap-x-48 gap-y-28 overflow-hidden rounded-band bg-forest px-innen-block py-32 btn:py-40"
    >
      {/* Schein hinter dem Zeichen, an der Kartenkante abgeschnitten */}
      <div
        class="pointer-events-none absolute top-1/2 left-0 hidden h-260 w-260 -translate-x-1/3 -translate-y-1/2 rounded-full opacity-40 blur-[60px] btn:block"
        style="background: radial-gradient(circle, var(--color-lime) 0%, transparent 68%)"
        aria-hidden="true"
      >
      </div>

      {/* --- Sanduhr --- */}
      <div
        class="relative flex h-[min(196px,58vw)] w-[min(196px,58vw)] flex-none items-center justify-center"
        aria-hidden="true"
      >
        <span class="absolute inset-0 rounded-full border border-lime/25 shadow-ring-lime"></span>

        <svg viewBox="0 0 120 170" fill="none" class="relative h-[min(150px,44vw)] w-auto">
          <defs>
            {/* Die beiden Kammern schneiden den Sand zu. Ohne die Clips
                stünde er als Rechteck über dem Glas. */}
            <clipPath id="sand-kammer-oben">
              <path d="M26 26 H94 L63 82 H57 Z" />
            </clipPath>
            <clipPath id="sand-kammer-unten">
              <path d="M57 88 H63 L94 144 H26 Z" />
            </clipPath>
          </defs>

          {/* Gestell */}
          <rect class="fill-lime" x="18" y="16" width="84" height="8" rx="4" />
          <rect class="fill-lime" x="18" y="146" width="84" height="8" rx="4" />

          {/* Glas */}
          <path
            class="stroke-mint"
            stroke-width="3"
            stroke-linejoin="round"
            d="M26 26 H94 L63 82 V88 L94 144 H26 L57 88 V82 Z"
          />

          {/* Sand oben: rutscht nach unten aus der Kammer */}
          <g clip-path="url(#sand-kammer-oben)">
            <rect class="fill-lime animate-sand-oben" x="20" y="24" width="80" height="48" />
          </g>

          {/* Strahl */}
          <line
            class="stroke-lime animate-sand-strahl"
            stroke-width="3"
            stroke-linecap="round"
            stroke-dasharray="3 9"
            x1="60"
            y1="80"
            x2="60"
            y2="134"
          />

          {/* Sand unten: wächst von der Grundlinie nach oben */}
          <g clip-path="url(#sand-kammer-unten)">
            <rect class="fill-schaden animate-sand-unten" x="20" y="98" width="80" height="48" />
          </g>
        </svg>
      </div>

      {/* --- Text --- */}
      <div class="flex flex-1 basis-[min(420px,100%)] flex-col items-start gap-20">
        <Eyebrow variante="lime">Vakanzkosten</Eyebrow>

        <h2 class="m-0 text-h2-sub leading-tightest font-bold tracking-system text-paper">
          Was kostet Sie die offene Stelle, <span
            class="font-display font-semibold tracking-none italic">während Sie suchen</span
          >?
        </h2>

        <p class="m-0 max-w-620 text-18 leading-quote text-mint">
          Eine unbesetzte Stelle kostet nicht erst, wenn jemand kündigt. Sie kostet jeden
          Arbeitstag, an dem die Arbeit liegen bleibt oder das Team sie mitmacht. Im
          Rechner sehen Sie die Zahl für Ihr Gewerk — in unter einer Minute, ohne Eingabe
          von Kontaktdaten.
        </p>

        <Button href="/vakanzkostenrechner" variante="lime" sheen class="mt-4">
          Zum Vakanzkosten-Rechner<span class="text-18" aria-hidden="true">→</span>
        </Button>
      </div>
    </div>
  </div>
</section>
