---
/* Rechner-Band, Entwurf C „Kostenuhr".

   Mittig gesetzt statt zweispaltig: oben die Uhr, darunter Überschrift,
   Text und Knopf, alles zentriert. Damit unterscheidet sich der Entwurf
   im Zuschnitt von A (Zeichen links) und B (Bild rechts).

   Die Uhr: Ein Zeiger läuft einmal herum und zieht einen roten Bogen
   hinter sich her — die Zeit, die vergeht, färbt sich als Schaden ein.
   Danach blendet der Bogen aus und die Runde beginnt neu. Keine Zahl,
   kein Zifferblatt mit Beschriftung: ein Bild, kein zweiter Rechner.

   Der Bogen steht ohne Animation (prefers-reduced-motion) auf zwei
   Dritteln, damit die Uhr auch im Stillstand etwas erzählt. */
import Eyebrow from '../../Eyebrow.astro';
import Button from '../../Button.astro';

/* zwölf Striche am Rand, jeder dritte länger */
const striche = Array.from({ length: 12 }, (_, i) => {
  const w = (i * 30 * Math.PI) / 180;
  const innen = i % 3 === 0 ? 40 : 44;
  return {
    x1: 60 + Math.sin(w) * innen,
    y1: 60 - Math.cos(w) * innen,
    x2: 60 + Math.sin(w) * 47,
    y2: 60 - Math.cos(w) * 47,
    lang: i % 3 === 0,
  };
});
---

<section class="bg-paper px-page-x pt-0 pb-section-y-sm">
  <div class="relative mx-auto max-w-content">
    <div
      class="relative flex flex-col items-center gap-24 overflow-hidden rounded-band bg-forest px-innen-block py-40 text-center btn:py-56"
    >
      {/* Schein hinter der Uhr */}
      <div
        class="pointer-events-none absolute top-0 left-1/2 h-260 w-260 -translate-x-1/2 -translate-y-1/4 rounded-full opacity-35 blur-[60px]"
        style="background: radial-gradient(circle, var(--color-lime) 0%, transparent 68%)"
        aria-hidden="true"
      >
      </div>

      {/* --- Uhr --- */}
      <svg
        viewBox="0 0 120 120"
        fill="none"
        class="relative w-[min(150px,42vw)]"
        aria-hidden="true"
      >
        <circle class="fill-forest-deep stroke-edge" stroke-width="2" cx="60" cy="60" r="58" />

        {/* Spur und Bogen. Der Bogen beginnt oben, deshalb um −90° gedreht. */}
        <circle class="stroke-edge" stroke-width="6" cx="60" cy="60" r="52" />
        <circle
          class="stroke-schaden animate-uhr-bogen"
          stroke-width="6"
          stroke-linecap="round"
          stroke-dasharray="327"
          stroke-dashoffset="110"
          transform="rotate(-90 60 60)"
          cx="60"
          cy="60"
          r="52"
        />

        {
          striche.map((s) => (
            <line
              class={s.lang ? 'stroke-mint' : 'stroke-edge-soft'}
              stroke-width={s.lang ? 3 : 2}
              stroke-linecap="round"
              x1={s.x1}
              y1={s.y1}
              x2={s.x2}
              y2={s.y2}
            />
          ))
        }

        {/* Zeiger: dreht sich um die Mitte des Zifferblatts */}
        <line
          class="stroke-lime animate-uhr-zeiger"
          style="transform-box: view-box; transform-origin: 60px 60px"
          stroke-width="4"
          stroke-linecap="round"
          x1="60"
          y1="60"
          x2="60"
          y2="22"
        />
        <circle class="fill-lime" cx="60" cy="60" r="5" />
      </svg>

      {/* --- Text --- */}
      <Eyebrow variante="lime">Vakanzkosten</Eyebrow>

      <h2 class="m-0 max-w-760 text-h2-sub leading-tightest font-bold tracking-system text-paper">
        Was kostet Sie die offene Stelle, <span
          class="font-display font-semibold tracking-none italic">während Sie suchen</span
        >?
      </h2>

      <p class="m-0 max-w-620 text-18 leading-quote text-mint">
        Eine unbesetzte Stelle kostet nicht erst, wenn jemand kündigt. Sie kostet jeden
        Arbeitstag, an dem die Arbeit liegen bleibt oder das Team sie mitmacht. Im
        Rechner sehen Sie die Zahl für Ihr Gewerk — in unter einer Minute, ohne Eingabe
        von Kontaktdaten.
      </p>

      <Button href="/vakanzkostenrechner" variante="lime" sheen class="mt-4">
        Zum Vakanzkosten-Rechner<span class="text-18" aria-hidden="true">→</span>
      </Button>
    </div>
  </div>
</section>
