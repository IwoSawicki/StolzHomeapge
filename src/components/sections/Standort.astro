---
/* „Hier finden Sie uns": Karte links, Kontaktdaten rechts.
   Vorlage: design/STARTSEITE.dc.html, data-screen-label="Hier finden Sie uns" */
import KarteDeutschland from '../KarteDeutschland.astro';
import { kontakt } from '../../data/navigation';
---

<section id="kontakt" class="bg-forest-deep px-20 py-section-y-contact">
  <div class="mx-auto flex max-w-content-wide flex-wrap items-center gap-40">
    <div class="relative min-h-map flex-[1.3] basis-420">
      <div class="absolute inset-0">
        <KarteDeutschland />
      </div>
    </div>

    <div class="flex flex-1 basis-340 flex-col items-start gap-28">
      <span class="text-15 tracking-eyebrow uppercase text-mint-dim">Kontaktdaten</span>
      <h2
        class="m-0 text-h2-contact leading-contact font-bold tracking-contact text-paper"
      >
        Hier finden Sie uns
      </h2>
      <p class="m-0 max-w-560 text-18 leading-prose text-mint-light">
        Wir sitzen an der Bergstraße in Südhessen — zwischen Darmstadt und Heidelberg.
        Von hier aus betreuen wir Handwerksbetriebe und Dienstleister in der Region.
      </p>

      <div class="mt-8 flex flex-wrap gap-40">
        <div class="flex items-center gap-14">
          <svg
            width="26"
            height="26"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="flex-none text-paper"
            aria-hidden="true"
          >
            <path
              d="M6.6 2.5a2 2 0 0 1 2.6.7l1.4 2.1a2 2 0 0 1-.3 2.6l-1 .9a11 11 0 0 0 4.9 4.9l.9-1a2 2 0 0 1 2.6-.3l2.1 1.4a2 2 0 0 1 .7 2.6l-1 1.7a2.5 2.5 0 0 1-2.8 1.2C11.4 19.6 4.4 12.6 2.6 5.6A2.5 2.5 0 0 1 3.8 2.8z"
            ></path>
          </svg>
          <div class="flex flex-col gap-3">
            <span class="text-17 font-bold text-paper">Telefonnummer</span>
            <a
              href={kontakt.telefonLink}
              class="text-16 text-mint-contact no-underline transition-colors hover:text-lime"
              >{kontakt.telefonAnzeige}</a
            >
          </div>
        </div>

        <div class="flex items-center gap-14">
          <svg
            width="26"
            height="26"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="flex-none text-paper"
            aria-hidden="true"
          >
            <path
              d="M2.5 5.5A2 2 0 0 1 4.5 4h15a2 2 0 0 1 2 1.5L12 12.4zM2.5 8.2V18a2 2 0 0 0 2 2h15a2 2 0 0 0 2-2V8.2l-9 6.6z"
            ></path>
          </svg>
          <div class="flex flex-col gap-3">
            <span class="text-17 font-bold text-paper">E-Mail</span>
            <a
              href={`mailto:${kontakt.email}`}
              class="text-16 text-mint-contact no-underline transition-colors hover:text-lime"
              >{kontakt.email}</a
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
