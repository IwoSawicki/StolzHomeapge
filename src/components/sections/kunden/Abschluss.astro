---
/* „Erstgespräch": dunkler Abschlussblock, links Text und Telefonnummer,
   rechts das Anfrageformular.
   Vorlage: data-screen-label="9 Abschluss" */
import Web3Formular from '../../Web3Formular.astro';
import type { Feld } from '../../Web3Formular.astro';
import { kontakt } from '../../../data/navigation';

const felder: Feld[] = [
  { name: 'name', label: 'Name', pflicht: true, breit: true, autocomplete: 'name' },
  {
    name: 'telefon',
    label: 'Telefonnummer',
    type: 'tel',
    pflicht: true,
    breit: true,
    autocomplete: 'tel',
  },
  { name: 'betrieb', label: 'Betrieb', breit: true, autocomplete: 'organization' },
  { name: 'nachricht', label: 'Worum es geht', mehrzeilig: true },
];
---

<section id="anfrage" class="bg-forest-deep px-20 py-[clamp(64px,9vw,104px)]">
  <div class="mx-auto flex max-w-content-wide flex-wrap items-start gap-x-64 gap-y-48">
    <div class="flex flex-1 basis-400 flex-col items-start gap-20">
      <span class="font-mono text-12 tracking-eyebrow uppercase text-mint-dim">
        Erstgespräch
      </span>
      <h2 class="m-0 text-h2-sub leading-tightest font-bold tracking-system text-paper">
        Wir wissen zu gut, dass die Suche nach der richtigen Agentur mindestens genauso
        schwer ist wie die Suche nach <span
          class="font-display font-semibold tracking-none italic">guten Aufträgen</span
        >.
      </h2>
      <p class="m-0 text-18 leading-prose text-mint-light">
        Im kostenlosen Erstgespräch schauen wir uns an, wonach in Ihrer Region gesucht
        wird und wie Sie gegen die anderen im Ort dastehen. Danach wissen wir beide, ob
        sich eine Zusammenarbeit überhaupt lohnt.
      </p>

      <div class="mt-12 flex flex-col gap-4 border-t border-edge pt-26">
        <span class="text-15 text-mint-dim">Lieber direkt anrufen?</span>
        <a
          href={kontakt.telefonLink}
          class="text-22 font-bold tracking-name text-paper no-underline transition-colors hover:text-lime"
          >{kontakt.telefonAnzeige}</a
        >
        <span class="text-15 text-mint-dim">Bergstraße und Rhein-Neckar</span>
      </div>
    </div>

    <Web3Formular
      felder={felder}
      betreff="Neue Anfrage über /kunden-gewinnen"
      knopfText="Erstgespräch anfragen"
      variante="dunkel"
      class="flex-1 basis-400 rounded-20 border border-edge bg-forest-review px-quote-x py-quote-y"
    />
  </div>
</section>
