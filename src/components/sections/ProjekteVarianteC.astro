---
// DESIGN-VARIANTE C – „Shape" (Nachbau madebyshape.co.uk):
// Rohe Medienflächen im ruhigen 2-Spalten-Raster (alle Kacheln gleich
// hoch), darunter Meta-Zeile + große Statement-Headline. Beim Hover
// erscheinen die Kategorie-Pills oben rechts in einer ausgeschnittenen
// Ecke mit umgekehrten Kurven (Inverted Corners, pures CSS) und die Maus
// wird zum Lime-Kreis mit Pfeil — wie beim Original.
import BrowserMockup from '../BrowserMockup.astro';
import VideoTile from '../VideoTile.astro';
import { startseitenProjekte } from '../../data/projekte';
---

<section class="px-5 pt-24 pb-16 md:px-10 md:pt-[150px] md:pb-28">
  <p class="mb-10 text-center text-xs font-medium tracking-wide text-gray uppercase">
    Design-Variante C · Shape (zur Auswahl, wird später entfernt)
  </p>

  <div class="mx-auto max-w-[1200px]">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Projekte</p>
        <h2 class="mt-3 max-w-[560px] text-4xl font-semibold text-balance leading-[1.08] tracking-[-0.03em] text-dark md:text-5xl">
          Arbeiten, die Anfragen bringen.
        </h2>
      </div>
      <a
        href="/projekte"
        class="group inline-flex items-center gap-2 pb-1 text-base font-medium text-dark transition-opacity duration-200 hover:opacity-60"
      >
        Alle Projekte
        <svg class="size-4 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-x-8 gap-y-14 md:grid-cols-2 md:gap-y-20" data-shape-grid>
      {
        startseitenProjekte.map((projekt) => (
          <a href="/projekte" class="group block" data-shape-karte>
            <div class="relative aspect-[4/3] overflow-hidden rounded-24">
              <div class="h-full w-full transition-transform duration-500 ease-out group-hover:scale-[1.015]">
                {projekt.art === 'website' ? (
                  <BrowserMockup domain={projekt.domain!} alt={`Website-Projekt ${projekt.name}`} chrome={false} class="border-0" />
                ) : (
                  <VideoTile bild={projekt.bild} alt={`Video-Projekt ${projekt.name}`} />
                )}
              </div>

              {/* Kategorie-Pills in ausgeschnittener Ecke (umgekehrte Kurven) —
                  auf Touch-Geräten immer sichtbar, am Desktop beim Hover */}
              <div class="shape-notch absolute top-0 right-0 rounded-bl-[18px] bg-white pb-2 pl-2 transition-opacity duration-300 md:opacity-0 md:group-hover:opacity-100">
                <div class="flex flex-wrap justify-end gap-1.5">
                  {projekt.kategorien.map((kategorie) => (
                    <span class="rounded-full bg-bg-soft px-3.5 py-1.5 text-xs font-semibold whitespace-nowrap text-dark">
                      {kategorie}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <div class="mt-4">
              <p class="flex items-center gap-2 text-sm font-medium text-gray">
                {projekt.name}
                <span class="size-1 rounded-full bg-gray/60" aria-hidden="true" />
                {projekt.art === 'website' ? 'Website' : 'Video-Content'}
              </p>
              <h3 class="mt-1.5 max-w-[480px] text-2xl font-semibold text-balance leading-[1.15] tracking-[-0.02em] text-dark">
                {projekt.beschreibung}
              </h3>
            </div>
          </a>
        ))
      }
    </div>
  </div>

  {/* Eigener Hover-Cursor: Lime-Kreis mit Pfeil, folgt der Maus über den Karten */}
  <div
    class="shape-cursor pointer-events-none fixed top-0 left-0 z-50 hidden size-16 items-center justify-center rounded-full bg-lime md:flex"
    data-shape-cursor
    aria-hidden="true"
  >
    <svg class="size-6 text-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 17 17 7M9 7h8v8"></path>
    </svg>
  </div>
</section>

<style>
  /* Umgekehrte Kurven: zwei Quadrate neben/unter der weißen Ecke, deren
     Radial-Gradient die konkave Rundung in Seitenhintergrund-Farbe zeichnet */
  .shape-notch::before,
  .shape-notch::after {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    background: radial-gradient(circle at 0 100%, transparent 18px, var(--color-white) 18px);
  }
  .shape-notch::before {
    top: 0;
    left: -18px;
  }
  .shape-notch::after {
    top: 100%;
    right: 0;
  }

  /* Über den Karten übernimmt der Lime-Kreis die Maus */
  @media (hover: hover) {
    [data-shape-karte] {
      cursor: none;
    }
  }
  .shape-cursor {
    transform: translate(-50%, -50%) scale(0);
    transition: transform 200ms ease;
    will-change: transform;
  }
  .shape-cursor.ist-aktiv {
    transform: translate(-50%, -50%) scale(1);
  }
</style>

<script>
  // Lime-Cursor folgt der Maus über den Projekt-Karten (nur Geräte mit Hover)
  const grid = document.querySelector('[data-shape-grid]');
  const cursor = document.querySelector<HTMLElement>('[data-shape-cursor]');
  if (grid && cursor && window.matchMedia('(hover: hover)').matches) {
    grid.addEventListener('mousemove', (e) => {
      const { clientX, clientY } = e as MouseEvent;
      cursor.style.left = `${clientX}px`;
      cursor.style.top = `${clientY}px`;
    });
    grid.querySelectorAll('[data-shape-karte]').forEach((karte) => {
      karte.addEventListener('mouseenter', () => cursor.classList.add('ist-aktiv'));
      karte.addEventListener('mouseleave', () => cursor.classList.remove('ist-aktiv'));
    });
  }
</script>
