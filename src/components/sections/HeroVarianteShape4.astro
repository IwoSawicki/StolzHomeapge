---
// HERO-VARIANTE 4 „Skizze" (Mix aus v2 + v3, nach Iwos Skizze):
// Volle Breite, Text bündig links. Rechts ein großes Video über die
// gesamte Hero-Höhe (Bildschirmhöhe) mit fester Breite von 50 %.
// Die Headline-Zeilen schneiden als weiße Treppen-Stufen von links ins
// Video — Abstufungen wie v3, umgekehrte Kurven an jedem Absatz.
//
// GEOMETRIE (Desktop ≥ 1200px): Inhalt bündig mit dem Header
// (max-w 1200 im px-10-Raster → Text links am Logo, Video rechts am
// Kontakt-Button ausgerichtet). Video: 50 % Breite × 80vh. Die
// Videokante liegt exakt bei 50 %; jede Stufe bekommt eine
// Mindestbreite (50 % + feste Stufentiefe: Zeile 1 +180 / Zeile 2 +90 /
// Zeile 3 +24 / Buttons +64 px) — die Treppe ist damit unabhängig von
// Textlängen und auf jeder Viewport-Breite identisch. Nur die Eyebrow
// muss schmaler als 50 % bleiben (aktuell ~260px, unkritisch).
//
// VIDEO EINBINDEN: MP4 nach public/videos/hero-hochkant.mp4 laden;
// am Desktop füllt es die rechte Hälfte (object-cover beschneidet),
// mobil läuft es hochkant.
import { existsSync } from 'node:fs';
import Button from '../Button.astro';

const hatVideo = existsSync(new URL('../../../public/videos/hero-hochkant.mp4', import.meta.url));
const hatPoster = existsSync(new URL('../../../public/videos/hero-hochkant-poster.jpg', import.meta.url));
---

<section class="px-5 pt-6 pb-16 md:px-10 md:pt-8 md:pb-24">
  <div class="v4-hero relative mx-auto grid max-w-[1200px] grid-cols-1 xl:min-h-[80vh] xl:items-center">
    <!-- Text mit Treppen-Stufen (schneiden am Desktop ins Video) -->
    <div class="v4-text relative z-10 w-full">
      <p class="flex w-max items-center gap-2.5 bg-white pr-7 pb-3 text-sm font-medium text-dark">
        <span class="size-1.5 rounded-full bg-dark" aria-hidden="true"></span>
        Hey, wir sind Stolz Marketing <span class="animate-waving">👋</span>
      </p>
      {/* bewusst kein <h1>: das hat die bestehende Hero; wird diese
          Variante gewählt, wird die Treppe zum echten h1 */}
      <p class="v4-headline relative text-3xl font-semibold leading-none tracking-[-0.04em] text-dark md:text-52 xl:text-7xl">
        <span class="v4-step v4-zeile1 block w-max rounded-tr-[20px] bg-white pr-8 pb-2 xl:min-w-[calc(50%+180px)] xl:pb-3">Ein Ansprechpartner</span>
        <span class="v4-step v4-zeile block w-max bg-white pr-8 pb-2 xl:min-w-[calc(50%+90px)] xl:pb-3">für Ihr gesamtes</span>
        <span class="v4-step v4-zeile v4-zeile3 block w-max bg-white pr-8 pb-1 xl:min-w-[calc(50%+24px)]">Marketing.</span>
      </p>
      <div class="v4-step v4-cta w-max rounded-tr-[20px] rounded-br-[24px] bg-white pt-4 pr-10 pb-1 xl:min-w-[calc(50%+64px)] xl:pt-5 xl:pb-2">
        <div class="flex flex-col items-start gap-2.5 md:flex-row md:items-center">
          <Button href="/projekte" variant="blue" shadow="blue-glow">Projekte ansehen</Button>
          {/* Ziel folgt, sobald die Über-uns-Sektion existiert */}
          <Button href="#ueber-uns" variant="light">Über uns</Button>
        </div>
      </div>
    </div>

    <!-- Video: rechte Hälfte, volle Hero-Höhe (mobil hochkant unter dem Text) -->
    <div class="relative mx-auto mt-10 w-full max-w-[440px] xl:absolute xl:top-1/2 xl:right-0 xl:mx-0 xl:mt-0 xl:h-[80vh] xl:w-1/2 xl:max-w-none xl:-translate-y-1/2">
      <div class="aspect-[9/16] overflow-hidden rounded-[32px] bg-linear-160 from-video-dark-1 to-video-dark-2 xl:aspect-auto xl:h-full">
        {
          hatVideo ? (
            <video
              class="h-full w-full object-cover"
              src="/videos/hero-hochkant.mp4"
              poster={hatPoster ? '/videos/hero-hochkant-poster.jpg' : undefined}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            />
          ) : (
            <div class="flex h-full w-full flex-col items-center justify-center gap-4 px-8 text-center">
              <span class="flex size-[58px] items-center justify-center rounded-full bg-white/14 backdrop-blur-[2px]">
                <svg class="size-[22px] translate-x-px" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M 6.75 3.74 L 6.75 20.26 C 6.755 20.53 6.9 20.77 7.14 20.9 C 7.37 21.03 7.66 21.03 7.89 20.89 L 21.4 12.63 C 21.62 12.49 21.75 12.25 21.75 12 C 21.75 11.74 21.62 11.5 21.4 11.37 L 7.89 3.11 C 7.66 2.97 7.37 2.96 7.14 3.09 C 6.9 3.22 6.755 3.47 6.75 3.74 Z" />
                </svg>
              </span>
              <p class="text-sm font-medium text-white/60">
                Video folgt — Datei nach{' '}
                <code class="text-white/80">public/videos/hero-hochkant.mp4</code> laden
              </p>
            </div>
          )
        }
      </div>
      <div class="absolute right-4 bottom-4 flex items-center gap-3 rounded-full bg-white py-2 pr-5 pl-2 shadow-card">
        <span class="flex size-9 items-center justify-center rounded-full bg-dark">
          <svg class="size-3.5 translate-x-px" viewBox="0 0 24 24" fill="white" aria-hidden="true">
            <path d="M 6.75 3.74 L 6.75 20.26 C 6.755 20.53 6.9 20.77 7.14 20.9 C 7.37 21.03 7.66 21.03 7.89 20.89 L 21.4 12.63 C 21.62 12.49 21.75 12.25 21.75 12 C 21.75 11.74 21.62 11.5 21.4 11.37 L 7.89 3.11 C 7.66 2.97 7.37 2.96 7.14 3.09 C 6.9 3.22 6.755 3.47 6.75 3.74 Z" />
          </svg>
        </span>
        <span class="text-sm leading-tight font-semibold text-dark">
          Einblick in unsere Arbeit
          <span class="block text-xs font-medium text-gray">STOLZ Marketing</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Treppen-Stufen wie v3 — die Videokante liegt bei exakt 50 %, alle
     Kurven-Positionen sind reine Prozentwerte und damit layoutfest. */
  .v4-hero {
    --v4-r: 20px;
  }
  @media (min-width: 1200px) {
    .v4-step {
      position: relative;
    }
    .v4-step::before,
    .v4-step::after {
      position: absolute;
      width: var(--v4-r);
      height: var(--v4-r);
    }
    /* Zeile 3 → Buttons werden breiter: Kurve unten rechts */
    .v4-zeile3::after {
      content: '';
      right: calc(-1 * var(--v4-r));
      bottom: 0;
      background: radial-gradient(circle at 100% 0, transparent var(--v4-r), var(--color-white) var(--v4-r));
    }
    /* Zeile 2/3 sind schmaler als die darüber: Kurve oben rechts */
    .v4-zeile::before {
      content: '';
      right: calc(-1 * var(--v4-r));
      top: 0;
      background: radial-gradient(circle at 100% 100%, transparent var(--v4-r), var(--color-white) var(--v4-r));
    }
    /* Zeile 1 und 2 sind breiter als die jeweils folgende: konvexe Ecke */
    .v4-zeile1,
    .v4-zeile:not(.v4-zeile3) {
      border-bottom-right-radius: var(--v4-r);
    }
    /* Abschluss oben: an der Videokante (50 %) über Zeile 1 */
    .v4-headline::before {
      content: '';
      position: absolute;
      width: var(--v4-r);
      height: var(--v4-r);
      left: 50%;
      top: calc(-1 * var(--v4-r));
      background: radial-gradient(circle at 100% 0, transparent var(--v4-r), var(--color-white) var(--v4-r));
    }
    /* Abschluss unten: an der Videokante unter der Button-Stufe */
    .v4-text::after {
      content: '';
      position: absolute;
      width: var(--v4-r);
      height: var(--v4-r);
      left: 50%;
      bottom: calc(-1 * var(--v4-r));
      background: radial-gradient(circle at 100% 100%, transparent var(--v4-r), var(--color-white) var(--v4-r));
    }
  }
</style>
