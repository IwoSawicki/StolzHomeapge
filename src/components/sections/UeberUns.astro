---
/* „Über uns": Porträt und Panel nebeneinander, darunter das Team-Raster.
   Das Raster bleibt auch mobil zweispaltig.
   Vorlage: design/STARTSEITE.dc.html,
   data-screen-label="Über uns – Variante A2 (hell)" */
import { Image } from 'astro:assets';
import Eyebrow from '../Eyebrow.astro';
import { team } from '../../data/startseite';
import portraitIwo from '../../assets/portraits/iwo-sawicki.jpg';

const portraits = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/portraits/*.jpg',
  { eager: true },
);
---

<section class="bg-paper px-20 py-section-y-sm">
  <div class="mx-auto flex max-w-content flex-col gap-56">
    {/* --- Ansprechpartner --------------------------------------------- */}
    <div class="flex flex-wrap items-stretch gap-32">
      <div
        class="relative min-h-portrait flex-1 basis-300 overflow-hidden rounded-20 bg-photo-bg"
      >
        <Image
          src={portraitIwo}
          alt="Iwo Sawicki, Inhaber von Stolz Marketing"
          widths={[400, 700, 1000]}
          sizes="(min-width: 1160px) 380px, (min-width: 720px) 35vw, 100vw"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 block h-full w-full object-cover"
          style="object-position: 50% 18%"
        />
      </div>

      <div
        class="box-content flex flex-[2] basis-440 flex-col items-start justify-center gap-22 rounded-20 bg-paper-warm p-panel"
      >
        <Eyebrow variante="warm">Über uns</Eyebrow>
        <h2
          class="m-0 text-h2-about leading-tightest font-bold tracking-system text-ink"
        >
          Ihr <span
            class="marker-flach font-display text-h2-system font-semibold tracking-system italic"
            >Ansprechpartner</span
          >
        </h2>
        <p class="m-0 max-w-660 text-18 leading-prose text-ink-body">
          Wofür Ihr Betrieb steht, welche Aufträge Sie wollen, wo das Werbebudget
          hingeht und woran wir messen, ob es funktioniert — das entscheide ich mit
          Ihnen. Die Umsetzung macht unser Team: Webseite, Kamera, Schnitt und bezahlte
          Werbung. Ihr Ansprechpartner bleibt derselbe, von der ersten Frage bis nach
          dem Livegang.
        </p>
        <div class="mt-2 flex flex-col gap-3">
          <span class="text-26 font-bold tracking-name text-ink">Iwo Sawicki</span>
          <span class="text-15 text-ink-label">Inhaber · Stolz Marketing</span>
        </div>
      </div>
    </div>

    {/* --- Team ---------------------------------------------------------- */}
    <div class="flex flex-col gap-24">
      <div class="flex items-center gap-20">
        <h2
          class="m-0 text-13 font-medium tracking-eyebrow-wide whitespace-nowrap uppercase text-ink-muted"
        >
          Unser Team
        </h2>
        <div class="h-1 flex-1 bg-rule"></div>
      </div>

      <div
        class="grid grid-cols-[repeat(auto-fit,minmax(min(240px,calc(50%-10px)),1fr))] gap-20"
      >
        {
          team.map((person) => (
            <div class="flex flex-col gap-0">
              {person.portrait ? (
                <div class="relative aspect-[4/5] overflow-hidden rounded-16 bg-photo-bg">
                  <Image
                    src={portraits[`../../assets/portraits/${person.portrait}`]!.default}
                    alt={`${person.name}, ${person.rolle} bei Stolz Marketing`}
                    widths={[280, 480, 700]}
                    sizes="(min-width: 1160px) 275px, 45vw"
                    loading="lazy"
                    decoding="async"
                    class="block h-full w-full object-cover"
                    style={`object-position: ${person.position}`}
                  />
                </div>
              ) : (
                /* Porträt fehlt noch (design/README.md, Offene Punkte Nr. 8) */
                <div
                  class="relative flex aspect-[4/5] items-center justify-center overflow-hidden rounded-16"
                  style="background: repeating-linear-gradient(45deg, var(--color-hatch-light) 0 14px, var(--color-hatch-light-alt) 14px 28px)"
                >
                  <span class="font-mono text-11 text-ink-faint">
                    PORTRÄT · {person.name}
                  </span>
                </div>
              )}
              <div class="mt-18 flex flex-col gap-4 border-t border-rule pt-18">
                <span class="text-19 font-bold tracking-name text-ink">{person.name}</span>
                <span class="text-15 text-ink-muted">
                  {person.art ? `${person.art} · ${person.rolle}` : person.rolle}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
