---
// DESIGN-VARIANTE E – „Galerie":
// Gleichmäßiges 3-Spalten-Raster, alle Kacheln gleich hoch.
// Bildunterschrift wie in einer Galerie (Name — Kategorien) statt
// Overlays. Ruhig, monochrom, ohne Kartenoptik.
import BrowserMockup from '../BrowserMockup.astro';
import VideoTile from '../VideoTile.astro';
import { startseitenProjekte } from '../../data/projekte';

// Web/Video im Wechsel übers Raster verteilt
const galerie = [0, 1, 2, 3, 4, 5].map((i) => startseitenProjekte[i]);
---

<section class="bg-bg-soft px-5 pt-24 pb-16 md:px-10 md:pt-[150px] md:pb-28">
  <p class="mb-10 text-center text-xs font-medium tracking-wide text-gray uppercase">
    Design-Variante E · Galerie (zur Auswahl, wird später entfernt)
  </p>

  <div class="mx-auto max-w-[1200px]">
    <div class="mx-auto max-w-[640px] text-center">
      <p class="text-xs font-semibold tracking-[0.18em] text-gray uppercase">Projekte</p>
      <h2 class="mt-3 text-4xl font-semibold text-balance leading-[1.08] tracking-[-0.03em] text-dark md:text-5xl">
        Ein Blick in unsere Arbeit
      </h2>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-x-5 gap-y-10 md:grid-cols-2 xl:grid-cols-3">
      {
        galerie.map((projekt) => (
          <figure class="group">
            <div class="aspect-[4/3.4] overflow-hidden rounded-14">
              <div class="h-full w-full transition-transform duration-500 ease-out group-hover:scale-[1.015]">
                {projekt.art === 'website' ? (
                  <BrowserMockup domain={projekt.domain!} alt={`Website-Projekt ${projekt.name}`} chrome={false} class="border-0" />
                ) : (
                  <VideoTile bild={projekt.bild} alt={`Video-Projekt ${projekt.name}`} />
                )}
              </div>
            </div>
            <figcaption class="mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-0.5 text-sm">
              <span class="font-semibold text-dark">{projekt.name}</span>
              <span class="font-medium text-gray">— {projekt.kategorien.join(', ')}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-6 flex justify-center">
      <a href="/projekte" class="group inline-flex items-center gap-2 text-base font-medium text-dark transition-opacity duration-200 hover:opacity-60">
        Alle Projekte ansehen
        <svg class="size-4 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
