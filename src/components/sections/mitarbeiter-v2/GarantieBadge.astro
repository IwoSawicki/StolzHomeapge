---
/* Garantie-Zeile unter jedem Erstgespräch-Knopf der Seite v2. */
import { garantieBadge } from '../../../data/mitarbeiter-v2';

interface Props {
  variante?: 'hell' | 'dunkel';
  class?: string;
}

const { variante = 'hell', class: klasse } = Astro.props;
---

<ul
  class:list={[
    'm-0 flex list-none flex-wrap gap-x-18 gap-y-6 p-0 text-14',
    variante === 'hell' ? 'text-ink-muted' : 'text-mint',
    klasse,
  ]}
>
  {
    garantieBadge.map((punkt) => (
      <li class="flex items-center gap-8">
        <span
          class:list={[
            'flex h-18 w-18 flex-none items-center justify-center rounded-full',
            variante === 'hell' ? 'bg-forest text-paper' : 'bg-cream text-forest-deep',
          ]}
          aria-hidden="true"
        >
          <svg viewBox="0 0 24 24" class="w-10" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12.5l4.5 4.5L19 7.5" />
          </svg>
        </span>
        {punkt}
      </li>
    ))
  }
</ul>
