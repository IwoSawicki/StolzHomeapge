---
/* S4 · Die Garantie — Entwurf B (04.10.2026, Iwo: „die Garantie wirkt
   noch schwach").

   Entwurf A zeigt die Garantie als Dokument mit Unterschrift; die Zusage
   steckt dort in einem langen Satz. Hier ist sie die Hauptsache:
   - ein dunkelgrünes Band — Gelb gibt es auf der Seite nur auf Flächen
     wie Knöpfen und Siegel, nie als Hintergrund einer Sektion (Iwo,
     04.10.2026),
   - ein Siegel, dessen Schriftring sich langsam dreht,
   - die Zusage als große Überschrift, darunter der konkrete Wert,
   - drei Schritte, warum sie hält: prüfen, festhalten, einstehen.

   Die Bedingungen stehen bewusst nicht auf der Seite (Iwo: wirkt
   unprofessionell) — sie gehören in den Vertrag und ins Erstgespräch.

   Auf dev umschaltbar mit ?garantie=b (siehe Seite). Werte als
   Platzhalter wie in Entwurf A. Die Schritte bauen sich beim Hinscrollen
   gestaffelt auf; ohne Skript oder Bewegung steht alles da, das Siegel
   steht still. */
import Eyebrow from '../../Eyebrow.astro';
import Button from '../../Button.astro';
import PlatzhalterText from './PlatzhalterText.astro';
import { garantieB as g, CTA } from '../../../data/mitarbeiter-v2';

/* Schriftring: einmal herum, per textLength genau auf den Umfang
   (2π · 82 ≈ 515) verteilt — doppelt gesetzt überlappte er sich */
const ring = g.siegel;
const UMFANG = 513;
---

<section class="bg-forest px-page-x py-section-y-md text-paper" data-garantie-b>
  <div class="mx-auto flex max-w-content flex-col gap-48">
    <div class="grid grid-cols-1 items-center gap-x-72 gap-y-36 nav:grid-cols-[auto_minmax(0,1fr)]">
      {/* --- Siegel --- */}
      <div class="relative mx-auto aspect-square w-[clamp(190px,26vw,290px)]" aria-hidden="true">
        <svg viewBox="0 0 200 200" class="absolute inset-0 h-full w-full">
          <defs>
            <path id="siegel-kreis" d="M100 100 m-82 0 a82 82 0 1 1 164 0 a82 82 0 1 1 -164 0" />
          </defs>
          <circle cx="100" cy="100" r="98" class="fill-lime" />
          <circle cx="100" cy="100" r="68" class="fill-none stroke-forest-deep/35" stroke-width="1" stroke-dasharray="2 4" />
          <g class="siegel-ring">
            <text class="fill-forest-deep" font-size="12" font-weight="700" font-family="ui-monospace, monospace">
              <textPath href="#siegel-kreis" textLength={UMFANG} lengthAdjust="spacing">{ring.toUpperCase()}</textPath>
            </text>
          </g>
        </svg>
        <div class="absolute inset-[22%] flex flex-col items-center justify-center gap-6 rounded-full bg-forest-deep text-center text-paper">
          <svg viewBox="0 0 24 24" class="w-[28%]" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12.5l4.5 4.5L19 7.5" />
          </svg>
          <span class="text-[clamp(13px,1.5vw,16px)] font-bold tracking-system">{g.siegelMitte}</span>
        </div>
      </div>

      {/* --- Die Zusage --- */}
      <div class="flex flex-col items-start gap-22">
        <Eyebrow variante="lime">{g.eyebrow}</Eyebrow>
        <h2 class="m-0 text-[clamp(34px,5vw,64px)] leading-tightest font-bold tracking-claim">
          {g.titelVorn}<span class="block text-mint">{g.titelHinten}</span>
        </h2>
        <p class="m-0 flex items-start gap-12 rounded-16 bg-forest-card px-18 py-14 text-17 leading-body font-medium text-paper ring-1 ring-edge">
          <span class="mt-2 flex h-22 w-22 flex-none items-center justify-center rounded-full bg-lime text-forest-deep" aria-hidden="true">
            <svg viewBox="0 0 24 24" class="w-12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
          </span>
          <span><PlatzhalterText text={g.zusage} /></span>
        </p>
      </div>
    </div>

    {/* --- Drei Schritte --- */}
    <ol class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-16 p-0">
      {
        g.schritte.map((s, i) => (
          <li class="garantie-schritt flex flex-col gap-12 rounded-20 bg-forest-card p-24 ring-1 ring-edge" style={`--i:${i}`}>
            <span class="flex items-center gap-12">
              <span class="flex h-36 w-36 flex-none items-center justify-center rounded-full bg-cream font-mono text-13 font-bold text-forest-deep">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-20 leading-card font-bold text-paper">{s.titel}</span>
            </span>
            <span class="text-16 leading-body text-mint">{s.text}</span>
          </li>
        ))
      }
    </ol>

    {/* --- Knopf --- */}
    <div class="flex flex-wrap items-start justify-between gap-x-40 gap-y-20">
      <div class="flex flex-col items-start gap-10">
        <Button href="#erstgespraech" variante="lime">
          {CTA}<span class="text-18" aria-hidden="true">→</span>
        </Button>
        <span class="text-14 text-mint-dim">{g.ctaZeile}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .siegel-ring {
    transform-box: view-box;
    transform-origin: center;
    animation: siegel-drehen 36s linear infinite;
  }
  @keyframes siegel-drehen {
    to {
      transform: rotate(360deg);
    }
  }
  [data-garantie-b].vorher .garantie-schritt {
    opacity: 0;
    translate: 0 18px;
  }
  [data-garantie-b].spielt .garantie-schritt {
    transition:
      opacity 0.5s ease-out,
      translate 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(0.15s + var(--i) * 0.09s);
  }
</style>

<script>
  const band = document.querySelector<HTMLElement>('[data-garantie-b]');
  const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (band && !ruhig && 'IntersectionObserver' in window) {
    const schritte = band.querySelector('ol')!;
    band.classList.add('vorher');
    const b = new IntersectionObserver(
      (e) => {
        if (!e.some((x) => x.isIntersecting)) return;
        band.classList.add('spielt');
        requestAnimationFrame(() => requestAnimationFrame(() => band.classList.remove('vorher')));
        b.disconnect();
      },
      { threshold: 0.25 },
    );
    b.observe(schritte);
  }
</script>
