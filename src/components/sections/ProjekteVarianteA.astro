---
// DESIGN-VARIANTE A – „Clean Showcase" (Bento-Grid):
// Volle Medienkacheln, nur Projektname als Overlay unten links,
// Kategorie-Badges als Glas-Pills oben links. Websites breit (Browser-
// Mockup), Videos hochkant — abwechselnd pro Reihe. Sehr reduziert,
// die Arbeiten stehen im Vordergrund.
import SectionHeading from '../SectionHeading.astro';
import Button from '../Button.astro';
import BrowserMockup from '../BrowserMockup.astro';
import VideoTile from '../VideoTile.astro';
import { startseitenProjekte } from '../../data/projekte';

// Reihen-Muster: [Website breit + Video] / [Video + Website breit] / …
const reihenfolge = [0, 1, 3, 2, 4, 5].map((i) => startseitenProjekte[i]);
---

<section class="px-3 pt-24 pb-12 md:px-9 md:pt-[150px] md:pb-25">
  <p class="mb-6 text-center text-xs font-medium tracking-wide text-gray uppercase">
    Design-Variante A · Clean Showcase (zur Auswahl, wird später entfernt)
  </p>
  <SectionHeading label="Kunden" headingMaxWidth={800}>Erfolgreiche Projekte</SectionHeading>

  <div class="mx-auto mt-17 grid max-w-[1200px] grid-cols-1 gap-2 md:grid-cols-3 md:[grid-auto-rows:480px] xl:[grid-auto-rows:560px]">
    {
      reihenfolge.map((projekt) => (
        <article
          class:list={[
            'group relative overflow-hidden rounded-20 bg-dark max-md:h-[420px]',
            projekt.art === 'website' && 'md:col-span-2',
          ]}
        >
          <div class="absolute inset-0 transition-transform duration-500 group-hover:scale-[1.02]">
            {projekt.art === 'website' ? (
              <BrowserMockup domain={projekt.domain!} alt={`Website-Projekt ${projekt.name}`} class="rounded-none border-0" />
            ) : (
              <VideoTile bild={projekt.bild} alt={`Video-Projekt ${projekt.name}`} />
            )}
          </div>

          {/* Badges */}
          <div class="absolute top-4 left-4 flex flex-wrap gap-1.5">
            {projekt.kategorien.map((kategorie) => (
              <span class="rounded-full bg-dark/50 px-3 py-1 text-xs font-semibold text-white backdrop-blur-md">
                {kategorie}
              </span>
            ))}
          </div>

          {/* Name-Overlay */}
          <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-black/75 via-black/35 to-transparent px-6 pt-16 pb-5">
            <h3 class="text-2xl font-semibold tracking-[-0.02em] text-white">{projekt.name}</h3>
          </div>
        </article>
      ))
    }
  </div>

  <div class="mt-12 flex justify-center">
    <Button href="/projekte" variant="blue" shadow="blue-glow">Alle Projekte ansehen</Button>
  </div>
</section>
