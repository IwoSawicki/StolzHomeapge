---
// VERGLEICHS-SEKTION „Klassische Agentur vs. STOLZ Marketing":
// Zwei Spalten in einem hellen Container — links die typischen
// Agentur-Nachteile (gedimmt, X-Kreis), rechts die eigenen Vorteile
// (CI-Blau, Icons). Layout-Idee nach einer Referenz von Iwo, Texte und
// Gestaltung im STOLZ-Branding neu formuliert.
import SectionHeading from '../SectionHeading.astro';

const agentur = [
  'Wechselnde Ansprechpartner',
  'Fokus auf Design-Trends statt Anfragen',
  'Lange Wege über Ticket-Systeme',
  'Viel Verwaltung, die Sie mitbezahlen',
  'Baukasten von der Stange',
  'Reports, die niemand versteht',
];

// Icon-Pfade (Lucide-Stil, 24er-Viewbox) für die rechte Spalte
const stolz = [
  { text: 'Sie sprechen immer direkt mit mir', pfad: 'M16 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1' },
  { text: 'Ich kenne Ihr Handwerk und Ihre Kunden', pfad: 'M12 7v13M12 7a5 5 0 0 0-5-5H3v13h4a5 5 0 0 1 5 5M12 7a5 5 0 0 1 5-5h4v13h-4a5 5 0 0 0-5 5' },
  { text: 'Kurze Wege, schnelle Rückmeldung', pfad: 'M13 2 4.5 13H12l-1 9 8.5-11H12l1-9Z' },
  { text: 'Gebaut auf Anfragen, nicht auf Optik', pfad: 'M4 20V10M10 20V4M16 20v-7M22 20H2' },
  { text: 'Alles individuell für Ihren Betrieb', pfad: 'M12 3 4 6v6c0 4.5 3.4 8.4 8 9 4.6-.6 8-4.5 8-9V6l-8-3Z' },
  { text: 'Monatlich nachvollziehbare Zahlen', pfad: 'M3 17l6-6 4 4 8-8M15 7h6v6' },
];
---

<section class="px-5 py-16 md:px-10 md:py-24">
  <div class="mx-auto max-w-[1200px]">
    <SectionHeading label="Der Unterschied" headingMaxWidth={820}>
      <svg slot="icon" class="size-[7px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <circle cx="12" cy="12" r="10" />
      </svg>
      Ihr direkter Draht zum Fachmann — ohne Agentur-Wasserkopf
      <Fragment slot="description">
        Kurze Wege, ein Ansprechpartner, der Ihren Betrieb kennt, und Entscheidungen, die nicht drei
        Abteilungen durchlaufen müssen.
      </Fragment>
    </SectionHeading>

    <div class="mt-12 rounded-[32px] bg-bg-soft p-4 md:mt-16 md:p-8 xl:p-10">
      <div class="grid grid-cols-1 gap-4 md:gap-8 xl:grid-cols-2">
        <!-- Links: klassische Agentur -->
        <div>
          <p class="mb-5 text-center text-xl font-semibold tracking-[-0.02em] text-gray md:text-2xl">
            Klassische Agentur
          </p>
          <ul class="rounded-24 border border-border bg-white px-6 py-2 md:px-8">
            {
              agentur.map((punkt) => (
                <li class="flex items-center gap-4 border-b border-border py-5 text-base font-medium text-gray last:border-b-0 md:text-lg">
                  <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-gray/25" aria-hidden="true">
                    <svg class="size-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round">
                      <path d="M6 6l12 12M18 6L6 18" />
                    </svg>
                  </span>
                  {punkt}
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Rechts: STOLZ Marketing -->
        <div>
          <p class="mb-5 flex items-center justify-center gap-2.5 text-xl font-semibold tracking-[-0.02em] text-dark md:text-2xl">
            <svg class="h-[18px] w-[27px]" viewBox="0 0 32.514 21.435" overflow="visible" aria-hidden="true">
              <path
                d="M 19.003 8.874 C 17.234 9.041 15.465 9.208 13.696 9.373 C 9.804 9.738 3.903 10.29 0 10.657 C 0.042 10.736 0.086 10.754 0.131 10.758 C 4.053 11.127 9.052 11.603 12.976 11.958 C 15.099 12.156 17.181 12.349 19.264 12.546 C 20.07 12.623 20.17 12.713 20.344 13.503 C 20.727 15.248 21.106 16.994 21.489 18.74 C 21.681 19.618 21.877 20.496 22.084 21.435 C 22.12 21.297 22.143 21.228 22.155 21.157 C 22.582 18.685 23.029 16.216 23.421 13.738 C 23.528 13.056 23.808 12.645 24.49 12.527 C 24.581 12.511 24.669 12.479 24.76 12.458 C 26.662 12.027 28.565 11.596 30.467 11.164 C 31.15 11.009 31.832 10.85 32.514 10.693 C 32.437 10.615 32.363 10.598 32.288 10.585 C 29.908 10.154 27.528 9.722 25.147 9.294 C 24.146 9.114 23.946 8.929 23.74 7.94 C 23.274 5.702 22.811 3.464 22.345 1.226 C 22.26 0.817 22.168 0.409 22.08 0 C 21.983 0.186 21.945 0.365 21.909 0.545 C 21.445 2.904 20.984 5.265 20.516 7.623 C 20.31 8.663 20.236 8.723 19.176 8.855 C 19.119 8.863 19.061 8.869 19.003 8.874 Z"
                fill="var(--color-blue)"></path>
            </svg>
            STOLZ Marketing
          </p>
          <ul class="rounded-24 border border-border bg-white px-6 py-2 md:px-8">
            {
              stolz.map((punkt) => (
                <li class="flex items-center gap-4 border-b border-border py-5 text-base font-semibold text-dark last:border-b-0 md:text-lg">
                  <svg class="size-6 shrink-0 text-blue" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={punkt.pfad} />
                  </svg>
                  {punkt.text}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
