---
/* „Wie aus einem Hobby ein Betrieb wurde": fünf Stationen an einer Linie.

   Auf dem Handy läuft die Linie senkrecht links neben den Einträgen, ab
   1040px waagerecht über ihnen — das ist derselbe Wechsel wie bei der
   Vergleichstabelle auf /mitarbeiter-gewinnen, und aus demselben Grund:
   fünf Spalten brauchen Platz, den ein Telefon nicht hat.

   Die Punkte sind reines CSS, keine Bilder. Die Linie ist dekorativ und
   für Screenreader ausgeblendet; die Reihenfolge ergibt sich schon aus
   der Liste. */
import Eyebrow from '../../Eyebrow.astro';
import { zeitstrahlKopf, stationen } from '../../../data/ueber-uns';
---

<section id="weg" class="bg-paper px-page-x py-section-y-lg">
  <div class="mx-auto flex max-w-content flex-col gap-48">
    <div class="flex max-w-760 flex-col items-start gap-18">
      <Eyebrow variante="hell">{zeitstrahlKopf.eyebrow}</Eyebrow>
      <h2 class="m-0 text-h2-sub leading-tightest font-bold tracking-system text-ink">
        {zeitstrahlKopf.titelVorn}<span
          class="font-display font-semibold tracking-none italic">{zeitstrahlKopf.titelAkzent}</span
        >{zeitstrahlKopf.titelHinten}
      </h2>
      <p class="m-0 max-w-660 text-18 leading-quote text-ink-muted">{zeitstrahlKopf.lead}</p>
    </div>

    <ol
      class="m-0 grid list-none grid-cols-1 gap-0 p-0 nav:grid-cols-5 nav:gap-x-20"
    >
      {
        stationen.map((station, i) => (
          <li class="relative flex gap-20 pb-32 last:pb-0 nav:flex-col nav:gap-0 nav:pb-0">
            {/* Linie und Punkt — senkrecht auf dem Handy, waagerecht ab 1040px */}
            <div
              class="relative flex w-12 flex-none justify-center nav:mb-20 nav:h-12 nav:w-full nav:items-center"
              aria-hidden="true"
            >
              {/* Strecke zur nächsten Station */}
              {i < stationen.length - 1 && (
                <span class="absolute top-12 bottom-[-32px] left-1/2 w-1 -translate-x-1/2 bg-rule nav:top-1/2 nav:right-0 nav:bottom-auto nav:left-1/2 nav:h-1 nav:w-auto nav:translate-x-0 nav:-translate-y-1/2" />
              )}
              <span class="relative mt-4 h-12 w-12 rounded-full border-2 border-ink bg-lime nav:mt-0" />
            </div>

            <div class="flex flex-col gap-6 pb-4">
              <span class="font-mono text-12 tracking-eyebrow uppercase text-ink-label">
                {station.marke}
              </span>
              <h3 class="m-0 text-21 leading-card font-bold tracking-heading text-ink">
                {station.titel}
              </h3>
              <p class="m-0 text-16 leading-body text-ink-quiet">{station.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
