---
// Leistungs-Sektion, volle Breite auf schwarzer Fläche (Nachbau Shape
// „Our Expertise"): Kopf dreispaltig (Eyebrow / Headline / Kurztext +
// CTA), darunter die Leistungen als riesige Zeilen mit Trennlinien.
// Beim Hover leuchtet die Zeile auf, die übrigen dimmen, und der Maus
// folgt ein blauer Pfeil-Kreis (wie im Projekt-Grid).
// Die Zeilen sind noch NICHT verlinkt — Leistungs-Unterseiten
// (/leistungen/[slug]) folgen laut Roadmap.
import Button from '../Button.astro';

const leistungen = [
  'Webseiten',
  'Google Ads & SEO',
  'KI-Ranking',
  'Social Media Ads',
  'Recruiting-Kampagnen',
  'Video- & Content-Produktion',
];
---

<section id="leistungen" class="scroll-mt-24 bg-dark py-16 md:py-24 xl:py-28">
  <div class="mx-auto max-w-[1400px] px-5 md:px-10">
    <!-- Kopf: Eyebrow / Headline / Kurztext + CTA -->
    <div class="grid grid-cols-1 gap-8 xl:grid-cols-[220px_1fr_320px] xl:gap-10">
      <p class="flex h-fit items-center gap-2.5 text-sm font-medium text-white">
        <span class="size-1.5 rounded-full bg-white" aria-hidden="true"></span>
        Unsere Leistungen
      </p>
      <h2 class="max-w-[560px] text-3xl font-semibold text-balance leading-[1.12] tracking-[-0.02em] text-white md:text-4xl xl:mx-auto xl:text-center">
        Womit wir Ihren Betrieb nach vorne bringen
      </h2>
      <div class="flex flex-col items-start gap-5">
        <p class="text-base font-medium leading-[1.5] text-white/70">
          Alles zahlt auf zwei Ziele ein: mehr Aufträge und passende Bewerber — Sie entscheiden, wo wir
          ansetzen.
        </p>
        <Button href="/kontakt" variant="white">Kostenlose Beratung</Button>
      </div>
    </div>

    <!-- Leistungs-Zeilen -->
    <ul class="expertise-liste mt-14 xl:mt-20" data-expertise aria-label="Unsere Leistungen im Überblick">
      {
        leistungen.map((leistung) => (
          <li
            class="expertise-zeile group border-t border-white/12 py-6 transition-opacity duration-300 last:border-b md:py-7 xl:py-8"
            data-expertise-zeile
          >
            <span class="block text-4xl font-semibold tracking-[-0.03em] text-white transition-transform duration-300 md:text-6xl xl:text-8xl xl:group-hover:translate-x-4">
              {leistung}
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  {/* Maus-folgender Pfeil-Kreis über den Zeilen (nur Geräte mit Hover) */}
  <div
    class="expertise-cursor pointer-events-none fixed top-0 left-0 z-50 hidden size-16 items-center justify-center rounded-full bg-blue md:flex"
    data-expertise-cursor
    aria-hidden="true"
  >
    <svg class="size-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 17 17 7M9 7h8v8"></path>
    </svg>
  </div>
</section>

<style>
  /* Beim Hover über die Liste dimmen alle Zeilen außer der aktiven */
  @media (hover: hover) {
    .expertise-liste:hover .expertise-zeile {
      opacity: 0.35;
    }
    .expertise-liste:hover .expertise-zeile:hover {
      opacity: 1;
    }
    [data-expertise-zeile] {
      cursor: none;
    }
  }
  .expertise-cursor {
    transform: translate(-50%, -50%) scale(0);
    transition: transform 200ms ease;
    will-change: transform;
  }
  .expertise-cursor.ist-aktiv {
    transform: translate(-50%, -50%) scale(1);
  }
</style>

<script>
  // Blauer Pfeil-Kreis folgt der Maus über den Leistungs-Zeilen
  // (nur Geräte mit Hover), analog zum Projekt-Grid.
  const liste = document.querySelector('[data-expertise]');
  const cursor = document.querySelector<HTMLElement>('[data-expertise-cursor]');
  if (liste && cursor && window.matchMedia('(hover: hover)').matches) {
    liste.addEventListener('mousemove', (e) => {
      const { clientX, clientY } = e as MouseEvent;
      cursor.style.left = `${clientX}px`;
      cursor.style.top = `${clientY}px`;
    });
    liste.querySelectorAll('[data-expertise-zeile]').forEach((zeile) => {
      zeile.addEventListener('mouseenter', () => cursor.classList.add('ist-aktiv'));
      zeile.addEventListener('mouseleave', () => cursor.classList.remove('ist-aktiv'));
    });
  }
</script>
