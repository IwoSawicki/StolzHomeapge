---
// Leistungs-Sektion (Nachbau Shape „Our Expertise"): schwarze Fläche
// vollflächig (Hintergrund randlos), Inhalt aber auf Seitenbreite
// (max 1200, bündig mit dem Header). Kopf dreispaltig, Leistungen als
// riesige Zeilen mit Trennlinien.
// Hover: aktive Zeile leuchtet, übrige dimmen; links wächst ein
// Vorschaubild von Breite 0 auf, der Zeilentext weicht dabei nach rechts
// aus (kein Fade); zusätzlich folgt der Maus ein blauer Pfeil-Kreis.
// Die Zeilen sind noch NICHT verlinkt — Leistungs-Unterseiten
// (/leistungen/[slug]) folgen laut Roadmap.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '../Button.astro';
import SectionLabel from '../SectionLabel.astro';
import websiteHepa from '../../assets/projekte/website-hepabaut.png';
import websiteJhoch2 from '../../assets/projekte/website-jhoch2-wasserschaden.png';
import websiteBadenBatterie from '../../assets/projekte/website-badenbatterie.png';
import drehDmk from '../../assets/projekte/video-dreh-dmk-bau.jpg';
import drehSaan from '../../assets/projekte/video-dreh-saan-wasserstrahl-1.jpg';
import drehWio from '../../assets/projekte/content-dreh-wio.jpg';

interface Leistung {
  name: string;
  /** kürzeres Label für Mobil (neben dem Bild), fällt auf name zurück */
  kurz?: string;
  vorschau: ImageMetadata;
}
const leistungen: Leistung[] = [
  { name: 'Webseiten & SEO', vorschau: websiteHepa },
  { name: 'Google Ads', vorschau: websiteJhoch2 },
  { name: 'KI-Ranking', vorschau: websiteBadenBatterie },
  { name: 'Social Media Ads', kurz: 'Social Media', vorschau: drehDmk },
  { name: 'Recruiting-Kampagnen', kurz: 'Recruiting', vorschau: drehSaan },
  { name: 'Foto- & Videoproduktion', kurz: 'Foto & Video', vorschau: drehWio },
];
---

<section id="leistungen" class="scroll-mt-24 bg-dark px-5 py-16 md:px-10 md:py-24 xl:py-28">
  <div class="mx-auto max-w-[1200px]">
    <!-- Kopf: Eyebrow / Headline / Kurztext + CTA -->
    <div class="grid grid-cols-1 gap-8 xl:grid-cols-[220px_1fr_320px] xl:gap-10">
      <div class="h-fit">
        <SectionLabel text="Unsere Leistungen" theme="dark" />
      </div>
      <h2 class="max-w-[560px] text-3xl font-semibold text-balance leading-[1.12] tracking-[-0.02em] text-white md:text-4xl xl:mx-auto xl:text-center">
        Womit wir Ihren Betrieb nach vorne bringen
      </h2>
      <div class="flex flex-col items-start gap-5">
        <p class="text-base font-medium leading-[1.5] text-white/70">
          Alles zahlt auf zwei Ziele ein: mehr Aufträge und passende Bewerber — Sie entscheiden, wo wir
          ansetzen.
        </p>
        <Button href="/kontakt" variant="white">Kostenlose Beratung</Button>
      </div>
    </div>

    <!-- Leistungs-Zeilen -->
    <ul class="expertise-liste mt-14 xl:mt-20" data-expertise aria-label="Unsere Leistungen im Überblick">
      {
        leistungen.map((leistung) => (
          <li
            class="expertise-zeile group border-t border-white/12 py-6 transition-opacity duration-300 last:border-b md:py-7 xl:py-8"
            data-expertise-zeile
          >
            <div class="flex items-center">
              {/* Mobil/Tablet: kleines Bild dauerhaft links (wie Shape) */}
              <span class="mr-4 block shrink-0 xl:hidden">
                <Image
                  src={leistung.vorschau}
                  alt=""
                  widths={[120]}
                  sizes="56px"
                  class="size-14 rounded-10 object-cover object-top"
                />
              </span>
              {/* Desktop: Vorschaubild wächst beim Hover von Breite 0 auf */}
              <span class="hidden overflow-hidden transition-[width] duration-500 ease-out xl:block xl:w-0 xl:group-hover:w-[220px]">
                <Image
                  src={leistung.vorschau}
                  alt=""
                  widths={[400]}
                  sizes="200px"
                  class="mr-5 h-[124px] w-[200px] rounded-14 object-cover object-top"
                />
              </span>
              {/* kurzes Label auf Mobil, volles ab Desktop */}
              <span class="text-3xl font-semibold tracking-[-0.03em] text-white md:text-5xl xl:text-7xl">
                <span class="xl:hidden">{leistung.kurz ?? leistung.name}</span>
                <span class="hidden xl:inline">{leistung.name}</span>
              </span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Beim Hover über die Liste dimmen alle Zeilen außer der aktiven
     (Bild-Einblendung bleibt; kein eigener Cursor, da noch nicht
     verlinkt — soll nicht klickbar wirken) */
  @media (hover: hover) {
    .expertise-liste:hover .expertise-zeile {
      opacity: 0.35;
    }
    .expertise-liste:hover .expertise-zeile:hover {
      opacity: 1;
    }
  }
</style>
