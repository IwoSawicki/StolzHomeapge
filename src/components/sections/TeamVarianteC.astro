---
// TEAM-VARIANTE C – „Team-Slider" (Shape-Stil):
// Horizontaler Slider mit dem ganzen Team inkl. Freelancer (4–6 Personen).
// Pfeil-Buttons + Wischen/Drag auf Touch, Scroll-Snap. Zeigt Iwo & Eric
// zuerst, danach die Freelancer nach Gewerk.
// FOTOS: `bild` setzen sobald vorhanden, sonst Initialen-Platzhalter.
// NAMEN/ROLLEN DER FREELANCER = PLATZHALTER — von Iwo ersetzen.
const team = [
  { name: 'Iwo Sawicki', rolle: 'Gründer & Strategie', initialen: 'IS', bild: null },
  { name: 'Eric', rolle: 'Gründer & Kundenbetreuung', initialen: 'E', bild: null },
  { name: 'Freelancer', rolle: 'Foto & Video', initialen: 'FV', bild: null },
  { name: 'Freelancer', rolle: 'Webentwicklung', initialen: 'WE', bild: null },
  { name: 'Freelancer', rolle: 'Google Ads', initialen: 'GA', bild: null },
  { name: 'Freelancer', rolle: 'Grafik & Design', initialen: 'GD', bild: null },
];
---

<section id="team" class="scroll-mt-24 overflow-hidden py-16 md:py-24">
  <p class="mb-10 px-5 text-center text-xs font-medium tracking-wide text-gray uppercase md:px-10">
    Team-Variante C · Slider inkl. Freelancer (zur Auswahl)
  </p>

  <div class="mx-auto max-w-[1240px] px-5 md:px-10">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal>
      <div class="max-w-[600px]">
        <p class="flex items-center gap-2.5 text-sm font-medium text-dark">
          <span class="size-1.5 rounded-full bg-blue" aria-hidden="true"></span>
          Das Team
        </p>
        <h2 class="mt-4 text-4xl font-semibold text-balance leading-[1.06] tracking-[-0.03em] text-dark md:text-5xl">
          Ein eingespieltes Team
        </h2>
        <p class="mt-5 text-lg font-medium leading-[1.5] text-dark/60">
          Iwo und Eric als feste Ansprechpartner — dahinter ein Netzwerk aus Spezialisten für Foto, Video,
          Web und Ads. So bekommen Sie Agentur-Qualität mit persönlichem Kontakt.
        </p>
      </div>

      <div class="flex gap-3" data-slider-nav>
        <button
          type="button"
          data-slider-prev
          aria-label="Zurück"
          class="flex size-12 items-center justify-center rounded-full border border-border bg-white text-dark transition-colors hover:bg-bg-soft disabled:opacity-30"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M11 18l-6-6 6-6" />
          </svg>
        </button>
        <button
          type="button"
          data-slider-next
          aria-label="Weiter"
          class="flex size-12 items-center justify-center rounded-full border border-border bg-white text-dark transition-colors hover:bg-bg-soft disabled:opacity-30"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Slider-Spur: startet am Container-Rand, scrollt frei nach rechts -->
  <div
    data-slider-track
    class="mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-pl-5 px-5 pb-2 [scrollbar-width:none] md:scroll-pl-10 md:px-10 [&::-webkit-scrollbar]:hidden"
  >
    {
      team.map((person) => (
        <article class="w-[260px] shrink-0 snap-start sm:w-[300px]">
          <div class="overflow-hidden rounded-28 bg-bg-blue-light shadow-card-soft">
            <div class="aspect-[3/4] w-full">
              {person.bild ? (
                <img src={person.bild} alt={`Portrait von ${person.name}`} class="h-full w-full object-cover" />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-blue via-blue-bright to-slate">
                  <span class="font-display text-6xl font-extrabold text-white/90">{person.initialen}</span>
                </div>
              )}
            </div>
          </div>
          <div class="px-1 pt-4">
            <h3 class="text-xl font-semibold tracking-[-0.02em] text-dark">{person.name}</h3>
            <p class="mt-0.5 text-sm font-semibold text-blue">{person.rolle}</p>
          </div>
        </article>
      ))
    }
    <!-- rechter Abschluss-Abstand -->
    <div class="w-1 shrink-0 md:w-6" aria-hidden="true"></div>
  </div>
</section>

<script>
  // Pfeil-Buttons scrollen den Track um eine Kartenbreite; Buttons deaktivieren
  // sich an den Enden. Touch/Drag läuft nativ über overflow + scroll-snap.
  const track = document.querySelector<HTMLElement>('[data-slider-track]');
  const prev = document.querySelector<HTMLButtonElement>('[data-slider-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-slider-next]');

  if (track && prev && next) {
    const kartenbreite = () => {
      const karte = track.querySelector('article');
      const lueckeStr = getComputedStyle(track).columnGap || '20';
      return karte ? karte.getBoundingClientRect().width + parseFloat(lueckeStr) : 300;
    };

    const aktualisiere = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -kartenbreite(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: kartenbreite(), behavior: 'smooth' }));
    track.addEventListener('scroll', aktualisiere, { passive: true });
    window.addEventListener('resize', aktualisiere);
    aktualisiere();
  }
</script>
