---
// Einblicke: 4 Spalten mit Ergebnis-Badge + Hochformat-Video-Frame.
// Im Original sind KEINE Videos/Bilder hinterlegt — leere Frames mit
// Play-Icon (Videos „folgen später" laut Text). 1:1 so übernommen.
// Stagger: Desktop/Tablet Spalten 2+3 versetzt (70/50px), Phone Spalten 2+4 (70px).
import SectionHeading from '../SectionHeading.astro';

const spalten = [
  { badge: '125.000+ Aufrufe im ersten Monat', offset: '', video: 1 },
  { badge: '610.000 Aufrufe mit Ads & organischem Content', offset: 'pt-17 md:pt-12 xl:pt-17', video: 2 },
  { badge: 'Überzeugende Anzeigen für die Zielgruppe', offset: 'md:pt-12 xl:pt-17', video: 3 },
  { badge: '182% Profilwachstum in einem Monat', offset: 'pt-17 md:pt-0', video: 4 },
];
---

<section class="px-4.5 pt-14 pb-18 md:px-7 md:pt-18 md:pb-22 xl:px-10 xl:pt-20 xl:pb-25">
  <SectionHeading label="Einblicke" headingMaxWidth={850}>
    <svg slot="icon" class="size-[7px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M 6.75 3.74 L 6.75 20.26 C 6.755 20.53 6.9 20.77 7.14 20.9 C 7.37 21.03 7.66 21.03 7.89 20.89 L 21.4 12.63 C 21.62 12.49 21.75 12.25 21.75 12 C 21.75 11.74 21.62 11.5 21.4 11.37 L 7.89 3.11 C 7.66 2.97 7.37 2.96 7.14 3.09 C 6.9 3.22 6.755 3.47 6.75 3.74 Z"></path>
    </svg>
    So sieht gute Sichtbarkeit in der Praxis aus.
    <Fragment slot="description">
      Vier kurze Video-Beispiele zeigen später, wie Kampagnen, Inhalte und Ergebnisse für Handwerksbetriebe greifbar
      werden.
    </Fragment>
  </SectionHeading>

  <div class="mx-auto mt-7 flex max-w-[1240px] flex-wrap justify-center gap-3 md:mt-10 md:flex-nowrap md:gap-4 xl:gap-6">
    {
      spalten.map((s) => (
        <div class={`flex w-[47%] flex-col gap-4 md:w-auto md:flex-1 ${s.offset}`}>
          <div class="flex w-fit max-w-full items-center gap-2.5 rounded-14 border border-blue-bright/35 bg-white py-2.5 pr-3.5 pl-2.5 shadow-card-soft">
            <span class="flex size-8.5 shrink-0 items-center justify-center rounded-full bg-blue-bright/10 text-blue-bright">
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M 21.75 5.25 L 15.75 5.25 M 21.75 5.25 L 21.75 11.25 M 21.75 5.25 L 12.75 14.25 L 9 10.5 L 2.25 17.25" />
              </svg>
            </span>
            <p class="text-sm font-semibold leading-[1.3] tracking-[-0.01em] text-slate">{s.badge}</p>
          </div>
          <div
            class="flex aspect-[9/16] w-full items-center justify-center rounded-20 bg-linear-160 from-video-dark-1 to-video-dark-2"
            role="img"
            aria-label={`Video-Beispiel ${s.video}: folgt in Kürze`}
          >
            <span class="flex size-[58px] items-center justify-center rounded-full bg-white/14">
              <svg class="size-[22px] translate-x-px" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M 6.75 3.74 L 6.75 20.26 C 6.755 20.53 6.9 20.77 7.14 20.9 C 7.37 21.03 7.66 21.03 7.89 20.89 L 21.4 12.63 C 21.62 12.49 21.75 12.25 21.75 12 C 21.75 11.74 21.62 11.5 21.4 11.37 L 7.89 3.11 C 7.66 2.97 7.37 2.96 7.14 3.09 C 6.9 3.22 6.755 3.47 6.75 3.74 Z" />
              </svg>
            </span>
          </div>
        </div>
      ))
    }
  </div>
</section>
