---
// „Kennen Sie das?" – 6 Problem-Karten in grauem Container.
// Maße: Container 1200, Radius 30, Pad 20, Shadow-Stack, bg #F9FAFB (→ bg-soft);
// Grid Gap 7→8, Karten weiß, Radius 30, Pad 20, 1px-Rahmen #E5EAF0,
// Icon-Quadrat 36×36 Radius 12 in Orange 9 % (Original ohne Icon-Grafik).
import SectionHeading from '../SectionHeading.astro';
import Button from '../Button.astro';

const karten = [
  {
    titel: 'Online kommt nichts rein',
    text: 'Die Webseite steht – aber Anfragen kommen weiterhin nur über Empfehlungen. Das limitiert das Wachstum.',
  },
  {
    titel: 'Werbebudget verpufft',
    text: 'Geld fließt in Google- oder Meta-Anzeigen, aber niemand kann nachvollziehbar sagen, was am Ende dabei herauskommt.',
  },
  {
    titel: 'Die Konkurrenz wirkt größer',
    text: 'Online sehen Mitbewerber professioneller aus – obwohl Sie das bessere Handwerk liefern.',
  },
  {
    titel: 'Falsche Anfragen',
    text: 'Wenn online jemand anfragt, sind es oft Preisjäger oder Aufträge, die sich am Ende nicht rechnen.',
  },
  {
    titel: 'Keine guten Bewerbungen',
    text: 'Junge Fachkräfte finden den Betrieb online nicht – oder die Web-Präsenz wirkt nicht wie ein moderner Arbeitgeber.',
  },
  {
    titel: 'Marketing als Blackbox',
    text: 'Eine Agentur "macht was" – aber niemand erklärt verständlich, was passiert, was es bringt und warum.',
  },
];
---

<section class="px-3 py-12 md:px-10 md:py-25">
  <SectionHeading label="Probleme" headingMaxWidth={800}>
    Kennen Sie das?
    <Fragment slot="description">
      Wer online nicht sichtbar ist, verliert täglich Aufträge an Mitbewerber – die online besser auftreten, aber
      nicht zwangsläufig besser arbeiten.
    </Fragment>
  </SectionHeading>

  <div class="mx-auto mt-10 max-w-[1200px] rounded-30 bg-bg-soft p-5 shadow-stack">
    <ul class="grid grid-cols-1 gap-2 md:grid-cols-2 xl:grid-cols-3">
      {
        karten.map((karte) => (
          <li class="rounded-30 border border-border bg-white p-5">
            <div class="size-9 rounded-[12px] bg-orange-soft" aria-hidden="true"></div>
            <h3 class="mt-[7px] text-xl font-medium tracking-[-0.03em] text-dark">{karte.titel}</h3>
            <p class="mt-12 text-15 font-medium tracking-[-0.01em] text-dark/60">{karte.text}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <p class="mx-auto mt-10 max-w-[800px] text-center text-lg font-medium text-balance leading-[1.4] tracking-[-0.01em] text-dark">
    <strong>Klingt bekannt?</strong> Genau dafür sind wir da – und wir zeigen dir in 30 Minuten, was bei deinem
    Betrieb konkret möglich ist.
  </p>
  <div class="mt-4 flex justify-center">
    <Button href="/kontakt" variant="blue" shadow="blue-glow">Jetzt unverbindlich anfragen</Button>
  </div>
</section>
