---
/* „Leistungsumfang“: dunkles Band mit drei Karten, in denen die Leistungen
   als Häkchenliste stehen. Beide Leistungsseiten teilen sich den Aufbau.
   Vorlage: data-screen-label="4 Leistungsumfang" */
interface Block {
  titel: string;
  punkte: string[];
}

interface Props {
  eyebrow: string;
  /** Text vor dem hervorgehobenen Teil der Überschrift */
  titelVorn: string;
  /** hervorgehobener Teil (Textmarker, kursiv) */
  titelAkzent: string;
  lead: string;
  bloecke: Block[];
}

const { eyebrow, titelVorn, titelAkzent, lead, bloecke } = Astro.props;
---

<section class="bg-forest px-20 py-section-y-lg">
  <div class="mx-auto flex max-w-content flex-col gap-56">
    <div class="flex flex-wrap items-end gap-x-64 gap-y-32">
      <div class="flex flex-1 basis-460 flex-col items-start gap-16">
        <span class="font-mono text-12 tracking-eyebrow uppercase text-mint-dim">
          {eyebrow}
        </span>
        <h2
          class="m-0 text-h2-sub-lg leading-tightest font-bold tracking-system text-paper"
        >
          {titelVorn}<span class="marker-flach font-display font-semibold italic"
            >{titelAkzent}</span
          >
        </h2>
      </div>
      <p class="m-0 max-w-420 flex-1 basis-340 text-18 leading-prose text-mint-light">
        {lead}
      </p>
    </div>

    <div
      class="grid grid-cols-[repeat(auto-fit,minmax(min(300px,100%),1fr))] items-stretch gap-24"
    >
      {
        bloecke.map((block, i) => (
          <div class="flex flex-col rounded-18 border border-edge bg-forest-review px-quote-x py-quote-y">
            <div class="flex items-baseline gap-12 border-b border-edge pb-16">
              <span class="font-mono text-12 text-lime">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="m-0 text-19 font-bold tracking-name text-cream">
                {block.titel}
              </h3>
            </div>
            <ul class="m-0 flex list-none flex-col gap-12 p-0 pt-20">
              {block.punkte.map((punkt) => (
                <li class="grid grid-cols-[20px_minmax(0,1fr)] gap-8 text-16 leading-quote text-mint-light">
                  <span class="text-lime" aria-hidden="true">
                    ✓
                  </span>
                  <span>{punkt}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
