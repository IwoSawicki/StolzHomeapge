---
/* „Erstgespräch": dunkler Abschlussblock beider Leistungsseiten. Links der
   Vertrauens-Baustein und die Telefonnummer, rechts das Anfrageformular als
   abgesetzte Karte. Steht im selben Band wie der Footer.

   Beide Seiten teilen sich dieses Bauteil. Die Überschrift ist auf beiden
   gleich gebaut: „richtigen Agentur" trägt den gelben Textmarker — das ist
   der gemeinsame Nenner —, der Schlussteil steht in Serifen-Kursive ohne
   Marker und unterscheidet die beiden Seiten.
   Vorlage: data-screen-label="9 Abschluss" */
import Web3Formular from '../../Web3Formular.astro';
import type { Feld } from '../../Web3Formular.astro';
import { kontakt } from '../../../data/navigation';

interface Props {
  /** Text vor dem markierten Teil */
  titelVorn: string;
  /** Gelb markiert — auf beiden Seiten „richtigen Agentur" */
  titelMarker: string;
  /** Text zwischen Marker und Serifen-Kursive */
  titelMitte: string;
  /** Serifen-Kursive, ohne Marker — der Teil, der die Seiten unterscheidet */
  titelKursiv: string;
  /** Text danach, meist der Schlusspunkt */
  titelHinten: string;
  lead: string;
  felder: Feld[];
  /** Betreff der Mail, die bei Iwo ankommt */
  betreff: string;
  /** Zeile unter der Telefonnummer. Auf /mitarbeiter-gewinnen bewusst leer:
      dort steht laut Handoff kein Ortsname auf der Seite. */
  ortZeile?: string;
}

const {
  titelVorn,
  titelMarker,
  titelMitte,
  titelKursiv,
  titelHinten,
  lead,
  felder,
  betreff,
  ortZeile,
} = Astro.props;
---

<section id="anfrage" class="bg-forest-deep px-20 py-[clamp(64px,9vw,104px)]">
  <div class="mx-auto flex max-w-content-wide flex-wrap items-start gap-x-64 gap-y-48">
    <div class="flex flex-1 basis-400 flex-col items-start gap-20">
      <span class="font-mono text-12 tracking-eyebrow uppercase text-mint-dim">
        Erstgespräch
      </span>

      <h2 class="m-0 text-h2-sub leading-tightest font-bold tracking-system text-paper">
        {titelVorn}<span class="marker">{titelMarker}</span>{titelMitte}<span
          class="font-display font-semibold tracking-none italic">{titelKursiv}</span
        >{titelHinten}
      </h2>

      <p class="m-0 max-w-620 text-18 leading-prose text-mint-light">{lead}</p>

      <div class="mt-12 flex flex-col gap-4 border-t border-edge pt-26">
        <span class="text-15 text-mint-dim">Lieber direkt anrufen?</span>
        <a
          href={kontakt.telefonLink}
          class="text-22 font-bold tracking-name text-paper no-underline transition-colors hover:text-lime"
          >{kontakt.telefonAnzeige}</a
        >
        {ortZeile && <span class="text-15 text-mint-dim">{ortZeile}</span>}
      </div>
    </div>

    <Web3Formular
      felder={felder}
      betreff={betreff}
      knopfText="Erstgespräch anfragen"
      variante="dunkel"
      class="flex-1 basis-400 rounded-20 border border-edge bg-forest-review px-quote-x py-quote-y"
    />
  </div>
</section>
