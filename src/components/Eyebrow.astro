---
/* Eyebrow-Pill über den Sektionsüberschriften.
   Einheitlich 13px/500, Laufweite 0.14em, Versalien, Radius 999px —
   nur die Farbgebung wechselt mit dem Untergrund. */
interface Props {
  /**
   * lime   – Hero (dunkel, Lime-Rahmen)
   * dunkel – dunkle Bänder (Projekte, Bewertungen)
   * hell   – helle Sektionen (Leistungen, Branchen, Unser System)
   * warm   – Über-uns-Panel (wärmerer Rahmen)
   */
  variante: 'lime' | 'dunkel' | 'hell' | 'warm';
  class?: string;
}

const { variante, class: klasse } = Astro.props;

const varianten: Record<Props['variante'], string> = {
  lime: 'border-lime text-lime',
  dunkel: 'border-edge text-mint',
  hell: 'border-line-strong text-ink-muted',
  warm: 'border-rule-soft text-ink-label',
};
---

<span
  class:list={[
    'inline-block rounded-full border px-16 py-8 text-13 font-medium tracking-eyebrow uppercase',
    varianten[variante],
    klasse,
  ]}
>
  <slot />
</span>
