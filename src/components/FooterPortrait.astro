---
/* ENTWURF (03.10.2026): Footer mit Porträt.

   Vorbild von Iwo: der Footer von lumix.solar. Heller Grund mit einer
   Schräge in Lime, links eine weiße Karte mit den Link-Spalten und unten
   rechts darin ein dunkler Kasten mit E-Mail und Telefon, rechts daneben
   das Porträt mit dem Erstgespräch-Knopf. Auf dem Handy steht das
   Porträt zuerst, darunter die Karte.

   Inhalte wie im bisherigen Footer, aus src/data/navigation.ts. Bisher
   nur auf der Social-Media-Seite (dev, noindex) zum Vergleich; der
   bisherige Footer bleibt auf allen anderen Seiten. */
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import Button from './Button.astro';
import portrait from '../assets/portraits/iwo-sawicki.jpg';
import {
  erstgespraech,
  footerMenue,
  footerTools,
  footerBranchen,
  footerStandorte,
  footerRechtliches,
  socialLinks,
  kontakt,
} from '../data/navigation';

const linkKlasse = 'text-15 font-medium text-ink no-underline transition-colors hover:text-lime-link-hover';
/* Seiten, die es noch nicht gibt, stehen grau da statt ins Leere zu führen */
const bald = 'text-15 font-medium text-ink-faint';
const ueberschrift = 'font-mono text-12 tracking-footer uppercase text-ink-faint';
const innen = 'px-[clamp(22px,4vw,44px)]';

/* Reihenfolge der Spalten: was am meisten gesucht wird, zuerst */
const spalten = [
  { titel: 'Leistungen vor Ort', links: footerStandorte },
  { titel: 'Branchen', links: footerBranchen },
  { titel: 'Menü', links: footerMenue },
];

const jahr = 2026;
---

<footer class="relative overflow-hidden bg-paper-soft px-page-x pt-section-y-md pb-36">
  {/* Schräge in Lime mit einer feinen Linie daneben, wie im Vorbild */}
  <svg
    class="pointer-events-none absolute inset-0 h-full w-full"
    viewBox="0 0 100 100"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <polygon class="fill-lime" points="0,0 24,0 44,100 0,100" />
    <line class="stroke-lime" x1="31" y1="0" x2="51" y2="100" stroke-width="1.5" vector-effect="non-scaling-stroke" />
  </svg>

  <div class="relative mx-auto flex max-w-content-wide flex-col gap-28">
    <div class="grid grid-cols-1 gap-20 nav:grid-cols-[minmax(0,1fr)_minmax(0,340px)] nav:gap-24">
      {/* --- Porträt mit Erstgespräch ---------------------------------- */}
      <div class="relative aspect-square max-h-560 w-full overflow-hidden rounded-24 bg-forest-card nav:order-2 nav:aspect-auto nav:h-full nav:max-h-none nav:min-h-560">
        <Image
          src={portrait}
          alt="Iwo Sawicki, Inhaber von Stolz Marketing"
          widths={[420, 760, 1100]}
          sizes="(min-width: 1040px) 340px, 100vw"
          class="absolute inset-0 h-full w-full object-cover"
          style="object-position: 50% 20%"
          loading="lazy"
        />
        <div class="absolute inset-x-0 bottom-0 flex flex-col items-stretch gap-14 bg-linear-to-t from-forest-deep/85 via-forest-deep/45 to-transparent px-14 pt-120 pb-18">
          <span class="text-center text-14 text-cream">
            <strong class="font-bold text-paper">Iwo Sawicki</strong> · Inhaber
          </span>
          <Button href={erstgespraech.href} variante="lime" class="gap-12">
            {erstgespraech.label}<span class="text-18" aria-hidden="true">→</span>
          </Button>
        </div>
      </div>

      {/* --- Karte mit den Links --------------------------------------- */}
      <div class="flex flex-col overflow-hidden rounded-24 bg-paper shadow-card-light ring-1 ring-lime/70 nav:order-1">
        <div
          class:list={[
            innen,
            /* Jede Spalte so breit wie ihr längster Eintrag, verteilt über
               die ganze Breite: auf dem Desktop vier nebeneinander ohne
               Umbruch, auf dem Handy zwei, auf 320px eine. */
            'grid grid-cols-[repeat(auto-fit,minmax(min(140px,100%),max-content))] justify-between gap-x-16 gap-y-36 pt-[clamp(28px,4vw,44px)] pb-36',
          ]}
        >
          {
            spalten.map((s) => (
              <nav aria-label={s.titel} class="flex flex-col gap-18">
                <span class={ueberschrift}>{s.titel}</span>
                <div class="flex flex-col gap-14">
                  {s.links.map((l) =>
                    l.nochNicht ? <span class={bald}>{l.label}</span> : <a href={l.href} class={linkKlasse}>{l.label}</a>,
                  )}
                </div>
              </nav>
            ))
          }
          <nav aria-label="Tools und Social Media" class="flex flex-col gap-18">
            <span class={ueberschrift}>Tools</span>
            <div class="flex flex-col gap-14">
              {footerTools.map((l) =>
                l.nochNicht ? <span class={bald}>{l.label}</span> : <a href={l.href} class={linkKlasse}>{l.label}</a>,
              )}
            </div>
            <span class:list={[ueberschrift, 'mt-14']}>Social</span>
            <div class="flex flex-col gap-14">
              {socialLinks.map((l) => <a href={l.href} rel="noopener" class={linkKlasse}>{l.label}</a>)}
            </div>
          </nav>
        </div>

        {/* Fuß der Karte: links Logo, rechts der dunkle Kontaktkasten bündig
            in der Ecke */}
        <div class="mt-auto flex flex-wrap items-end justify-between gap-y-24">
          <div class:list={[innen, 'flex flex-col gap-10 pb-28']}>
            <Logo variante="dunkel" hoehe={24} />
            <span class="text-14 leading-body text-ink-muted">
              {kontakt.ortZeile1}, {kontakt.ortZeile2}
            </span>
          </div>
          <div class="ml-auto flex flex-1 basis-[min(460px,100%)] flex-wrap gap-x-40 gap-y-18 bg-forest-deep px-[clamp(22px,3vw,36px)] py-24 btn:flex-none btn:rounded-tl-20">
            <div class="flex flex-col gap-6">
              <span class="font-mono text-11 tracking-footer uppercase text-mint-dimmer">E-Mail</span>
              <a href={`mailto:${kontakt.email}`} class="text-18 font-bold text-paper no-underline transition-colors hover:text-lime">
                {kontakt.email}
              </a>
            </div>
            <div class="flex flex-col gap-6">
              <span class="font-mono text-11 tracking-footer uppercase text-mint-dimmer">Telefon</span>
              <a href={kontakt.telefonLink} class="text-18 font-bold text-paper no-underline transition-colors hover:text-lime">
                {kontakt.telefonAnzeige}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* --- Copyright und Rechtliches ------------------------------------- */}
    <div class="flex flex-wrap items-center justify-between gap-x-32 gap-y-12">
      <span class="text-14 font-medium text-ink">© {jahr} Stolz Marketing · Alle Rechte vorbehalten</span>
      <div class="flex flex-wrap gap-x-28 gap-y-10">
        {
          footerRechtliches.map((l) =>
            l.cookieSchalter ? (
              /* Öffnet das Einwilligungsbanner erneut */
              <button type="button" data-cookie-reset class="cursor-pointer border-none bg-transparent p-0 text-left font-[inherit] text-14 font-medium text-ink transition-colors hover:text-lime-link-hover">
                {l.label}
              </button>
            ) : (
              <a href={l.href} class="text-14 font-medium text-ink no-underline transition-colors hover:text-lime-link-hover">{l.label}</a>
            ),
          )
        }
      </div>
    </div>
  </div>
</footer>
