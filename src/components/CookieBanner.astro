---
/* Einwilligungsbanner für Google Analytics und Microsoft Clarity.

   Logik unverändert vom bisherigen Auftritt (Branch main), Gestaltung aus
   dem neuen Designsystem:

   - Beide Dienste werden NICHT automatisch geladen, sondern erst nach
     „Akzeptieren".
   - Die Wahl liegt in localStorage; danach erscheint das Banner nicht mehr.
   - Über „Cookie-Einstellungen" im Footer lässt sie sich neu treffen.
   - Getrackt wird nur auf der Produktionsdomain, nicht auf der Vorschau.

   Clarity zeichnet Sitzungen auf (Mausweg, Klicks, Scrollen) und setzt
   eigene Cookies. Es braucht damit dieselbe Einwilligung wie GA und darf
   auf keinen Fall vorab laden.

   Der sichtbare Text nennt bewusst keine Dienstnamen mehr (Wunsch Iwo):
   Zweck plus Link auf die Datenschutzerklärung, dort stehen Anbieter,
   Cookies und Rechtsgrundlage im Detail.

   Umami braucht kein Banner: cookielos, läuft direkt im BaseLayout. */
const GA_ID = 'G-ZK7F06197Z';
const CLARITY_ID = 'yfldl5r8k0';
---

<div
  data-cookie-banner
  aria-live="polite"
  class="pointer-events-none fixed inset-x-0 bottom-0 z-90 hidden p-16 btn:inset-x-auto btn:right-24 btn:bottom-24 btn:p-0"
>
  <div
    class="pointer-events-auto mx-auto flex max-w-440 flex-col gap-12 rounded-20 border border-line bg-paper p-24 shadow-[0_18px_48px_rgb(20_26_21/0.18)]"
  >
    <p class="m-0 text-17 font-bold tracking-name text-ink">Cookies</p>
    <p class="m-0 text-15 leading-body text-ink-muted">
      Wir verwenden Cookies, um unsere Website auszuwerten. Details in der <a
        href="/datenschutz"
        class="underline underline-offset-2 hover:text-lime-link-hover"
        >Datenschutzerklärung</a
      >.
    </p>
    <div class="mt-4 flex flex-col gap-10 btn:flex-row">
      <button
        type="button"
        data-cookie-accept
        class="flex-1 cursor-pointer rounded-10 border-none bg-lime px-20 py-12 font-[inherit] text-15 font-bold text-forest-deep transition-colors duration-200 hover:bg-lime-bright"
      >
        Akzeptieren
      </button>
      <button
        type="button"
        data-cookie-decline
        class="flex-1 cursor-pointer rounded-10 border border-line-strong bg-paper px-20 py-12 font-[inherit] text-15 font-medium text-ink transition-colors duration-200 hover:bg-paper-warm"
      >
        Ablehnen
      </button>
    </div>
  </div>
</div>

<script define:vars={{ GA_ID, CLARITY_ID }}>
  const SCHLUESSEL = 'stolz-consent';
  const banner = document.querySelector('[data-cookie-banner]');

  // Nur auf der Produktionsdomain zählen, nicht auf Vorschau oder lokal
  function istProduktion() {
    const host = location.hostname;
    return host === 'stolz-marketing.de' || host === 'www.stolz-marketing.de';
  }

  function ladeGA() {
    if (window.__gaGeladen) return;
    if (!istProduktion()) return;
    window.__gaGeladen = true;

    const skript = document.createElement('script');
    skript.async = true;
    skript.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
    document.head.appendChild(skript);

    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    window.gtag = gtag;
    gtag('js', new Date());
    gtag('config', GA_ID, { anonymize_ip: true });
  }

  // Offizieller Clarity-Schnipsel, nur in eine Funktion gepackt, damit er
  // erst nach der Einwilligung läuft.
  function ladeClarity() {
    if (window.__clarityGeladen) return;
    if (!istProduktion()) return;
    window.__clarityGeladen = true;

    (function (c, l, a, r, i, t, y) {
      c[a] =
        c[a] ||
        function () {
          (c[a].q = c[a].q || []).push(arguments);
        };
      t = l.createElement(r);
      t.async = 1;
      t.src = 'https://www.clarity.ms/tag/' + i;
      y = l.getElementsByTagName(r)[0];
      y.parentNode.insertBefore(t, y);
    })(window, document, 'clarity', 'script', CLARITY_ID);
  }

  function ladeDienste() {
    ladeGA();
    ladeClarity();
  }

  const zeige = () => banner?.classList.remove('hidden');
  const verstecke = () => banner?.classList.add('hidden');

  const wahl = localStorage.getItem(SCHLUESSEL);
  if (wahl === 'accepted') ladeDienste();
  else if (wahl !== 'declined') zeige();

  document.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
    localStorage.setItem(SCHLUESSEL, 'accepted');
    ladeDienste();
    verstecke();
  });

  document.querySelector('[data-cookie-decline]')?.addEventListener('click', () => {
    localStorage.setItem(SCHLUESSEL, 'declined');
    verstecke();
  });

  // „Cookie-Einstellungen" im Footer öffnet die Wahl erneut
  document.querySelectorAll('[data-cookie-reset]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      zeige();
    });
  });
</script>
