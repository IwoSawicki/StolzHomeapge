---
/* Kopfbereich.

   Aufbau übernommen vom bisherigen Auftritt (Branch main), Farben und
   Maße aus dem neuen Designsystem:

   Desktop (ab 1040px)
     1. statische Navigation im Seitenkopf, scrollt mit weg
     2. ab 500px Scrolltiefe fährt eine Leiste von oben ein, deren Links in
        einer abgesetzten Pille mit Blur sitzen — wie beim alten Auftritt

   Mobil (unter 1040px)
     1. oben ein statischer Balken mit Logo und Menü-Knopf, dessen Menü
        nach unten aufklappt; scrollt mit weg
     2. sobald er aus dem Blick ist, erscheint unten eine schwebende
        Glas-Pille. Ihre Links klappen nach OBEN auf, gestaffelt, mit
        geblurrtem Hintergrund dahinter.

   Der Papierflieger-CTA bleibt an allen drei Stellen derselbe. */
import Logo from './Logo.astro';
import PfeilIcon from './icons/Papierflieger.astro';
import { hauptnavigation, erstgespraech } from '../data/navigation';

interface Props {
  /** dunkel = Grün (Startseite), hell = Weiß (Projekte, Rechtstexte, Kontakt) */
  variante?: 'dunkel' | 'hell';
}
const { variante = 'dunkel' } = Astro.props;

const istHell = variante === 'hell';

const navLink = istHell
  ? 'text-ink hover:bg-paper-hover'
  : 'text-cream hover:bg-forest-card';
---

{/* ---------- Desktop: schwebende Pille oben ab 500px Scrolltiefe ----------
     Gleiche Optik wie das mobile Menü: weiß-transparentes Glas mit Blur,
     Rahmen, weichem Schatten und runden Ecken — nur eben oben statt unten
     und auf Inhaltsbreite statt über die ganze Fensterbreite. */}
<div
  data-sticky-nav
  class:list={[
    'fixed inset-x-0 top-0 z-50 hidden px-20 pt-14 nav:block',
    'pointer-events-none -translate-y-[130%] opacity-0 will-change-transform',
    'transition-[transform,opacity] duration-[380ms] ease-sticky',
    'data-[stuck]:pointer-events-auto data-[stuck]:translate-y-0 data-[stuck]:opacity-100',
  ]}
>
  <nav
    aria-label="Hauptnavigation"
    class="glaspille glaspille-hell mx-auto flex max-w-content items-center gap-x-24 rounded-24 py-10 pr-10 pl-20 backdrop-blur-[14px] backdrop-saturate-[1.6]"
  >
    <a href="/" class="inline-flex items-center no-underline" aria-label="Zur Startseite">
      {/* Die Pille ist immer hell, deshalb hier immer die dunkle Wortmarke */}
      <Logo variante="dunkel" hoehe={24} />
    </a>

    <div class="ml-auto flex flex-wrap items-center gap-4">
      {
        hauptnavigation.map((link) => (
          <a
            href={link.href}
            class="flex h-38 items-center rounded-10 px-14 text-15 font-medium text-ink no-underline transition-colors hover:bg-paper-warm"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a
      href={erstgespraech.href}
      class="ml-8 inline-flex h-38 items-center gap-8 rounded-10 bg-lime px-16 text-15 font-medium text-forest-deep no-underline shadow-glow transition-colors duration-200 hover:bg-lime-hover"
    >
      <PfeilIcon groesse={15} />
      {erstgespraech.label}
    </a>
  </nav>
</div>

{/* ---------- Statische Navigation im Seitenkopf ---------- */}
<nav
  data-topbar
  aria-label="Hauptnavigation"
  class="relative z-2 flex flex-wrap items-center gap-x-28 gap-y-14 px-page-x py-18"
>
  <a href="/" class="inline-flex items-center no-underline" aria-label="Zur Startseite">
    <Logo variante={istHell ? 'dunkel' : 'hell'} hoehe={26} />
  </a>

  <div class="ml-auto hidden flex-wrap items-center gap-8 nav:flex">
    {
      hauptnavigation.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-8 px-12 py-8 text-14 font-medium no-underline transition-colors',
            navLink,
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </div>

  <a
    href={erstgespraech.href}
    class="hidden h-44 items-center gap-10 rounded-8 bg-lime px-18 text-15 font-medium text-forest-deep no-underline shadow-glow-strong transition-colors duration-200 hover:bg-lime-hover nav:inline-flex"
  >
    <PfeilIcon />
    {erstgespraech.label}
  </a>

  {/* Mobil: Menü-Knopf, klappt das Menü darunter auf */}
  <button
    type="button"
    data-topmenu-toggle
    aria-label="Menü öffnen"
    aria-expanded="false"
    aria-controls="menue-oben"
    class:list={[
      'relative ml-auto block h-42 w-42 flex-none cursor-pointer rounded-10 border p-0 nav:hidden',
      istHell ? 'border-line-strong bg-paper-warm' : 'border-lime/28 bg-lime/8',
    ]}
  >
    <span
      data-topline="oben"
      class:list={[
        'absolute top-[15px] left-[11px] block h-2 w-18 rounded-2 transition-transform duration-200',
        istHell ? 'bg-ink' : 'bg-lime',
      ]}
    ></span>
    <span
      data-topline="unten"
      class:list={[
        'absolute top-[24px] left-[11px] block h-2 w-18 rounded-2 transition-transform duration-200',
        istHell ? 'bg-ink' : 'bg-lime',
      ]}
    ></span>
  </button>

  {/* Aufklappmenü des oberen Balkens */}
  <nav
    id="menue-oben"
    data-topmenu
    aria-label="Mobilnavigation oben"
    class:list={[
      'absolute inset-x-0 top-full z-50 flex origin-top flex-col gap-4 border-b px-page-x pt-8 pb-24 nav:hidden',
      istHell
        ? 'border-line bg-paper shadow-[0_18px_40px_rgb(20_26_21/0.12)]'
        : 'border-edge-soft bg-forest shadow-[0_18px_40px_rgb(9_24_17/0.55)]',
    ]}
  >
    {
      hauptnavigation.map((link) => (
        <a
          href={link.href}
          data-topmenu-link
          class:list={[
            'border-b py-14 text-22 font-medium no-underline last:border-b-0',
            istHell ? 'border-line text-ink' : 'border-edge-soft text-cream',
          ]}
        >
          {link.label}
        </a>
      ))
    }
    <a
      href={erstgespraech.href}
      data-topmenu-link
      class="mt-16 inline-flex h-50 items-center justify-center gap-10 rounded-10 bg-lime px-20 text-16 font-medium text-forest-deep no-underline shadow-glow"
    >
      <PfeilIcon />
      {erstgespraech.label}
    </a>
  </nav>
</nav>

{/* ---------- Mobil: schwebende Pille unten ---------- */}
<div
  data-pillnav
  class="pill-versteckt fixed inset-x-0 bottom-0 z-50 px-16 pb-[max(14px,env(safe-area-inset-bottom))] nav:hidden"
>
  <div
    data-pill
    class:list={['glaspille mx-auto flex w-full flex-col overflow-hidden rounded-24 backdrop-blur-[14px] backdrop-saturate-[1.6]',
      istHell && 'glaspille-hell']}
  >
    {/* Links – stehen im DOM ÜBER der Zeile, klappen also nach oben auf */}
    <nav id="menue-pille" data-pill-links class="glaspille-links" aria-label="Mobilnavigation">
      <div class="px-20 pt-20 pb-16">
        {
          hauptnavigation.map((link, i) => (
            <a
              href={link.href}
              data-pill-link
              data-staffel
              style={`--i:${i}`}
              class:list={[
                'flex items-center border-b py-14 text-26 font-bold tracking-heading no-underline last:border-b-0',
                istHell ? 'border-line text-ink' : 'border-edge-soft text-cream',
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <div data-staffel style={`--i:${hauptnavigation.length}`} class="mt-20">
          <a
            href={erstgespraech.href}
            data-pill-link
            class="inline-flex h-50 w-full items-center justify-center gap-10 rounded-10 bg-lime px-20 text-16 font-medium text-forest-deep no-underline shadow-glow"
          >
            <PfeilIcon />
            {erstgespraech.label}
          </a>
        </div>
      </div>
    </nav>

    {/* Immer sichtbare Zeile: Logo links, Menü-Knopf rechts */}
    <div class="flex items-center justify-between gap-16 py-10 pr-10 pl-20">
      <a href="/" class="inline-flex items-center no-underline" aria-label="Zur Startseite">
        <Logo variante={istHell ? 'dunkel' : 'hell'} hoehe={22} />
      </a>
      <button
        type="button"
        data-pill-toggle
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="menue-pille"
        class="relative block h-42 w-42 flex-none cursor-pointer rounded-full border-none bg-transparent p-0"
      >
        <span
          data-pillline="oben"
          class:list={[
            'absolute top-[15px] left-[11px] block h-2 w-18 rounded-2 transition-transform duration-200',
            istHell ? 'bg-ink' : 'bg-lime',
          ]}></span>
        <span
          data-pillline="unten"
          class:list={[
            'absolute top-[24px] left-[11px] block h-2 w-18 rounded-2 transition-transform duration-200',
            istHell ? 'bg-ink' : 'bg-lime',
          ]}></span>
      </button>
    </div>
  </div>
</div>

{/* Geblurrter Hintergrund, solange die Pille offen ist */}
<div
  data-pill-backdrop
  class="fixed inset-0 z-40 hidden bg-forest-deep/30 backdrop-blur-[3px] nav:hidden"
>
</div>

<style>
  /* --- Pille unten: Ein- und Ausfahren --- */
  [data-pillnav] {
    transition:
      opacity 300ms ease,
      transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-pillnav].pill-versteckt {
    opacity: 0;
    transform: translateY(130%);
    pointer-events: none;
  }

  /* --- Aufklappmenü des oberen Balkens --- */
  [data-topmenu] {
    transform: translateY(-8px);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 200ms ease,
      transform 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-topmenu].ist-offen {
    transform: none;
    opacity: 1;
    pointer-events: auto;
  }

  /* --- Glas-Pille --- */
  .glaspille {
    background: color-mix(in srgb, var(--color-forest) 82%, transparent);
    border: 1px solid var(--color-edge);
    box-shadow: 0 8px 32px rgb(9 24 17 / 0.38);
    /* Der Blur steht als Utility am Element: im Scoped-CSS hat der Minifier
       die unpräfixierte Zeile verworfen und nur -webkit- übrig gelassen. */
    transition: max-width 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .glaspille.ist-offen {
    background: color-mix(in srgb, var(--color-forest) 95%, transparent);
  }
  .glaspille-hell {
    background: color-mix(in srgb, var(--color-paper) 82%, transparent);
    border-color: var(--color-line);
    box-shadow: 0 8px 32px rgb(20 26 21 / 0.14);
  }
  .glaspille-hell.ist-offen {
    background: color-mix(in srgb, var(--color-paper) 95%, transparent);
  }

  /* --- Links klappen nach oben auf --- */
  .glaspille-links {
    max-height: 0;
    overflow: hidden;
    transition: max-height 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .glaspille.ist-offen .glaspille-links {
    max-height: 78vh;
    overflow-y: auto;
  }

  /* --- Einträge gestaffelt einblenden --- */
  .glaspille-links [data-staffel] {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 300ms ease,
      transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .glaspille.ist-offen .glaspille-links [data-staffel] {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 45ms);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-pillnav],
    [data-topmenu],
    .glaspille,
    .glaspille-links,
    .glaspille-links [data-staffel] {
      transition: none;
    }
  }
</style>

<script>
  // ---------- Desktop: Sticky-Leiste ab 500px Scrolltiefe ----------
  const stickyNav = document.querySelector<HTMLElement>('[data-sticky-nav]');
  if (stickyNav) {
    const pruefen = () => {
      const y = document.scrollingElement?.scrollTop ?? window.scrollY ?? 0;
      stickyNav.toggleAttribute('data-stuck', y > 500);
    };
    window.addEventListener('scroll', pruefen, { passive: true });
    pruefen();
  }

  // Menü-Knopf: Balken zum Kreuz drehen
  const zuKreuz = (oben: HTMLElement | null, unten: HTMLElement | null, offen: boolean) => {
    if (oben) oben.style.transform = offen ? 'translateY(4.5px) rotate(45deg)' : '';
    if (unten) unten.style.transform = offen ? 'translateY(-4.5px) rotate(-45deg)' : '';
  };

  // ---------- Oberer Balken: Menü klappt nach unten auf ----------
  const topbar = document.querySelector<HTMLElement>('[data-topbar]');
  const topToggle = document.querySelector<HTMLButtonElement>('[data-topmenu-toggle]');
  const topMenu = document.querySelector<HTMLElement>('[data-topmenu]');
  const topLinien = {
    oben: document.querySelector<HTMLElement>('[data-topline="oben"]'),
    unten: document.querySelector<HTMLElement>('[data-topline="unten"]'),
  };

  let topOffen = false;
  const setzeTop = (offen: boolean) => {
    topOffen = offen;
    topMenu?.classList.toggle('ist-offen', offen);
    topToggle?.setAttribute('aria-expanded', String(offen));
    topToggle?.setAttribute('aria-label', offen ? 'Menü schließen' : 'Menü öffnen');
    zuKreuz(topLinien.oben, topLinien.unten, offen);
  };

  topToggle?.addEventListener('click', () => setzeTop(!topOffen));
  document
    .querySelectorAll('[data-topmenu-link]')
    .forEach((a) => a.addEventListener('click', () => setzeTop(false)));

  // ---------- Untere Pille ----------
  const pillNav = document.querySelector<HTMLElement>('[data-pillnav]');
  const pill = document.querySelector<HTMLElement>('[data-pill]');
  const pillToggle = document.querySelector<HTMLButtonElement>('[data-pill-toggle]');
  const pillBackdrop = document.querySelector<HTMLElement>('[data-pill-backdrop]');
  const pillLinien = {
    oben: document.querySelector<HTMLElement>('[data-pillline="oben"]'),
    unten: document.querySelector<HTMLElement>('[data-pillline="unten"]'),
  };

  let pillOffen = false;
  const setzePille = (offen: boolean) => {
    pillOffen = offen;
    if (pill) {
      // im Ruhezustand kompakt, beim Öffnen etwas breiter
      pill.style.maxWidth = offen ? '460px' : '360px';
      pill.classList.toggle('ist-offen', offen);
    }
    pillToggle?.setAttribute('aria-expanded', String(offen));
    pillToggle?.setAttribute('aria-label', offen ? 'Menü schließen' : 'Menü öffnen');
    pillBackdrop?.classList.toggle('hidden', !offen);
    // Seite hinter dem Overlay nicht mitscrollen lassen
    document.body.style.overflow = offen ? 'hidden' : '';
    zuKreuz(pillLinien.oben, pillLinien.unten, offen);
  };

  pillToggle?.addEventListener('click', () => setzePille(!pillOffen));
  pillBackdrop?.addEventListener('click', () => setzePille(false));
  document
    .querySelectorAll('[data-pill-link]')
    .forEach((a) => a.addEventListener('click', () => setzePille(false)));
  setzePille(false);

  // Beide Menüs mit Escape schließen
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (pillOffen) setzePille(false);
    if (topOffen) setzeTop(false);
  });

  // Pille erscheint, sobald der obere Balken aus dem Blick gescrollt ist
  if (pillNav && topbar) {
    if ('IntersectionObserver' in window) {
      const beobachter = new IntersectionObserver(
        ([eintrag]) => {
          pillNav.classList.toggle('pill-versteckt', eintrag.isIntersecting);
          // Oben führt der Balken, unten die Pille — nie beide gleichzeitig
          if (!eintrag.isIntersecting) setzeTop(false);
          else if (pillOffen) setzePille(false);
        },
        { rootMargin: '-4px 0px 0px 0px' },
      );
      beobachter.observe(topbar);
    } else {
      pillNav.classList.remove('pill-versteckt');
    }
  }

  // Über dem Breakpoint sind beide Mobil-Menüs gegenstandslos
  window.addEventListener(
    'resize',
    () => {
      if (window.innerWidth < 1040) return;
      if (pillOffen) setzePille(false);
      if (topOffen) setzeTop(false);
    },
    { passive: true },
  );
</script>
