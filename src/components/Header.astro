---
// Header/Nav.
// Desktop (≥1200): weiße Sticky-Leiste, Logo links, Link-Pill + Kontakt rechts.
// Mobil (<1200): schwebende Glas-Pille UNTEN (scrollt mit) — Logo links,
//   Hamburger rechts; beim Scrollen etwas schmaler, beim Öffnen breiter,
//   die Links klappen nach OBEN auf, Seite dahinter wird geblurrt.
//   (Alternative „Pille oben mit Weiß-Animation" liegt als Kopie in
//   HeaderVarianteObenPill.astro.)
import Logo from './Logo.astro';
import Button from './Button.astro';

const links = [
  { label: 'Projekte', href: '/projekte' },
  { label: 'Leistungen', href: '/#leistungen' },
  { label: 'Prozess', href: '/#prozess' },
  { label: 'Ergebnis', href: '/#ergebnis' },
  { label: 'Über uns', href: '/#ueber-uns' },
];
---

<!-- Desktop-Header (Sticky) -->
<header class="sticky -top-px z-50 hidden bg-white xl:block">
  <div class="mx-auto flex max-w-[1280px] items-center justify-between px-10 py-2.5">
    <Logo />
    <nav class="flex items-center rounded-10 p-1.5 backdrop-blur-[5px]" aria-label="Hauptnavigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="flex h-[30px] items-center rounded-[11px] px-3 text-base font-medium tracking-[-0.02em] text-dark transition-colors duration-200 hover:text-blue"
          >
            <span class="relative">
              {link.label}
            </span>
          </a>
        ))
      }
      <Button href="/kontakt" variant="blue">Kontakt</Button>
    </nav>
  </div>
</header>

<!-- Mobile: statischer Balken oben (Logo + Menü), scrollt mit weg -->
<div class="relative bg-white xl:hidden" data-topbar>
  <div class="flex items-center justify-between px-5 py-3.5">
    <Logo />
    <button
      type="button"
      class="relative block size-11 shrink-0 rounded-full"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="top-menu"
      data-toptoggle
    >
      <span class="absolute top-[15.5px] left-3 h-0.5 w-5 rounded-full bg-dark transition-transform duration-200" data-topline-top></span>
      <span class="absolute top-[26.5px] left-3 h-0.5 w-5 rounded-full bg-dark transition-transform duration-200" data-topline-bottom></span>
    </button>
  </div>

  <!-- Dropdown nach unten -->
  <nav
    id="top-menu"
    data-topmenu
    class="absolute inset-x-0 top-full z-50 flex origin-top flex-col gap-1 border-b border-border bg-white px-5 pt-2 pb-6 shadow-card"
    aria-label="Mobilnavigation oben"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          class="flex items-center gap-2 border-b border-border py-3.5 text-2xl font-semibold tracking-[-0.02em] text-dark last:border-b-0"
          data-topmlink
        >
          {link.label}
        </a>
      ))
    }
    <Button href="/kontakt" variant="blue" class="mt-4 w-full">Kontakt</Button>
  </nav>
</div>

<!-- Mobile: schwebende Glas-Pille unten (erscheint beim Scrollen) -->
<div
  class="pill-versteckt fixed inset-x-0 bottom-0 z-50 px-4 pb-[max(0.85rem,env(safe-area-inset-bottom))] xl:hidden"
  data-mnav
>
  <div data-mpill class="mpill mx-auto flex w-full flex-col overflow-hidden rounded-[24px]">
    <!-- Links (klappen nach oben auf — stehen im DOM ÜBER der Zeile) -->
    <nav id="mobile-menu" data-mlinks class="mlinks" aria-label="Mobilnavigation">
      <div class="px-5 pt-5 pb-4">
        <p class="mb-1 flex items-center gap-2 text-sm font-medium text-gray" data-stagger style="--i:0">
          <span class="size-1.5 rounded-full bg-blue" aria-hidden="true"></span>
          Schön, dass Sie hier sind 👋
        </p>
        {
          links.map((link, i) => (
            <a
              href={link.href}
              class="flex items-center gap-2 border-b border-border py-3 text-3xl font-semibold tracking-[-0.02em] text-dark last:border-b-0"
              data-mlink
              data-stagger
              style={`--i:${i + 1}`}
            >
              {link.label}
            </a>
          ))
        }
        <div data-stagger style={`--i:${links.length + 1}`} class="mt-6">
          <Button href="/kontakt" variant="blue" class="w-full">Kontakt</Button>
        </div>
      </div>
    </nav>

    <!-- Untere Zeile: Logo links, Hamburger rechts (immer sichtbar) -->
    <div class="flex items-center justify-between gap-4 py-2.5 pr-2 pl-5">
      <Logo />
      <button
        type="button"
        class="relative block size-11 shrink-0 rounded-full"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mtoggle
      >
        <span class="absolute top-[15.5px] left-3 h-0.5 w-5 rounded-full bg-dark transition-transform duration-200" data-line-top></span>
        <span class="absolute top-[26.5px] left-3 h-0.5 w-5 rounded-full bg-dark transition-transform duration-200" data-line-bottom></span>
      </button>
    </div>
  </div>
</div>

<!-- geblurrter Hintergrund, wenn das Menü offen ist -->
<div data-mbackdrop class="fixed inset-0 z-40 hidden bg-dark/20 backdrop-blur-sm xl:hidden"></div>

<style>
  /* Bottom-Pille erscheint erst, wenn der obere Balken aus dem Blick ist */
  [data-mnav] {
    transition:
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-mnav].pill-versteckt {
    opacity: 0;
    transform: translateY(130%);
    pointer-events: none;
  }

  /* Top-Dropdown Auf-/Zuklappen */
  [data-topmenu] {
    transform: translateY(-8px);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  [data-topmenu].ist-offen {
    transform: none;
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-mnav],
    [data-topmenu] {
      transition: none;
    }
  }

  /* Schwebende Glas-Pille (dauerhaft transparent mit Blur) */
  .mpill {
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    transition: max-width 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mpill.is-open {
    background: rgba(255, 255, 255, 0.95);
  }

  /* Links auf-/zuklappen (nach oben, Höhe via max-height) */
  .mlinks {
    max-height: 0;
    overflow: hidden;
    transition: max-height 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mpill.is-open .mlinks {
    max-height: 78vh;
    overflow-y: auto;
  }

  /* Gestaffeltes Hochsliden der Einträge (subtiler „premium" Touch) */
  .mlinks [data-stagger] {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.3s ease,
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mpill.is-open .mlinks [data-stagger] {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 45ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .mpill,
    .mlinks,
    .mlinks [data-stagger] {
      transition: none;
    }
  }
</style>

<script>
  const pill = document.querySelector<HTMLElement>('[data-mpill]');
  const toggle = document.querySelector<HTMLElement>('[data-mtoggle]');
  const backdrop = document.querySelector<HTMLElement>('[data-mbackdrop]');
  const lineTop = document.querySelector<HTMLElement>('[data-line-top]');
  const lineBottom = document.querySelector<HTMLElement>('[data-line-bottom]');
  const menuLinks = document.querySelectorAll('[data-mlink]');

  if (pill && toggle && backdrop && lineTop && lineBottom) {
    let offen = false;

    const anwenden = () => {
      // dauerhaft kompakt; nur beim Öffnen etwas breiter
      pill.style.maxWidth = offen ? '460px' : '360px';
      pill.classList.toggle('is-open', offen);
      lineTop.style.transform = offen ? 'translateY(5.5px) rotate(45deg)' : '';
      lineBottom.style.transform = offen ? 'translateY(-5.5px) rotate(-45deg)' : '';
    };

    const setzeOffen = (v: boolean) => {
      offen = v;
      toggle.setAttribute('aria-expanded', String(v));
      toggle.setAttribute('aria-label', v ? 'Menü schließen' : 'Menü öffnen');
      backdrop.classList.toggle('hidden', !v);
      document.documentElement.classList.toggle('overflow-hidden', v);
      anwenden();
    };

    toggle.addEventListener('click', () => setzeOffen(!offen));
    backdrop.addEventListener('click', () => setzeOffen(false));
    menuLinks.forEach((a) => a.addEventListener('click', () => setzeOffen(false)));
    anwenden();
  }

  // Oberer Balken: eigenes Dropdown; blendet die Bottom-Pille aus, solange
  // er sichtbar ist. Verlässt er den Viewport, taucht die Pille auf.
  const mnav = document.querySelector<HTMLElement>('[data-mnav]');
  const topbar = document.querySelector<HTMLElement>('[data-topbar]');
  const topToggle = document.querySelector<HTMLElement>('[data-toptoggle]');
  const topMenu = document.querySelector<HTMLElement>('[data-topmenu]');
  const topLineTop = document.querySelector<HTMLElement>('[data-topline-top]');
  const topLineBottom = document.querySelector<HTMLElement>('[data-topline-bottom]');
  const topLinks = document.querySelectorAll('[data-topmlink]');

  if (topbar && topToggle && topMenu && topLineTop && topLineBottom) {
    let topOffen = false;
    const setzeTop = (v: boolean) => {
      topOffen = v;
      topMenu.classList.toggle('ist-offen', v);
      topToggle.setAttribute('aria-expanded', String(v));
      topToggle.setAttribute('aria-label', v ? 'Menü schließen' : 'Menü öffnen');
      topLineTop.style.transform = v ? 'translateY(5.5px) rotate(45deg)' : '';
      topLineBottom.style.transform = v ? 'translateY(-5.5px) rotate(-45deg)' : '';
    };
    topToggle.addEventListener('click', () => setzeTop(!topOffen));
    topLinks.forEach((a) => a.addEventListener('click', () => setzeTop(false)));

    // Bottom-Pille zeigen, sobald der obere Balken aus dem Blick scrollt
    if (mnav && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        ([entry]) => {
          mnav.classList.toggle('pill-versteckt', entry.isIntersecting);
          if (entry.isIntersecting) return; // oben: Top-Dropdown behält Regie
          setzeTop(false); // nach unten gescrollt: Top-Dropdown schließen
        },
        { rootMargin: '-4px 0px 0px 0px' },
      );
      io.observe(topbar);
    } else if (mnav) {
      mnav.classList.remove('pill-versteckt');
    }
  }
</script>
