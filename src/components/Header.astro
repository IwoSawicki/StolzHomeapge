---
// Header/Nav.
// Desktop (≥1200): weiße Sticky-Leiste, Logo links, Link-Pill + Kontakt rechts.
// Mobil (<1200): schwebende Pille (madebyshape-Stil) — am Seitenanfang breit
//   & weiß mit Logo/Hamburger an den Rändern; beim Scrollen zieht sie sich
//   zusammen und wird transparent mit Blur; beim Öffnen klappt sie mit den
//   Links auf, dahinter wird die Seite geblurrt.
import Logo from './Logo.astro';
import Button from './Button.astro';
import { projekte } from '../data/projekte';

const links = [
  { label: 'Projekte', href: '/projekte', badge: projekte.length },
  { label: 'Leistungen', href: '/#leistungen' },
  { label: 'Prozess', href: '/#prozess' },
  { label: 'Ergebnis', href: '/#ergebnis' },
  { label: 'Über uns', href: '/#ueber-uns' },
];
---

<!-- Desktop-Header (Sticky) -->
<header class="sticky -top-px z-50 hidden bg-white xl:block">
  <div class="mx-auto flex max-w-[1280px] items-center justify-between px-10 py-2.5">
    <Logo />
    <nav class="flex items-center rounded-10 p-1.5 backdrop-blur-[5px]" aria-label="Hauptnavigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="flex h-[30px] items-center rounded-[11px] px-3 text-base font-medium tracking-[-0.02em] text-dark transition-colors duration-200 hover:text-blue"
          >
            <span class="relative">
              {link.label}
              {link.badge && (
                <span class="absolute -top-2 -right-4 rounded-full bg-blue px-1 py-px text-[10px] leading-none font-bold text-white tabular-nums">
                  {link.badge}
                </span>
              )}
            </span>
          </a>
        ))
      }
      <Button href="/kontakt" variant="blue">Kontakt</Button>
    </nav>
  </div>
</header>

<!-- Mobile-Header (schwebende Pille) -->
<div class="fixed inset-x-0 top-0 z-50 px-3 pt-3 xl:hidden" data-mnav>
  <div data-mpill class="mpill mx-auto flex w-full flex-col overflow-hidden rounded-[22px]">
    <div class="flex items-center justify-between gap-4 px-4 py-2">
      <a href="/" aria-label="STOLZ Marketing – Startseite" data-mlink>
        <Logo />
      </a>
      <button
        type="button"
        class="relative -mr-1 block size-11 shrink-0 rounded-full"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mtoggle
      >
        <span class="absolute top-[15.5px] left-3 h-0.5 w-5 rounded-full bg-dark transition-transform duration-200" data-line-top></span>
        <span class="absolute top-[26.5px] left-3 h-0.5 w-5 rounded-full bg-dark transition-transform duration-200" data-line-bottom></span>
      </button>
    </div>

    <!-- Links (klappen auf) -->
    <nav id="mobile-menu" data-mlinks class="mlinks" aria-label="Mobilnavigation">
      <div class="px-4 pb-4">
        <p class="flex items-center gap-2 px-1 pb-1 text-sm font-medium text-gray">
          <span class="size-1.5 rounded-full bg-blue" aria-hidden="true"></span>
          Schön, dass Sie hier sind
        </p>
        {
          links.map((link) => (
            <a
              href={link.href}
              class="flex items-center gap-2 border-b border-border py-3 text-3xl font-semibold tracking-[-0.02em] text-dark"
              data-mlink
            >
              {link.label}
              {link.badge && (
                <span class="rounded-full bg-blue px-1.5 py-0.5 text-xs leading-none font-bold text-white tabular-nums">
                  {link.badge}
                </span>
              )}
            </a>
          ))
        }
        <Button href="/kontakt" variant="blue" class="mt-5 w-full" >Kontakt</Button>
      </div>
    </nav>
  </div>
</div>

<!-- geblurrter Hintergrund, wenn das Menü offen ist -->
<div data-mbackdrop class="fixed inset-0 z-40 hidden bg-dark/20 backdrop-blur-sm xl:hidden"></div>

<!-- Platzhalter, damit der Inhalt nicht unter der schwebenden Pille beginnt -->
<div class="h-[64px] xl:hidden" aria-hidden="true"></div>

<style>
  /* Schwebende Pille: Übergänge für Breite, Hintergrund, Schatten */
  .mpill {
    background: var(--color-white);
    border: 1px solid transparent;
    transition:
      max-width 300ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 250ms ease,
      box-shadow 250ms ease,
      border-color 250ms ease;
  }
  /* Glas-Look beim Scrollen/Öffnen */
  .mpill.is-glass {
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-border);
  }
  .mpill.is-open {
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-border);
  }

  /* Links auf-/zuklappen (Höhe animiert via max-height) */
  .mlinks {
    max-height: 0;
    overflow: hidden;
    transition: max-height 340ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mpill.is-open .mlinks {
    max-height: 70vh;
    overflow-y: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .mpill,
    .mlinks {
      transition: none;
    }
  }
</style>

<script>
  const pill = document.querySelector<HTMLElement>('[data-mpill]');
  const toggle = document.querySelector<HTMLElement>('[data-mtoggle]');
  const backdrop = document.querySelector<HTMLElement>('[data-mbackdrop]');
  const lineTop = document.querySelector<HTMLElement>('[data-line-top]');
  const lineBottom = document.querySelector<HTMLElement>('[data-line-bottom]');
  const menuLinks = document.querySelectorAll('[data-mlink]');

  if (pill && toggle && backdrop && lineTop && lineBottom) {
    let offen = false;

    const anwenden = () => {
      const gescrollt = window.scrollY > 8;
      // Breite: offen am breitesten, gescrollt schmal, oben volle Breite
      pill.style.maxWidth = offen ? '440px' : gescrollt ? '340px' : '100%';
      pill.classList.toggle('is-glass', gescrollt && !offen);
      pill.classList.toggle('is-open', offen);
      // Hamburger → X
      lineTop.style.transform = offen ? 'translateY(5.5px) rotate(45deg)' : '';
      lineBottom.style.transform = offen ? 'translateY(-5.5px) rotate(-45deg)' : '';
    };

    const setzeOffen = (v: boolean) => {
      offen = v;
      toggle.setAttribute('aria-expanded', String(v));
      toggle.setAttribute('aria-label', v ? 'Menü schließen' : 'Menü öffnen');
      backdrop.classList.toggle('hidden', !v);
      document.documentElement.classList.toggle('overflow-hidden', v);
      anwenden();
    };

    toggle.addEventListener('click', () => setzeOffen(!offen));
    backdrop.addEventListener('click', () => setzeOffen(false));
    menuLinks.forEach((a) => a.addEventListener('click', () => setzeOffen(false)));
    window.addEventListener('scroll', anwenden, { passive: true });
    anwenden();
  }
</script>
