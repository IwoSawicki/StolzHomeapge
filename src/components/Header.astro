---
// Header/Nav. Maße aus original/index.html:
// Desktop (≥1200): weiße Leiste, Padding 10/40, Inhalt max 1200px zentriert,
//   Links-Pill (Padding 6, Radius 10, backdrop-blur 5px), Links 15px/500,
//   Kontakt-Button blau. Sticky, top -1px, z-10.
// Phone/Tablet (<1200): Höhe 64, Padding links 20 / rechts 12,
//   Hamburger 44×44 dunkel (Radius 10) mit zwei weißen Linien 20×2.
// Das geöffnete Mobilmenü ist im Framer-Export nicht enthalten (per JS
// nachgeladen) → dokumentierte Näherung: weißes Overlay mit Linkliste.
import Logo from './Logo.astro';
import Button from './Button.astro';

const links = [
  { label: 'Projekte', href: '/projekte' },
  { label: 'Leistungen', href: '/#leistungen' },
  { label: 'Prozess', href: '/#prozess' },
  { label: 'Ergebnis', href: '/#ergebnis' },
  { label: 'Über uns', href: '/#ueber-uns' },
];
---

<header class="sticky -top-px z-10 bg-white">
  <div class="mx-auto flex h-16 items-center justify-between pr-3 pl-5 xl:h-auto xl:max-w-[1280px] xl:px-10 xl:py-2.5">
    <Logo />

    <!-- Desktop-Navigation -->
    <nav class="hidden items-center rounded-10 p-1.5 backdrop-blur-[5px] xl:flex" aria-label="Hauptnavigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="flex h-[30px] items-center rounded-[11px] px-3 text-base font-medium tracking-[-0.02em] text-dark transition-colors duration-200 hover:text-blue"
          >
            {link.label}
          </a>
        ))
      }
      <Button href="/kontakt" variant="blue">Kontakt</Button>
    </nav>

    <!-- Hamburger (Phone/Tablet) -->
    <button
      type="button"
      class="relative block size-11 rounded-10 bg-dark shadow-stack xl:hidden"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="absolute top-[15.5px] left-3 h-0.5 w-5 rounded-full bg-white transition-transform duration-200" data-line-top
      ></span>
      <span class="absolute top-[26.5px] left-3 h-0.5 w-5 rounded-full bg-white transition-transform duration-200" data-line-bottom
      ></span>
    </button>
  </div>

  <!-- Mobil-Menü (Overlay) -->
  <div id="mobile-menu" class="fixed inset-x-0 top-16 bottom-0 z-10 hidden flex-col gap-2 bg-white px-5 pt-6 pb-10 xl:hidden">
    {
      links.map((link) => (
        <a
          href={link.href}
          class="border-b border-border py-4 text-2xl font-medium tracking-[-0.02em] text-dark"
          data-menu-link
        >
          {link.label}
        </a>
      ))
    }
    <Button href="/kontakt" variant="blue" class="mt-6">Kontakt</Button>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]')!;
  const menu = document.getElementById('mobile-menu')!;
  const lineTop = document.querySelector<HTMLElement>('[data-line-top]')!;
  const lineBottom = document.querySelector<HTMLElement>('[data-line-bottom]')!;

  function setOpen(open: boolean) {
    menu.classList.toggle('hidden', !open);
    menu.classList.toggle('flex', open);
    document.documentElement.classList.toggle('overflow-hidden', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    lineTop.style.transform = open ? 'translateY(5.5px) rotate(45deg)' : '';
    lineBottom.style.transform = open ? 'translateY(-5.5px) rotate(-45deg)' : '';
  }

  toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
  menu.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
