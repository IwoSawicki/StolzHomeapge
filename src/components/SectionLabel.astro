---
// Label-Pill über Sektions-Headlines (z. B. „Einblicke", „Probleme").
// Original: Radius 100, bg #0084FF/8 %, Padding 4/9/4/7, Gap 7,
// Icon-Kreis 14×14 blau mit 7×7-Icon, Text Inter 600 13px (→12px, dok.).
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<div class="inline-flex items-center gap-[7px] rounded-full bg-blue-bright/8 py-1 pr-[9px] pl-[7px]">
  <span class="flex size-3.5 items-center justify-center rounded-full bg-blue text-white">
    <slot>
      <!-- Standard-Icon: Plus (Original: zwei weiße Balken im blauen Kreis) -->
      <svg class="size-[7px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" aria-hidden="true">
        <path d="M12 4v16M4 12h16"></path>
      </svg>
    </slot>
  </span>
  <p class="text-xs font-semibold tracking-[-0.01em] text-dark">{text}</p>
</div>
