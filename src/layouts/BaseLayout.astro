---
/* Basis-Layout: <head>, Meta, Schriften, JSON-LD.
   Wird von jeder Seite verwendet. */
import '../styles/global.css';
import ogBild from '../assets/og-image.jpg';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description: string;
  /** Ohne Angabe wird der Pfad der aktuellen Seite verwendet */
  canonical?: string;
  /** Seiten, die nicht in den Index sollen (z. B. Danke-Seiten) */
  noindex?: boolean;
}

const { title, description, canonical, noindex = false } = Astro.props;

const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site);
/* Vorschaubild beim Teilen. Astro liefert einen Pfad, Open Graph braucht
   eine absolute URL. */
const ogBildUrl = new URL(ogBild.src, Astro.site);

/* Eckdaten aus CLAUDE.md (Impressum). Die Vorlage nennt im Kontaktbereich
   „Gewerbegebiet Bensheim" — das ist der Arbeitsort, nicht die im Impressum
   eingetragene Anschrift. Für strukturierte Daten zählt die Anschrift. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://stolz-marketing.de/#organisation',
  name: 'Stolz Marketing',
  description:
    'Marketing für Handwerksbetriebe und Dienstleister an der Bergstraße und in Südhessen.',
  url: 'https://stolz-marketing.de',
  telephone: '+49 178 4444156',
  email: 'iwo@stolz-marketing.de',
  founder: { '@type': 'Person', name: 'Iwo Sawicki' },
  vatID: 'DE350093785',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Heidelbergerstraße 15D',
    postalCode: '64385',
    addressLocality: 'Reichelsheim',
    addressRegion: 'Hessen',
    addressCountry: 'DE',
  },
  areaServed: [
    { '@type': 'Place', name: 'Bergstraße' },
    { '@type': 'Place', name: 'Südhessen' },
  ],
  sameAs: ['https://www.instagram.com/stolz.marketing/'],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stolz Marketing" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogBildUrl} />
    <meta property="og:image:width" content={String(ogBild.width)} />
    <meta property="og:image:height" content={String(ogBild.height)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Stolz Marketing" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogBildUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#0D2118" />

    {/* Kritische Schnitte vorladen — beide Dateien sind Variable Fonts */}
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/playfair-display-italic-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* SVG zuerst, die Rasterbilder sind die Rückfallebene für Programme
        ohne SVG-Unterstützung. Alle drei zeigen dasselbe: gelbe Kachel,
        dunkelgrünes Icon, unabhängig vom Farbschema. favicon.ico enthält
        16, 32, 48 und 64 Pixel. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* Umami: cookielos, deshalb ohne Einwilligung. data-domains sorgt dafür,
        dass nur auf der Produktionsdomain gezählt wird, nicht auf der
        Vorschau unter redesign.stolz-marketing.de. */}
    <script
      defer
      src="https://analytics.stolz-marketing.de/script.js"
      data-website-id="46f1a591-c35f-43ce-b9ad-f0e08a8a2504"
      data-domains="stolz-marketing.de,www.stolz-marketing.de"></script>
  </head>
  <body>
    <slot />
    {/* Google Analytics lädt erst nach Zustimmung im Banner */}
    <CookieBanner />
  </body>
</html>
