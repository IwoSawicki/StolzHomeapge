---
// Basis-Layout: <head>, Meta, Fonts, Slot.
// Wird beim Nachbau der Design-Vorlage ausgebaut.
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'STOLZ Marketing', description = '' } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <slot />
  </body>
</html>
